<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LaunchDesk.Desktop">
 <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="FontSize" Value="11"/></Style>
 <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{Binding DataContext.Layout.FormPadding,RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
 <Style x:Key="ProfileRow" TargetType="ListBoxItem" BasedOn="{StaticResource ProfileItem}"><Setter Property="Height" Value="98"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="16"/></Style>
 <DataTemplate x:Key="DashboardPage">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Height="{Binding Layout.SummaryHeight}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ItemsControl ItemsSource="{Binding SummaryResources}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="29"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#E9F6F0" CornerRadius="9" VerticalAlignment="Top" HorizontalAlignment="Left"><local:AppIcon Kind="Server" Foreground="#238266" Width="19" Height="19"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="独立许可连接" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="2" CornerRadius="5" Padding="6,5" VerticalAlignment="Top" Margin="4,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F6F3E9"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="连通性就绪"><Setter Property="Background" Value="#E9F6F0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="10" HorizontalAlignment="Center"/></Border></Grid><TextBlock Grid.Row="1" Text="{Binding Address}" FontWeight="SemiBold" FontSize="17" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{Binding Evidence}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Evidence}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Grid.Column="2" Background="#EDF6FF" BorderBrush="#CDE3F9" BorderThickness="1" CornerRadius="12" Padding="20,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#DCEEFF" CornerRadius="9" VerticalAlignment="Top"><local:AppIcon Kind="Package" Foreground="#0F6CBD" Width="19" Height="19"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding ToolCountLabel}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding ToolNames}" Foreground="#0F6CBD" Margin="0,10,0,7" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="独立配置 · 按登录关联" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><Button Grid.Column="2" Content="管理工具 →" Style="{StaticResource UpdateLink}" Command="{Binding GoToolsCommand}" VerticalAlignment="Bottom" FontSize="11"/></Grid></Border>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="{Binding Layout.DetailWidth}"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="{Binding Layout.AssociatedHeight}"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="常用登录" FontSize="19" FontWeight="SemiBold"/><ComboBox Width="150" Height="30" MinHeight="30" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Top" ItemsSource="{Binding Profiles.Versions}" SelectedItem="{Binding Profiles.Version}"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox Text="{Binding Profiles.Search,UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" ToolTip="搜索项目、版本、MDB 或名称"/><local:AppIcon Kind="Search" Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" Foreground="#95A2B7" IsHitTestVisible="False"/><TextBlock Text="搜索项目、版本、MDB 或配置名称" Foreground="#95A2B7" FontSize="11" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Profiles.Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <ListBox Grid.Row="2" ItemsSource="{Binding Profiles.Profiles}" SelectedItem="{Binding Profiles.Selected}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ProfileRow}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="{Binding MarkBackground}" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="{Binding Mark}" Foreground="{Binding MarkColor}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding License}" Foreground="#8D9AB0" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><local:AppIcon Grid.Column="2" Kind="ChevronRight" Foreground="#9BA7BC" Width="16" Height="16" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="16,12" Visibility="{Binding Layout.Wide,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关联工具" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Profiles.Selected.Tools}" Foreground="#0F6CBD" FontSize="12" Margin="0,10,0,6"/><TextBlock Text="工具变量随此登录注入，不影响其他应用。" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="查看工具 →" Style="{StaticResource UpdateLink}" Command="{Binding GoToolsCommand}" VerticalAlignment="Top"/></Grid></Border>
    </Grid>
    <Border Grid.Column="2" Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="当前选中" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Profiles.Selected.Name,TargetNullValue=请选择登录配置}" FontSize="{Binding Layout.DetailTitleSize}" FontWeight="SemiBold" Margin="0,14,0,10"/><TextBlock Text="{Binding Profiles.Selected.Application}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="{Binding Layout.MetaRowHeight}"/><RowDefinition Height="{Binding Layout.MetaRowHeight}"/><RowDefinition Height="{Binding Layout.MetaRowHeight}"/><RowDefinition Height="{Binding Layout.MetaRowHeight}"/></Grid.RowDefinitions><TextBlock Text="项目" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="{Binding Profiles.Selected.Profile.DisplayFields.Project}"/><TextBlock Grid.Row="1" Text="用户" Style="{StaticResource MutedText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Profiles.Selected.Profile.DisplayFields.User}"/><TextBlock Grid.Row="2" Text="MDB" Style="{StaticResource MutedText}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Profiles.Selected.Profile.DisplayFields.Mdb}"/><TextBlock Grid.Row="3" Text="关联许可" Style="{StaticResource MutedText}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Profiles.Selected.License}" TextTrimming="CharacterEllipsis"/></Grid>
     <StackPanel Grid.Row="2"><Border Background="#EEF0FF" CornerRadius="8" Padding="11,12" Margin="0,8,0,16"><TextBlock Text="{Binding DashboardCheck}" Foreground="{StaticResource Accent}" FontSize="11"/></Border><TextBlock Text="实际取证结果以进入应用为准。" Style="{StaticResource MutedText}" Margin="0,0,0,20" Visibility="{Binding Layout.Wide,Converter={StaticResource BoolVisibility}}"/><Button x:Name="DashboardLaunchButton" Content="启动选中配置" local:IconAssist.Kind="Play" Style="{StaticResource Primary}" Height="44" Command="{Binding Profiles.LaunchCommand}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="编辑配置" local:IconAssist.Kind="Folder" Command="{Binding Profiles.EditCommand}" Padding="8,8"/><Button Grid.Column="2" Content="复制配置" local:IconAssist.Kind="Copy" Command="{Binding Profiles.CopyCommand}" Padding="8,8"/></Grid></StackPanel>
    </Grid></Border>
   </Grid>
  </Grid>
 </DataTemplate>
 <DataTemplate x:Key="ProfilesPage">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="{Binding Layout.EditorWidth}"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="编辑登录信息" Style="{StaticResource Heading}"/>
    <ScrollViewer x:Name="ProfileBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel DataContext="{Binding ProfileEditor}" Margin="0,0,5,0">
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="版本分组" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Group,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
<TextBlock Text="应用入口" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Applications}" SelectedItem="{Binding Application}" DisplayMemberPath="Name" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,10"><TextBlock Text="项目" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="MDB" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Mdb,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="用户" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding User,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="新密码（留空则保留）" Style="{StaticResource FieldLabel}"/><local:PasswordEditor Behavior="{Binding Password}" ToolTip="仅显示本次输入，已有密码不会回显"/></StackPanel>
<StackPanel Grid.Row="2"><TextBlock Text="模块" Style="{StaticResource FieldLabel}"/><ComboBox IsEditable="True" ItemsSource="{Binding Modules}" Text="{Binding Module,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="许可连接" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Licenses}" SelectedItem="{Binding License}" DisplayMemberPath="Name"/></StackPanel></Grid>
<Expander Header="关联工具" Margin="0,10,0,0" FontSize="11"><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander><CheckBox Content="清除已保存的密码关联" IsChecked="{Binding ClearPassword}" Margin="0,10,0,0" FontSize="11"/>
</StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="保存配置" local:IconAssist.Kind="Save" Command="{Binding ProfileEditor.SaveCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Width="150"/><Button Grid.Column="1" Content="核验保存" Style="{StaticResource Link}" Command="{Binding ProfileEditor.VerifyCommand}"/></Grid>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelCard}" Background="#F0F3FF" BorderBrush="#D9DFF8"><StackPanel><StackPanel Orientation="Horizontal"><local:AppIcon Kind="Terminal" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="启动预览" FontWeight="SemiBold" FontSize="16"/></StackPanel><TextBlock Text="{Binding ProfileEditor.Preview}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/><TextBlock Text="保存后密码不会回填，分享时也不会导出。" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,16,0,0"/></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="已保存的登录" FontWeight="SemiBold" FontSize="15"/><ListBox Grid.Row="1" ItemsSource="{Binding Profiles.Profiles}" SelectedItem="{Binding Profiles.Selected}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ProfileItem}"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="编辑" Command="{Binding Profiles.EditCommand}" Style="{StaticResource Link}"/><Button Content="复制" Command="{Binding Profiles.CopyCommand}" Style="{StaticResource Link}" Margin="12,0"/><Button Content="删除" Command="{Binding Profiles.DeleteCommand}" Style="{StaticResource Danger}"/></StackPanel></Grid></Border>
   </Grid>
  </Grid>
 </DataTemplate>
 <DataTemplate x:Key="ToolsPage">
  <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="我的工具" FontSize="19" FontWeight="SemiBold"/><Border Background="#E8F3FE" CornerRadius="5" Margin="12,0,0,0" Padding="9,4" VerticalAlignment="Top"><TextBlock Text="按项目关联" Foreground="#0F6CBD" FontSize="10"/></Border></StackPanel><TextBox Grid.Column="1" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" ToolTip="搜索工具名称、分组或目录"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="320" Height="250" Style="{StaticResource Card}" Padding="20" Margin="0,0,20,20"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#E8F3FE" HorizontalAlignment="Left"><local:AppIcon Kind="Package" Foreground="#0F6CBD" Width="20" Height="20"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Group}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Grid><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="目标目录" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding TargetDirectory}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding Source.Kind,Converter={StaticResource EnumLabel}}" Foreground="#0F6CBD" FontSize="11" VerticalAlignment="Center"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="部署 / 更新" Style="{StaticResource UpdatePrimary}" Command="{Binding DataContext.OpenDeploymentCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,8" local:IconAssist.Kind="Download"/><Button Grid.Column="2" Content="配置工具" Command="{Binding DataContext.ConfigureCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,8" local:IconAssist.Kind="Settings"/></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <Border Grid.Row="2" Background="#EDF6FF" BorderBrush="#D2E7FA" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><local:AppIcon Kind="Info" Foreground="#0F6CBD" Margin="0,0,10,0"/><TextBlock Text="可添加自研 PML、普通文件包或压缩包。每个工具独立管理来源、目录与环境变量。" Foreground="#0F6CBD" FontSize="11" VerticalAlignment="Center"/></StackPanel></Border>
  </Grid>
 </DataTemplate>
<DataTemplate x:Key="ToolSettingsPage"> <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{Binding DataContext.Layout.Gap,RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding DataContext.Layout.EditorWidth,RelativeSource={RelativeSource AncestorType=Window}}"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="{Binding DataContext.Layout.ToolInfoHeight,RelativeSource={RelativeSource AncestorType=Window}}"/><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="工具信息" Style="{StaticResource Heading}"/><StackPanel Grid.Row="1" VerticalAlignment="Center">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="工具名称" Style="{StaticResource Label}" FontSize="11"/><TextBox Text="{Binding Draft.Name,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="分组 / 作者" Style="{StaticResource Label}" FontSize="11"/><TextBox Text="{Binding Draft.Group,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
    <StackPanel Margin="{Binding DataContext.Layout.FormGroupMargin,RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="部署目录" Style="{StaticResource Label}" FontSize="11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Draft.Target,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="选择目录" local:IconAssist.Kind="Folder" Command="{Binding BrowseTargetCommand}" Margin="12,0,0,0"/></Grid></StackPanel>
    <StackPanel Margin="{Binding DataContext.Layout.FormGroupMargin,RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="默认导入来源" Style="{StaticResource Label}" FontSize="11"/><Button Command="{Binding OpenSelectedDeploymentCommand}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Draft.SourceLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Button></StackPanel>
   </StackPanel><TextBlock Grid.Row="2" Text="支持压缩包、完整文件夹、单个或多个普通文件。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></Grid></Border>
   <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><TextBlock Text="环境变量" FontSize="18" FontWeight="SemiBold"/><Button Content="添加变量" local:IconAssist.Kind="Plus" Command="{Binding AddVariableCommand}" Style="{StaticResource UpdateLink}" HorizontalAlignment="Right" Padding="0" MinHeight="24"/></Grid><Border Grid.Row="1" Background="#F5F7FB" CornerRadius="6" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="变量名 / 值" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="作用范围" FontSize="11" Foreground="{StaticResource Muted}"/></Grid></Border>
    <ListBox Grid.Row="2" ItemsSource="{Binding Draft.Variables}" SelectedItem="{Binding SelectedVariable}" BorderThickness="0" Padding="0,8,0,0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ProfileItem}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Value}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Scope,Converter={StaticResource EnumLabel}}" Foreground="#0F6CBD" FontSize="11"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="3" Margin="0,8,0,0"><WrapPanel><Button Content="编辑 / 重命名" local:IconAssist.Kind="Settings" Command="{Binding EditVariableCommand}" Margin="0,0,12,0"/><Button Content="移除变量" Style="{StaticResource Danger}" Command="{Binding RemoveVariableCommand}"/></WrapPanel><TextBlock Text="变量值支持 {Target} 引用部署目录，也可使用 %变量名%。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" Visibility="{Binding DataContext.Layout.Wide,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}"/></StackPanel>
   </Grid></Border>
  </Grid>
  <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="作用范围" Style="{StaticResource Heading}"/><TextBlock Text="仅启动进程" Foreground="#4E5DDB" FontWeight="SemiBold"/><TextBlock Text="只对关联登录启动的应用生效，适合多套工具并存。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,22"/><Separator Background="#E3E8F0" Margin="0,0,0,22"/><TextBlock Text="当前用户 / 系统" FontWeight="SemiBold"/><TextBlock Text="在变量编辑窗预览并确认后写入 Windows。系统范围按需申请管理员权限。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,22"/><Separator Background="#E3E8F0" Margin="0,0,0,22"/><TextBlock Text="已关联登录配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Associations}" Foreground="#0F6CBD" FontSize="12" Margin="0,12,0,24"/><Border Background="#EBF3FC" CornerRadius="8" Padding="14"><TextBlock Text="变量重命名会保留登录关联；外部 PML / EVAR 中的旧名称需要同步修改。" Foreground="#0F6CBD" FontSize="11"/></Border></StackPanel></ScrollViewer>
   <StackPanel Grid.Row="1" Margin="0,16,0,0"><Button x:Name="SaveToolButton" Content="保存工具" local:IconAssist.Kind="Save" Style="{StaticResource UpdatePrimary}" Command="{Binding SaveCommand}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="部署更新" local:IconAssist.Kind="Import" Command="{Binding OpenSelectedDeploymentCommand}" Padding="6,8"/><Button Grid.Column="2" Content="导出配置" local:IconAssist.Kind="Export" Command="{Binding ExportCommand}" Padding="6,8"/></Grid><Button Content="移除此工具" local:IconAssist.Kind="Trash" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
