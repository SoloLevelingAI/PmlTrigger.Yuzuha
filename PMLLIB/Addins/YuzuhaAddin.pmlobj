--
--
-- Description:
-- Addin entry for Yuzuha. Registers the RPC and target command handlers and
-- refreshes the current AVEVA module during startup.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  YuzuhaAddin()                                                         -               Constructor. Registers YuzuhaRpcCommand and YuzuhaTargetCommand.
--  modulestartup()                                                       -               Refreshes the RPC host with the current module.
--  startup()                                                             -               Refreshes the RPC host with the current module.
--

define object YuzuhaAddin

endobject

define method .YuzuhaAddin()
  pml load command !!YuzuhaRpcCommand
  !!YuzuhaRpcCommand.register()
  pml load command !!YuzuhaTargetCommand
  !!YuzuhaTargetCommand.register()
endmethod

define method .modulestartup()
  !!YuzuhaRpcCommand.RefreshModel()
endmethod

define method .startup()
  !!YuzuhaRpcCommand.RefreshModel()
endmethod
