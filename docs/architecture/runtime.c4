// Runtime relations are reviewed descriptions, separate from generated build dependencies.
model {
  client = actor "AI / 本机命令调用者"
  developer = actor "开发者 / 浏览器"
  terminal = actor "终端用户"
  sqlite = store "本地 SQLite / FTS5"
  aveva = system "AVEVA E3D / PDMS / AM"
  client -> yuzuha.operations-cli "op list / describe / invoke / batch · JSON或stdin"
  terminal -> yuzuha.operations-cli "独立原生 CLI"
  yuzuha.operations-cli -> yuzuha.operations "共享操作契约 / 权限 / 调度"
  yuzuha.operations -> yuzuha.mcp-core "直接调用注册的本地服务适配器"
  yuzuha.mcp-core -> yuzuha.rpc "显式 PID / 身份核验 / PML 请求"
  yuzuha.mcp-core -> yuzuha.knowledge-core "直接调用本地知识服务"
  yuzuha.rpc -> yuzuha.host35 "PID 绑定 Named Pipe · AM / PDMS"
  yuzuha.rpc -> yuzuha.host48 "PID 绑定 Named Pipe · E3D"
  yuzuha.host35 -> aveva "AVEVA 主线程执行 PML"
  yuzuha.host48 -> aveva "AVEVA 主线程执行 PML"
  yuzuha.knowledge-core -> sqlite "用户选择的本地知识库"
  developer -> yuzuha.devhost "OpenAPI / Scalar · 纯预览"
  developer -> yuzuha.desktop "原生启动 / 复制 / 工具状态"
  yuzuha.devhost -> yuzuha.mcp-core "纯计算预览"
  yuzuha.devhost -> yuzuha.knowledge-core "查询规划预览"
  yuzuha.desktop -> yuzuha.workspace "参数构造 / 目录检查 / 文件复制"
  yuzuha.desktop -> yuzuha.mcp-core "直接调用会话与PML服务"
  yuzuha.desktop -> yuzuha.knowledge-core "直接调用知识服务"
  yuzuha.mcp-core -> yuzuha.workspace "配置服务 / 调用日志 / 状态"
  yuzuha.knowledge-core -> yuzuha.workspace "用户目录与配置"
  yuzuha.desktop -> aveva "用户点击后创建启动入口"
}
views {
  view runtime {
    title "运行时 · 原生CLI、Named Pipe与AVEVA"
    include client, terminal, yuzuha.operations-cli, yuzuha.operations, yuzuha.mcp-core, yuzuha.rpc, yuzuha.knowledge-core, yuzuha.host35, yuzuha.host48, sqlite, aveva
    exclude * -> * where kind is build
    autoLayout LeftRight
  }
  view development {
    title "开发文档 · 可选 HTTP 宿主"
    include developer, yuzuha.devhost, yuzuha.mcp-core, yuzuha.knowledge-core
    autoLayout LeftRight
  }
  view workspace {
    title "原生工作台 · 开发目录与工具活动"
    include developer, yuzuha.desktop, yuzuha.workspace, yuzuha.mcp-core, yuzuha.knowledge-core, aveva
    exclude * -> * where kind is build
    autoLayout LeftRight
  }
}
