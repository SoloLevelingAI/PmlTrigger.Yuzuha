<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Core30.Ui">
  <!-- Extracted from the designated Core30.Ui component library and restyled using the HTML tokens. -->
  <Style x:Key="UiOutlineFrame" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="UseLayoutRounding" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
  </Style>
  <Style x:Key="UiFocusVisual" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Stroke="{DynamicResource color.primary}" StrokeThickness="2" RadiusX="9" RadiusY="9" Margin="-2" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiCheckBox" TargetType="CheckBox" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="MinHeight" Value="{DynamicResource size.control-small}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource color.border-strong}" Background="{DynamicResource color.surface}">
              <Path x:Name="Check" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource color.on-primary}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource color.primary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource color.primary}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource color.primary}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiNavigationButton" TargetType="ToggleButton" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource color.secondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-family.ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="MinHeight" Value="{DynamicResource size.control}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <ui:FeedbackBorder x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource radius.control}"
                               Pressed="{TemplateBinding IsPressed}" Hot="{TemplateBinding IsMouseOver}" TintBrush="{DynamicResource color.text}">
              <Grid>
                <Border x:Name="Marker" Width="3" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource color.primary}" Visibility="Collapsed" />
                <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Grid>
            </ui:FeedbackBorder>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.subtle}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.selected}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource color.primary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.62" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiTabItem" TargetType="TabItem" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Foreground" Value="{DynamicResource color.muted}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-family.ui}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size.label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" CornerRadius="6,6,0,0">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.subtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.selected}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource color.primary}" />
              <Setter Property="Foreground" Value="{DynamicResource color.primary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.62" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiTabs" TargetType="TabControl" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource UiTabItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource color.border}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource radius.control}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiRibbonTabItem" TargetType="TabItem" BasedOn="{StaticResource UiTabItem}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="MinHeight" Value="33" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" CornerRadius="7,7,0,0">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.subtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.selected}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource color.primary}" />
              <Setter Property="Foreground" Value="{DynamicResource color.primary}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.62" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiRibbonTabs" TargetType="TabControl" BasedOn="{StaticResource UiTabs}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="{DynamicResource color.surface}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource UiRibbonTabItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource color.subtle}" BorderBrush="{DynamicResource color.border}" BorderThickness="0,0,0,1" Padding="12,5,12,0">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            </Border>
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiProfileRow" TargetType="ListBoxItem" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="{DynamicResource color.surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{DynamicResource size.control}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Frame" Style="{StaticResource UiOutlineFrame}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource radius.control}">
            <Grid>
              <Border x:Name="Marker" Width="3" Margin="0,3" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource color.primary}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource color.primary-border}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource color.selected}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource color.primary-border}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.62" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiProfileList" TargetType="ListBox" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource UiProfileRow}" />
  </Style>
  <Style x:Key="UiTableRow" TargetType="DataGridRow" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="MinHeight" Value="31" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource color.subtle}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource color.selected}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="UiTableCell" TargetType="DataGridCell" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="7,3">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="SelectionEdge" BorderBrush="{DynamicResource color.primary}" BorderThickness="0,0,0,2"
                    IsHitTestVisible="False" SnapsToDevicePixels="True" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionEdge" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource color.selected}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource color.primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="UiTableHeader" TargetType="DataGridColumnHeader" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="{DynamicResource color.subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Foreground" Value="{DynamicResource color.muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="{DynamicResource size.control-small}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style x:Key="UiTable" TargetType="DataGrid" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Background" Value="{DynamicResource color.surface}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource color.subtle}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-family.ui}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size.label}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource color.border}" />
    <Setter Property="RowStyle" Value="{StaticResource UiTableRow}" />
    <Setter Property="CellStyle" Value="{StaticResource UiTableCell}" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource UiTableHeader}" />
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource UiCheckBox}" />
</ResourceDictionary>
