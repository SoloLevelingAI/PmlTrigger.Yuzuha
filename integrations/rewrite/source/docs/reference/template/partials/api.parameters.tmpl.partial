{{#syntax.parameters.0}}
<div class="api-table-wrap"><table class="api-table parameters-table">
<caption>{{__global.parameters}}</caption><thead><tr><th scope="col">参数</th><th scope="col">类型</th><th scope="col">说明</th></tr></thead><tbody>
{{#syntax.parameters}}<tr><td><code>{{id}}</code></td><td class="type-cell">{{{type.specName.0.value}}}</td><td>{{{description}}}</td></tr>{{/syntax.parameters}}
</tbody></table></div>
{{/syntax.parameters.0}}
{{#syntax.typeParameters.0}}
<div class="api-table-wrap"><table class="api-table"><caption>{{__global.typeParameters}}</caption><thead><tr><th scope="col">类型参数</th><th scope="col">说明</th></tr></thead><tbody>
{{#syntax.typeParameters}}<tr><td><code>{{id}}</code></td><td>{{{description}}}</td></tr>{{/syntax.typeParameters}}
</tbody></table></div>
{{/syntax.typeParameters.0}}
{{#syntax.return}}
<div class="api-table-wrap"><table class="api-table return-table"><caption>{{__global.returns}}</caption><thead><tr><th scope="col">类型</th><th scope="col">说明</th></tr></thead><tbody>
<tr><td class="type-cell">{{{type.specName.0.value}}}</td><td>{{{description}}}</td></tr>
</tbody></table></div>
{{/syntax.return}}
