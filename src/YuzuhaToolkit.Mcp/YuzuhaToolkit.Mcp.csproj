<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
<!--        <PublishAot>true</PublishAot>-->
        <AssemblyName>YuzuhaToolkit.Mcp</AssemblyName>
        <RootNamespace>YuzuhaToolkit.Mcp</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
    <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
        <!-- The reflection-heavy RPC/JSON assemblies and this contract
             assembly are rooted in full below. IL2104 is therefore only the
             linker summary for code that is intentionally preserved. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"
                          Version="10.0.0"/>
        <PackageReference Include="ModelContextProtocol"
                          Version="1.4.1"/>
    </ItemGroup>

    <!-- PlantHost.Rpc builds its client proxy and serializes RPC contracts via
         reflection. Preserve these small assemblies while trimming the
         self-contained framework and the rest of the application. -->
    <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
        <TrimmerRootAssembly Include="YuzuhaToolkit.Mcp" />
        <TrimmerRootAssembly Include="PlantHost.Rpc.Abstractions" />
        <TrimmerRootAssembly Include="PlantHost.Rpc.Net8" />
        <TrimmerRootAssembly Include="Newtonsoft.Json" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="PlantHost.Rpc.Abstractions">
            <HintPath>..\lib\net10\PlantHost.Rpc.Abstractions.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="PlantHost.Rpc.Net8">
            <HintPath>..\lib\net10\PlantHost.Rpc.Net8.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>..\lib\net10\Newtonsoft.Json.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\PmlMethodSignatureGenerator.cs"
                 Link="Generator\PmlMethodSignatureGenerator.cs"/>
    </ItemGroup>
</Project>
