--
--
-- Description:
-- Read the object graph of a named DBREF (short name, /full path or
-- =dbref). Temporarily switches CE to the target and restores the
-- original CE afterwards. Returns a flattened array.
--
------------------------------------------------------------------------
--
-- Functions defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  !!YuzuhaReadDbref(REAL,REAL,STRING,STRING)                            ARRAY           Reads a named DBREF graph, restoring the original CE.
--
define function !!YuzuhaReadDbref(!size is real,!depth is real,!startStr is string,!name is string) is array
  !arr = object array()
  !originalCe = ce
  !namestr = !name
  if !name.matchwild('=*').not() and !name.matchwild('/*').not() then
    !namestr = '/' + !namestr
  endif
  !targetDb = $!namestr
  handle any
    return !arr
  endhandle
  if !targetDb.badref() then
    return !arr
  endif
  $!targetDb
  handle any
    return !arr
  endhandle
  !ob = object YuzuhaObjectWalker()
  !OB.InitializeFromCurrentElement()
  -- !ob.MaxArraySize  = 300
  -- !ob.MaxBFSDepth   = 3
  -- !ob.startStr = 'hpos'
  !ob.MaxArraySize  = !size
  !ob.MaxBFSDepth   = !depth
  !ob.startStr = !startStr
  !arr = !ob.Read()
  handle any
    $!originalCe
    return !arr
  endhandle
  $!originalCe
  RETURN !arr
endfunction

