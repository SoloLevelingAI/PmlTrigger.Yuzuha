<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YuzuhaToolkit.Mcp.Core</AssemblyName>
    <RootNamespace>YuzuhaToolkit.Mcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <ProjectReference Include="../PlantHost.Rpc.Net10/PlantHost.Rpc.Net10.csproj" />
    <ProjectReference Include="../PmlTwin.Phayton/PmlTwin.Phayton.csproj" />
    <ProjectReference Include="../YuzuhaToolkit.Workspace/YuzuhaToolkit.Workspace.csproj" />
    <ProjectReference Include="../YuzuhaToolkit.CommandLine/YuzuhaToolkit.CommandLine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\PmlMethodSignatureGenerator.cs"
             Link="Generator\PmlMethodSignatureGenerator.cs"/>
    <Compile Include="../Shared/BuiltinGuideCatalog.cs" Link="Builtins/BuiltinGuideCatalog.cs" />
    <Compile Include="../Shared/PmlArrayWindow.cs" Link="PmlArrayWindow.cs" />
    <Compile Include="../Shared/PmlFormQuery.cs" Link="PmlFormQuery.cs" />
    <EmbeddedResource Include="../../docs/builtin/*.md" LogicalName="Yuzuha.Builtin.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
