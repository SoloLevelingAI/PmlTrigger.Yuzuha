--
--
-- Description:
-- Extracts the bracketed gadget type from VAR diagnostic text.
-- Returns an empty string on inspection or parsing failure.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call              Return  Description
--  ===========              ======  ===========
--  !!YuzuhaGetGadgetType()  -       -
--
------------------------------------------------------------------------
define function !!YuzuhaGetGadgetType(!gadget is any ) is string
  var !gadType var !gadget
  handle any
    return ''
  endhandle
  !type = !gadType.split('[')[2].split(']')[1]
  handle any
  return ''
  endhandle
  return !type
endfunction
