<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YuzuhaToolkit.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YuzuhaToolkit.Desktop.MainWindow" Title="PMLTWIN · Yuzuha 工作台" FontFamily="Segoe UI,Microsoft YaHei UI" FontSize="12" Width="1453" Height="1062" MinWidth="840" MinHeight="480" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown" Foreground="{DynamicResource Text.Primary}">
  <Grid Background="{DynamicResource Surface.Page}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Brand.Sidebar}">
      <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="144">
          <Border CornerRadius="9" BorderBrush="{DynamicResource Brand.SidebarBorder}" BorderThickness="1" Padding="3" Margin="16,8,16,0" Height="40" VerticalAlignment="Top">
            <UniformGrid Columns="2">
              <Button x:Name="LightThemeButton" Content="☀ 明亮" Tag="Light" Click="ChooseTheme" Margin="0" FontSize="12" Padding="8,5" MinHeight="30" />
              <Button x:Name="DarkThemeButton" Content="☾ 黑暗" Tag="Dark" Click="ChooseTheme" Margin="0" FontSize="12" Padding="8,5" MinHeight="30" />
            </UniformGrid>
          </Border>
          <TextBlock Text="Yuzuha Toolkit · PMLTWIN v0.4" Foreground="{DynamicResource Brand.NavMuted}" FontSize="10" Margin="24,0,0,30" VerticalAlignment="Bottom" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,28,16,0">
            <Grid Margin="8,0,0,26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" HorizontalAlignment="Left" Background="{DynamicResource Surface.Logo}" BorderBrush="{DynamicResource Surface.LogoBorder}" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Path Data="M10 11 L19 20 L28 11 M19 20 L19 30" Stroke="{DynamicResource Brand.LogoLine}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource Brand.NavIndicator}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,7,0" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Yuzuha" Foreground="{DynamicResource Text.OnDark}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="ENGINEERING AI" Foreground="{DynamicResource Brand.NavMuted}" FontSize="9" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource Brand.SidebarPanel}" BorderBrush="{DynamicResource Brand.SidebarBorder}" BorderThickness="1" CornerRadius="11" Padding="14,5" Height="42">
              <StackPanel>
                <TextBlock Text="本机工作台" Foreground="{DynamicResource Text.OnDark}" FontSize="13" />
                <TextBlock Text="LOCAL · AVEVA TOOLCHAIN" Foreground="{DynamicResource Brand.NavMuted}" FontSize="8" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <StackPanel x:Name="SidebarNav">
              <TextBlock Text="工作台" Style="{StaticResource NavGroup}" />
              <Button Uid="总览" Tag="4" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.grid}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="总览" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="启动工程" Tag="0" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.rocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="启动工程" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="工程会话" Tag="3" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.link}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="工程会话" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="交付" Style="{StaticResource NavGroup}" />
              <Button Uid="评审中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.check_circle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="评审中心" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="测试中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.activity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="测试中心" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="插件部署" Tag="1" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.package}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="插件部署" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="运行" Style="{StaticResource NavGroup}" />
              <Button Uid="AI 运行" Tag="2" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.cpu}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="AI 运行" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="工具日志" Tag="7" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.file}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="工具日志" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="Web 应用" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.external}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="Web 应用" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="资源" Style="{StaticResource NavGroup}" />
              <Button Uid="知识库" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.book}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="知识库" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Uid="设置" Tag="6" Style="{StaticResource NavButton}" Click="Navigate">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.sliders}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Text="设置" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Border Background="{DynamicResource Brand.SidebarPanel}" BorderBrush="{DynamicResource Brand.SidebarBorder}" BorderThickness="1" CornerRadius="14" Margin="0,24,0,20" Padding="12">
              <StackPanel>
                <TextBlock Text="AVEVA 环境" Foreground="{DynamicResource Brand.NavMuted}" FontSize="11" />
                <TextBlock x:Name="SidebarTargetText" Text="尚未选择目标" Foreground="{DynamicResource Text.OnDark}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,5" />
                <Border Background="{DynamicResource Brand.SidebarBorder}" Height="1" />
                <Button Content="管理环境    →" Foreground="{DynamicResource Text.CodeAccent}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0,7,0,0" Margin="0" Tag="3" Uid="工程会话" Click="Navigate" />
              </StackPanel>
            </Border>
            <DockPanel Margin="0">
              <Border DockPanel.Dock="Left" Background="{DynamicResource Brand.Account}" CornerRadius="17" Width="34" Height="34" Margin="0,0,10,0">
                <TextBlock Text="Y" Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock x:Name="MaintainerText" Text="本机用户" Foreground="{DynamicResource Text.OnDark}" FontSize="13" />
                <TextBlock Text="本机维护者" Foreground="{DynamicResource Brand.NavMuted}" FontSize="10" Margin="0,3,0,0" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" Margin="28,22,28,22" MinHeight="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel ClipToBounds="True">
          <TextBlock x:Name="PageTitleText" Text="总览" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PageSubtitleText" Text="本机工作台 · 从明确的工程目标开始" Style="{StaticResource Caption}" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border x:Name="SearchPanel" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Input}" BorderThickness="1" CornerRadius="10" Width="232" Height="40" Margin="0,0,16,0">
            <DockPanel Margin="12,0">
              <Viewbox Width="16" Margin="0,0,8,0">
                <Path Data="{StaticResource Icon.search}" Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.8" />
              </Viewbox>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="{DynamicResource Text.Tertiary}" FontSize="10" VerticalAlignment="Center" />
              <TextBox x:Name="NavigationSearch" ToolTip="搜索页面，按 Enter 前往" KeyDown="SearchKeyDown" BorderThickness="0" Background="Transparent" Padding="0,4" Margin="0" FontSize="11" Tag="搜索页面…" />
            </DockPanel>
          </Border>
          <Button x:Name="HeaderActionButton" Click="HeaderAction" Style="{StaticResource Primary}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                <Path Data="{StaticResource Icon.play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" x:Name="HeaderActionIcon" />
              </Viewbox>
              <TextBlock x:Name="HeaderActionText" Text="启动工程" />
            </StackPanel>
          </Button>
          <Button Width="40" Padding="10" Click="OpenLogs" ToolTip="打开本机工具日志目录" Margin="0,0,10,0">
            <Viewbox Width="17" Height="17">
              <Path Data="{StaticResource Icon.bell}" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Viewbox>
          </Button>
          <Button Content="?" Width="38" Margin="0" Click="ShowHelp" ToolTip="使用说明" />
        </StackPanel>
      </Grid>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Page}" Padding="28,0,28,3">
        <DockPanel>
          <TextBlock x:Name="HeartbeatText" DockPanel.Dock="Right" Text="读取本机状态…" Style="{StaticResource Caption}" Margin="16,0,0,0" />
          <TextBlock x:Name="MessageText" Text="就绪 · 本机记录" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
      </Border>
      <TabControl x:Name="Tabs" Margin="28,0,28,0" Background="Transparent" BorderThickness="0" SelectedIndex="4" SelectionChanged="PageSelected">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="启动工程">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid x:Name="LaunchColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="新建配置  +" Click="NewProfile" FontSize="12" />
                      <StackPanel>
                        <TextBlock Text="启动配置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Monitor / Marine 启动 · 本机凭据供下次自动登录" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" Margin="0,18,0,16" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="程序入口" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseExecutable" Margin="6,5,0,12" />
                          <TextBox x:Name="ExecutableBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="初始化文件" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseInitialization" Margin="6,5,0,12" />
                          <TextBox x:Name="InitializationBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="工作目录" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseWorkingDirectory" Margin="6,5,0,12" />
                          <TextBox x:Name="WorkingBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="MDB" Style="{StaticResource Caption}" />
                        <TextBox x:Name="MdbBox" Text="/ALL_NO_MDS" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="项目" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ProjectBox" FontSize="12" />
                        <TextBlock Text="用户名" Style="{StaticResource Caption}" />
                        <TextBox x:Name="UserBox" FontSize="12" />
                        <TextBlock Text="启动模块" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ModuleBox" Text="Design" FontSize="12" />
                        <TextBlock Text="密码（留空沿用已保存凭据）" Style="{StaticResource Caption}" />
                        <PasswordBox x:Name="PasswordInput" FontSize="12" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,4,0,8">
                      <CheckBox x:Name="RememberPasswordBox" Content="保存密码到本机凭据，供下次登录" IsChecked="True" VerticalAlignment="Center" />
                      <Button Content="清除已存密码" Click="ClearSavedPassword" Style="{StaticResource Link}" Margin="12,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="PasswordStatusText" Text="尚未保存密码" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <Expander Header="配置名称与产品 / 许可" FontSize="12" Margin="0,4,0,12">
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="配置名称" Style="{StaticResource Caption}" />
                        <TextBox x:Name="NameBox" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="入口类型" Style="{StaticResource Caption}" />
                            <ComboBox x:Name="KindBox" SelectedIndex="0">
                              <ComboBoxItem Content="Monitor" />
                              <ComboBoxItem Content="MarineBatch" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="产品代码" Style="{StaticResource Caption}" />
                            <TextBox x:Name="ProductBox" Text="E3D" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="许可连接（留空沿用）" Style="{StaticResource Caption}" />
                        <TextBox x:Name="LicenseBox" />
                      </StackPanel>
                    </Expander>
                    <DockPanel Margin="0,5,0,0">
                      <WrapPanel DockPanel.Dock="Right">
                        <Button Content="保存配置" Click="SaveProfile" FontSize="12" />
                        <Button Content="预览参数" Click="PreviewLaunch" FontSize="12" />
                        <Button x:Name="LaunchButton" Content="▶ 保存并启动工程" Style="{StaticResource Primary}" Click="Launch" FontSize="12" Margin="0" />
                      </WrapPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                        <TextBlock Text="本机" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
                      </Border>
                      <TextBlock Text="启动前检查" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="入口、初始化文件、工作目录和注册目录" Style="{StaticResource Caption}" Margin="0,8,0,20" />
                    <TextBlock x:Name="LaunchHealthText" Text="选择已注册的 PMLLIB 后扫描文件量与目录体积。启动入口由已有服务验证。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="13" />
                    <Border Background="{DynamicResource Surface.TintWarning}" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                      <TextBlock Text="启动入口创建成功与登录完成分别确认；Host 身份在会话就绪后核验。" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" />
                    </Border>
                    <TextBlock Text="目录提醒预算可调整；它不是 AVEVA 的固定上限。" Style="{StaticResource Caption}" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid x:Name="LaunchLowerColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="启动参数预览" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="由现有 LaunchService 生成 · 原生参数列表" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                    <TextBox x:Name="LaunchPreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="138" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" BorderBrush="{DynamicResource Surface.Code}" FontFamily="Consolas" FontSize="12" />
                    <WrapPanel>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="原生启动" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
                      </Border>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="不修改系统 EVAR" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
                      </Border>
                      <Border Style="{StaticResource Pill}">
                        <TextBlock Text="配置不含密码正文" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="重新发现" Click="Discover" Style="{StaticResource Link}" FontSize="12" />
                      <TextBlock Text="本机产品入口" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="注册表与 EVAR 候选" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <ListBox x:Name="ApplicationsBox" Height="138" DisplayMemberPath="Path" BorderThickness="0" FontSize="12" />
                    <Button Content="使用所选入口    →" Click="UseApplication" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="插件部署">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="部署流程" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="来源、复制与重加载的结果分别记录" Style="{StaticResource Caption}" />
                  <UniformGrid Columns="4" Margin="0,16,0,0">
                    <TextBlock Text="① 选择源目录" Foreground="{DynamicResource Text.Brand}" />
                    <TextBlock Text="② 预览复制差异" Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="③ 复制与备份" Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="④ 重加载与验证" Foreground="{DynamicResource Text.Tertiary}" />
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Grid x:Name="DeploymentColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="预览复制内容" Click="PreviewCopy" FontSize="11" />
                      <TextBlock Text="复制预览" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="开发副本保留在注册 PMLLIB 之外" Style="{StaticResource Caption}" />
                    <DataGrid x:Name="CopyGrid" Height="190">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="文件 / 相对路径" Binding="{Binding RelativePath}" Width="*" />
                        <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="90" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Action}" Width="100" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CopySummaryText" Text="尚未预览复制内容" Style="{StaticResource Caption}" Margin="0,14,0,12" />
                    <Button x:Name="ApplyCopyButton" Content="复制到注册目录" Click="ApplyCopy" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="目标检查" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="选择已有注册目录，不修改全局环境" Style="{StaticResource Caption}" />
                    <DockPanel Margin="0,14,0,0">
                      <Button DockPanel.Dock="Right" Content="…" Click="BrowseRegistered" Width="32" Padding="0" Margin="8,4,0,10" />
