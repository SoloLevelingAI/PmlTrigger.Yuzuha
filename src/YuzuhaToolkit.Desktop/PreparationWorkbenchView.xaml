<UserControl x:Class="YuzuhaToolkit.Desktop.PreparationWorkbenchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Accent.Brand}" BorderThickness="0,3,0,0" Padding="0,12,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="从安装，走到可核验的工程。" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="TargetSummary" Text="先核对已安装工具包，再明确选择产品环境。" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="ION / NATIVE WORKSPACE" FontFamily="Consolas" Foreground="{DynamicResource Text.Tertiary}" FontSize="11"/><ComboBox x:Name="PalettePicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PaletteChanged" AutomationProperties.Name="准备工作区配色" Width="155" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="StepColumn" Width="158"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Padding="6">
        <DockPanel><TextBlock DockPanel.Dock="Bottom" Text="步骤用于导航。完成状态只来自实际回执。" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="8,12,8,6"/>
          <ListBox x:Name="Stages" SelectionChanged="StageChanged" BorderThickness="0" Background="Transparent" AutomationProperties.Name="安装到操作的阶段" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="StageBorder" Background="{DynamicResource Surface.Card}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Surface.Subtle}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Brand.NavSelected}"/><Setter Property="Foreground" Value="{DynamicResource Brand.NavSelectedText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="StageBorder" Property="BorderBrush" Value="{DynamicResource Text.Brand}"/></Trigger>
              </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Background="{DynamicResource Surface.Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,12,16,0"><TextBlock x:Name="StageTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StageStatus" Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,9"/></StackPanel>
          <TabControl x:Name="Readers" SelectionChanged="ReaderChanged" Background="Transparent" BorderThickness="0">
            <TabItem Header="操作摘要" Tag="summary"><ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,12,16,12">
              <StackPanel x:Name="PackagePanel"><TextBlock Text="工具包根目录" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="选择…" Click="BrowsePackage" Margin="8,4,0,8"/><TextBox x:Name="PackageBox" TextChanged="DraftChanged" ToolTip="安装器交付的应用根，或待核对载荷根"/></DockPanel><Button x:Name="ReinspectButton" Content="重新核验交接（只读）" Click="InspectHandoff" HorizontalAlignment="Left"/></StackPanel>
              <StackPanel x:Name="DiscoveryPanel"><TextBlock Text="扫描范围" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseScan" Margin="8,4,0,8"/><TextBox x:Name="ScanBox" ToolTip="输入一个产品根或其父目录；扫描有数量和时间预算"/></DockPanel><TextBlock Text="只读扫描，不执行厂商BAT；明确选择一个候选后才可预览。" Style="{StaticResource Caption}" TextWrapping="Wrap"/><ListBox x:Name="Installations" DisplayMemberPath="Label" SelectionChanged="InstallationChanged" MinHeight="90" MaxHeight="170" AutomationProperties.Name="发现的产品安装候选"/></StackPanel>
              <StackPanel x:Name="DeploymentPanel">
                <TextBlock Text="明确的产品与环境" FontWeight="SemiBold"/><TextBlock x:Name="InstallationSummary" Text="尚未选择；先进入“选择环境”。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="部署方式" Style="{StaticResource Caption}"/><ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged" SelectedIndex="0"><ComboBoxItem Content="引用已安装应用（保留Inno所有权）" Tag="reference"/><ComboBoxItem Content="复制到独立受管运行目录" Tag="copy"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Host profile" Style="{StaticResource Caption}"/><ComboBox x:Name="ProfileBox" SelectedValuePath="Tag" SelectionChanged="ProfileChanged" AutomationProperties.Name="明确选择Host版本"><ComboBoxItem Content="E3D 2.1" Tag="E3D2.1"/><ComboBoxItem Content="E3D 3.1.6" Tag="E3D3.1.6"/><ComboBoxItem Content="AM" Tag="AM"/><ComboBoxItem Content="PDMS" Tag="PDMS"/></ComboBox></StackPanel></Grid>
                <StackPanel x:Name="RuntimePanel"><TextBlock Text="独立运行根" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择…" Click="BrowseRuntime" Margin="8,4,0,8"/><TextBox x:Name="RuntimeBox" TextChanged="DraftChanged"/></DockPanel></StackPanel>
                <TextBlock Text="实际INIT / BAT文件" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择…" Click="BrowseEnvironment" Margin="8,4,0,8"/><TextBox x:Name="EnvironmentBox" TextChanged="DraftChanged"/></DockPanel>
                <CheckBox x:Name="EvarsOnly" Content="仅预览EVARS受管行，不复制运行文件" Checked="PreviewModeChanged" Unchecked="PreviewModeChanged" Margin="0,4,0,8"/>
              </StackPanel>
              <StackPanel x:Name="OwnershipPanel"><TextBlock Text="旧安装器所有权与迁移" FontWeight="SemiBold"/><TextBlock Text="先核对旧EVARS所有者。移交只更新所有权记录；不会写EVARS。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8"/><TextBlock Text="旧安装器环境文件" Style="{StaticResource Caption}"/><TextBox x:Name="LegacyEnvironmentBox" TextChanged="LegacyDraftChanged"/><Button Content="预览旧所有权移交" Click="PreviewOwnership" HorizontalAlignment="Left"/><Expander Header="只读查看其他来源（不激活、不切换数据库）" Margin="0,12,0,0"><StackPanel><ComboBox x:Name="MigrationFormatBox" SelectionChanged="MigrationFormatChanged" SelectedIndex="0"><ComboBoxItem Content="rewrite"/><ComboBoxItem Content="next"/><ComboBoxItem Content="ribbon"/></ComboBox><DockPanel><Button DockPanel.Dock="Right" Content="选文件" Click="BrowseMigration" Margin="8,4,0,8"/><TextBox x:Name="MigrationBox" TextChanged="DraftChanged"/></DockPanel><Button Content="只读预览迁移来源" Click="PreviewMigration" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel>
              <StackPanel x:Name="PlanPanel"><TextBlock Text="本次冻结计划" FontWeight="SemiBold"/><TextBlock x:Name="PlanSummary" Text="尚未生成冻结计划。" TextWrapping="Wrap" Margin="0,7,0,0"/><Expander Header="核对计划身份与SHA" Margin="0,8,0,0"><TextBlock x:Name="PlanIdentity" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap"/></Expander></StackPanel>
              <StackPanel x:Name="RecoveryPanel"><TextBlock Text="按原回执条件恢复" FontWeight="SemiBold"/><TextBlock x:Name="RecoverySummary" Text="尚无可恢复回执。" TextWrapping="Wrap" Margin="0,7,0,8"/><Button x:Name="RestoreButton" Content="核对并恢复上次变更…" Click="Restore" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel>
              <StackPanel x:Name="LaunchPanel"><TextBlock Text="保存配置与明确启动" FontWeight="SemiBold"/><TextBlock Text="准备结果仅说明文件/受管环境写入完成。继续使用已有启动协调器：配置→冻结→明确启动→按原编号观察。" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="前往启动工程 →" Click="GoLaunch" HorizontalAlignment="Left"/></StackPanel>
              <StackPanel x:Name="VerifyPanel"><TextBlock Text="严格会话身份与操作目标" FontWeight="SemiBold"/><TextBlock Text="进程创建、Host可用、人工选择目标分别判断。进入已有会话核验后再查询或调用；本页不会自动连接、授予权限或发送PML。" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="前往连接与核验 →" Click="GoVerify" HorizontalAlignment="Left"/></StackPanel>
              <Expander x:Name="RawResultExpander" Header="完整操作回执与诊断" Margin="0,12,0,0"><TextBox x:Name="ResultBody" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="110" VerticalScrollBarVisibility="Auto"/></Expander>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="完整契约" Tag="contract"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContractFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="解释脚本" Tag="scripts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScriptFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="验收证据" Tag="evidence"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,12"><TextBlock Text="本阶段的验收边界" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceBoundary" TextWrapping="Wrap" Margin="0,10,0,14"/><TextBlock Text="本次真实操作回执" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceResult" Text="尚未执行；阅读阶段不是验收通过。" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="打开完整任务契约与验收说明 ↗" Click="OpenContractDocument" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ActionEffect" Text="本次只读核对应用载荷与安装记录。" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="InlineResult" Text="等待你的明确操作。" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="PrimaryAction" Grid.Column="1" Content="核对安装交接" Click="RunPrimary" Style="{StaticResource Primary}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</UserControl>
