    description "六阶段真实执行记录；与拟议应用调用图分开。"
    scope = stage "需求整理" {
      description "原生节点已完成；运行 ec42ac4a-2167-4fd2-91d4-085b7d6aef7c"
    }
    alternatives = stage "候选比较" {
      description "原生节点已完成；运行 ec42ac4a-2167-4fd2-91d4-085b7d6aef7c"
    }
    contracts = stage "类型契约" {
      description "原生节点已完成；运行 ec42ac4a-2167-4fd2-91d4-085b7d6aef7c"
    }
    challenge = stage "反例审阅" {
      description "原生节点已完成；运行 ec42ac4a-2167-4fd2-91d4-085b7d6aef7c"
    }
    revision = stage "修订契约" {
      description "原生节点已完成；运行 ec42ac4a-2167-4fd2-91d4-085b7d6aef7c"
    }
    recheck = stage "独立复核" {
      description "原生节点已完成；运行 8b32f133-0d10-4e7c-acfd-ea34ed974513"
    }
    human_review = gate "人工审阅" {
      description "等待人工审阅，实施未批准。"
    }
  }
  review.scope -> review.alternatives "审阅产物交接"
  review.alternatives -> review.contracts "审阅产物交接"
  review.contracts -> review.challenge "审阅产物交接"
  review.challenge -> review.revision "审阅产物交接"
  review.revision -> review.recheck "审阅产物交接"
  review.recheck -> review.human_review "审阅产物交接"
}
