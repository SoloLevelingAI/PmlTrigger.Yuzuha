<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YuzuhaToolkit.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YuzuhaToolkit.Desktop.MainWindow" Title="PMLTWIN · Yuzuha 工作台" FontFamily="Segoe UI,Microsoft YaHei UI" FontSize="13" Width="1456" Height="1063" MinWidth="840" MinHeight="480" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown" Foreground="{DynamicResource Text.Primary}">
  <Grid Background="{DynamicResource Surface.Page}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Brand.Sidebar}" BorderBrush="{DynamicResource Brand.SidebarBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,26,16,12">
          <Button Uid="总览" Tag="4" Click="Navigate" Style="{StaticResource NavButton}" Padding="8,0" Margin="0,0,0,28">
            <StackPanel Orientation="Horizontal">
              <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource Accent.Brand}" Margin="0,0,12,0"><TextBlock Text="Y" Foreground="{DynamicResource Text.OnAccent}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel><TextBlock Text="Yuzuha" Foreground="{DynamicResource Text.Primary}" FontSize="21" FontWeight="Bold" /><TextBlock Text="ENGINEERING AI" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" /></StackPanel>
            </StackPanel>
          </Button>
          <Button Uid="设置" Tag="6" Click="Navigate" Background="{DynamicResource Surface.Subtle}" BorderThickness="0" Padding="12,8" Margin="0" HorizontalContentAlignment="Left">
            <StackPanel><TextBlock Text="●  本机工作台" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" /><TextBlock Text="LOCAL · AVEVA TOOLCHAIN" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,3,0,0" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,18">
          <Button x:Name="SidebarEnvironmentButton" Uid="设置" Tag="6" Click="Navigate" Margin="0,0,0,14" Padding="12" Background="{DynamicResource Surface.Subtle}" BorderThickness="0" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="AVEVA 环境" Style="{StaticResource Caption}" />
              <TextBlock x:Name="SidebarTargetText" Text="尚未选择目标" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}" Margin="0,6,0,7" />
              <Border Background="{DynamicResource Border.Default}" Height="1" />
              <TextBlock Text="管理环境  ›" Foreground="{DynamicResource Text.Brand}" Margin="0,7,0,0" />
            </StackPanel>
          </Button>
          <Border CornerRadius="9" Background="{DynamicResource Surface.Track}" Padding="3" Margin="0,0,0,14">
            <UniformGrid Columns="2">
              <Button x:Name="LightThemeButton" Content="明亮" Tag="Light" Click="ChooseTheme" BorderThickness="0" Margin="0" Padding="8,5" MinHeight="30" />
              <Button x:Name="DarkThemeButton" Content="深色" Tag="Dark" Click="ChooseTheme" BorderThickness="0" Margin="0" Padding="8,5" MinHeight="30" />
            </UniformGrid>
          </Border>
          <Button x:Name="SidebarAccountButton" Uid="设置" Tag="6" Click="Navigate" Style="{StaticResource NavButton}" Padding="0" Margin="0,0,0,26">
            <StackPanel Orientation="Horizontal">
              <Border Background="{DynamicResource Accent.Brand}" CornerRadius="17" Width="34" Height="34" Margin="0,0,10,0"><TextBlock Text="Y" Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel><TextBlock x:Name="MaintainerText" Text="本机用户" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" /><TextBlock Text="本机维护者" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
            </StackPanel>
          </Button>
          <TextBlock x:Name="SidebarFooter" Text="Yuzuha Toolkit · v08" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" FontFamily="Consolas" Margin="8,0,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SidebarNav" Margin="16,0,16,0">
            <TextBlock Text="工作台" Style="{StaticResource NavGroup}" />
            <Button Uid="总览" Tag="4" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.grid}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="总览" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="启动工程" Tag="0" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.rocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="启动工程" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="工程会话" Tag="3" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.link}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="工程会话" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="交付" Style="{StaticResource NavGroup}" />
            <Button Uid="评审中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.check_circle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="评审中心" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="测试中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.activity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="测试中心" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="插件部署" Tag="1" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.package}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="插件部署" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="运行" Style="{StaticResource NavGroup}" />
            <Button Uid="AI 运行" Tag="2" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.cpu}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="AI 运行" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="工具日志" Tag="7" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.file}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="工具日志" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="Web 应用" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.external}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="Web 应用" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="资源" Style="{StaticResource NavGroup}" />
            <Button Uid="知识库" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.book}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="知识库" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="设置" Tag="6" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,12,0"><Path Data="{StaticResource Icon.sliders}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock Text="设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" Margin="28,22,28,22" MinHeight="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel ClipToBounds="True">
          <TextBlock x:Name="PageTitleText" Text="总览" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PageSubtitleText" Text="本机工作台 · 从明确的工程目标开始" Style="{StaticResource Caption}" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border x:Name="SearchPanel" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Input}" BorderThickness="1" CornerRadius="10" Width="232" Height="40" Margin="0,0,16,0">
            <DockPanel Margin="12,0">
              <Viewbox Width="16" Margin="0,0,8,0">
                <Path Data="{StaticResource Icon.search}" Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.8" />
              </Viewbox>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" VerticalAlignment="Center" />
              <TextBox x:Name="NavigationSearch" ToolTip="搜索页面，按 Enter 前往" KeyDown="SearchKeyDown" BorderThickness="0" Background="Transparent" Padding="0,4" Margin="0" FontSize="12" Tag="搜索页面…" />
            </DockPanel>
          </Border>
          <Button x:Name="HeaderActionButton" Click="HeaderAction" Style="{StaticResource Primary}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                <Path Data="{StaticResource Icon.play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" x:Name="HeaderActionIcon" />
              </Viewbox>
              <TextBlock x:Name="HeaderActionText" Text="启动工程" />
            </StackPanel>
          </Button>
          <Button Width="40" Padding="10" Click="OpenLogs" ToolTip="打开本机工具日志目录" Margin="0,0,10,0">
            <Viewbox Width="17" Height="17">
              <Path Data="{StaticResource Icon.bell}" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Viewbox>
          </Button>
          <Button Content="?" Width="38" Margin="0" Click="ShowHelp" ToolTip="使用说明" />
        </StackPanel>
      </Grid>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Page}" Padding="28,0,28,3">
        <DockPanel>
          <TextBlock x:Name="HeartbeatText" DockPanel.Dock="Right" Text="读取本机状态…" Style="{StaticResource Caption}" Margin="16,0,0,0" />
          <TextBlock x:Name="MessageText" Text="就绪 · 本机记录" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
      </Border>
      <TabControl x:Name="Tabs" Margin="28,0,28,0" Background="Transparent" BorderThickness="0" SelectedIndex="4" SelectionChanged="PageSelected">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="启动工程">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid x:Name="LaunchColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="配置库" Click="OpenProfileLibrary" Style="{StaticResource Quiet}" />
                        <Button Content="从 LaunchDesk 带入" Click="ReadLaunchDeskDrafts" FontSize="13" />
                        <Button Content="新建配置  +" Click="NewProfile" FontSize="13" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="启动配置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Monitor / Marine 启动 · 本机凭据供下次自动登录" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" Margin="0,18,0,16" />
                    <StackPanel x:Name="LaunchDeskDraftsPanel" Visibility="Collapsed" Margin="0,0,0,12">
                      <TextBlock Text="选择 LaunchDesk 配置（带入后可直接修改）" Style="{StaticResource Caption}"/>
                      <DockPanel><Button DockPanel.Dock="Right" Content="带入所选配置" Click="UseLaunchDeskDraft"/><ComboBox x:Name="LaunchDeskDraftsBox" DisplayMemberPath="Name"/></DockPanel>
                      <TextBlock Text="密码在 Yuzuha 首次输入；许可沿用环境，可在高级设置修改。" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="1. 选择 AM / E3D 产品" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="LaunchApplicationBox" DisplayMemberPath="Label" SelectionChanged="LaunchApplicationSelected"/>
                    <TextBlock x:Name="LaunchApplicationSummary" Text="选择产品后自动填写入口、初始化文件和工作目录。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock Text="2. 填写登录信息" Style="{StaticResource Caption}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="项目" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ProjectBox" FontSize="13" />
                        <TextBlock Text="MDB" Style="{StaticResource Caption}" />
                        <ComboBox x:Name="MdbBox" IsEditable="True" Text="/ALL_NO_MDS" FontSize="13" ToolTip="可填写，也可选择已保存配置的 MDB" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="用户名" Style="{StaticResource Caption}" />
                        <TextBox x:Name="UserBox" FontSize="13" />
                        <TextBlock Text="启动模块" Style="{StaticResource Caption}" />
                        <ComboBox x:Name="ModuleBox" IsEditable="True" Text="DESIGN" FontSize="13">
                          <ComboBoxItem Content="DESIGN"/><ComboBoxItem Content="PARAGON"/><ComboBoxItem Content="DRAW"/><ComboBoxItem Content="Outfitting"/><ComboBoxItem Content="OutfittingDraft"/>
                        </ComboBox>
                        <TextBlock Text="密码（留空沿用已保存凭据）" Style="{StaticResource Caption}" />
                        <PasswordBox x:Name="PasswordInput" FontSize="13" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,4,0,8">
                      <CheckBox x:Name="RememberPasswordBox" Content="记住本次输入的密码" IsChecked="True" VerticalAlignment="Center" ToolTip="取消后不保存新输入的密码；已存密码在设置中清除" />
                    </WrapPanel>
                    <TextBlock x:Name="PasswordStatusText" Text="尚未保存密码" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <Expander x:Name="LaunchPathsExpander" Header="安装路径（已自动填写，可手动修改）" FontSize="13" Margin="0,4,0,12">
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="程序入口" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseExecutable"/><TextBox x:Name="ExecutableBox"/></DockPanel>
                        <TextBlock Text="初始化文件" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseInitialization"/><TextBox x:Name="InitializationBox"/></DockPanel>
                        <TextBlock Text="工作目录" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseWorkingDirectory"/><TextBox x:Name="WorkingBox"/></DockPanel>
                      </StackPanel>
                    </Expander>
                    <Expander x:Name="ProfileDetailsExpander" Header="高级设置：名称、产品、许可与启动动作" FontSize="13" Margin="0,4,0,12">
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="配置名称" Style="{StaticResource Caption}" />
                        <TextBox x:Name="NameBox" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="入口类型" Style="{StaticResource Caption}" />
                            <ComboBox x:Name="KindBox" SelectedIndex="0">
                              <ComboBoxItem Content="Monitor" />
                              <ComboBoxItem Content="MarineBatch" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="产品代码" Style="{StaticResource Caption}" />
                            <TextBox x:Name="ProductBox" Text="E3D" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="许可连接（留空沿用）" Style="{StaticResource Caption}" />
                        <TextBox x:Name="LicenseBox" />
                          <TextBlock Text="特殊启动策略（YUZUHA_STARTUP_ACTIONS）" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                          <ComboBox x:Name="StartupPolicyBox" SelectedIndex="0"><ComboBoxItem Content="沿用进程环境"/><ComboBoxItem Content="每次启动后 PML REHASH ALL"/><ComboBoxItem Content="不执行特殊动作"/></ComboBox>
                          <TextBlock Text="PML 初始化后、Host 建立前执行；特殊启动有独立日志。" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </Expander>
                    <DockPanel Margin="0,5,0,0">
                      <WrapPanel DockPanel.Dock="Right">
                        <Button Content="保存配置" Click="SaveProfile" FontSize="13" />
                        <Button x:Name="LaunchButton" Content="▶ 保存并启动工程" Style="{StaticResource Primary}" Click="Launch" FontSize="13" Margin="0" />
                      </WrapPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                        <TextBlock Text="本机" Foreground="{DynamicResource Text.Brand}" FontSize="12" />
                      </Border>
                      <TextBlock Text="启动前检查" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="入口、初始化文件、工作目录和注册目录" Style="{StaticResource Caption}" Margin="0,8,0,20" />
                    <TextBlock x:Name="LaunchHealthText" Text="选择已注册的 PMLLIB 后扫描文件量与目录体积。启动入口由已有服务验证。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="13" />
                    <Border Background="{DynamicResource Surface.TintWarning}" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                      <TextBlock Text="启动入口创建成功与登录完成分别确认；Host 身份在会话就绪后核验。" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" />
                    </Border>
                    <TextBlock Text="目录提醒预算可调整；它不是 AVEVA 的固定上限。" Style="{StaticResource Caption}" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <Expander Header="高级诊断：启动参数与产品发现" IsExpanded="False" Margin="0,0,0,16">
              <Grid x:Name="LaunchLowerColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="启动参数预览" Style="{StaticResource SectionTitle}" />
                    <Button Content="预览参数" Click="PreviewLaunch" HorizontalAlignment="Left"/>
                    <TextBlock Text="由现有 LaunchService 生成 · 原生参数列表" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                    <TextBox x:Name="LaunchPreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="138" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" BorderBrush="{DynamicResource Surface.Code}" FontFamily="Consolas" FontSize="13" />
                    <WrapPanel>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="原生启动" Foreground="{DynamicResource Text.Brand}" FontSize="12" />
                      </Border>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="不修改系统 EVAR" Foreground="{DynamicResource Text.Brand}" FontSize="12" />
                      </Border>
                      <Border Style="{StaticResource Pill}">
                        <TextBlock Text="配置不含密码正文" Foreground="{DynamicResource Text.Brand}" FontSize="12" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="重新发现" Click="Discover" Style="{StaticResource Link}" FontSize="13" />
                      <TextBlock Text="本机产品入口" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="注册表与 EVAR 候选" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <ListBox x:Name="ApplicationsBox" Height="138" DisplayMemberPath="Path" BorderThickness="0" FontSize="13" />
                    <Button Content="使用所选入口    →" Click="UseApplication" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="插件部署">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="部署流程" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="来源、复制与重加载的结果分别记录" Style="{StaticResource Caption}" />
                  <UniformGrid Columns="4" Margin="0,16,0,0">
                    <TextBlock Text="① 选择源目录" Foreground="{DynamicResource Text.Brand}" />
                    <TextBlock Text="② 预览复制差异" Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="③ 复制与备份" Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="④ 重加载与验证" Foreground="{DynamicResource Text.Tertiary}" />
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Grid x:Name="DeploymentColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
