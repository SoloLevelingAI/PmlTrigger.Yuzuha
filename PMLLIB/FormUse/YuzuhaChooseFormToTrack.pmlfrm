-- Author:          HuangYuanTai
-- Created:         12/09/2026 08:55:16
--
--
-- Description:
-- Lists shown forms and enables callback recording for selected forms.
-- Refresh and gadget enumeration passed the 2026-09-19 live E3D test.
-- Existing hide override is empty; RESET uses KILL/SHOW. See validation report.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call  Return  Description
--  ===========  ======  ===========
-- Q METHOD !!lstClaim.members
-- !picked  = !listGadget.pickedField
-- pml reload form !!YuzuhaChooseFormToTrack
-- show  !!YuzuhaChooseFormToTrack
--  !!YuzuhaChooseFormToTrack.members.SELECTION().HIGHLIGHT()
------------------------------------------------------------------------
setup form !!YuzuhaChooseFormToTrack
  title |YuzuhaChooseFormToTrack|
  list   .members    at x0 ymax anchor all multiple width 55 length 15
  button .btnRefresh 'Refresh' at x0 ymax+.25 anchor b+r callback '!this.UpdateForms()' width 8
  button .hideButton 'Cancel' at xmax.members - 9  anchor b+r callback '!this.hide()' width 8 cancel

  member .listForm is Array
  member .ShownForm is Array
  member .selectForm is Array
exit

define method .YuzuhaChooseFormToTrack()
  !this.UpdateListByShownForms()
  !menu = !this.newMenu('puTable', 'POPUP')
  !menu.add('CALLBACK', 'Activate Form', '!this.Activate()', 'Activate')
  !menu.add('CALLBACK', 'DeActivate All', '!this.DeActivate()', 'DeActivate')
  !this.members.Popup = !this.puTable
  !this.puTable.setFieldProperty('Activate', 'ACTIVE', true)
  !this.puTable.setFieldProperty('DeActivate', 'ACTIVE', true)
  -- !this.members.showPopup(0, 1)
endmethod

define method .UpdateListByShownForms()
  !this.ShownForm = !!FMSYS.SHOWNFORMS()
  !list = !this.ShownForm
  !this.listForm = array()
  do !n indices !list
    !this.listForm[!n] = |$!list[$!n]|
  enddo

  !this.members.dText = !this.listForm
  !this.members.rText = !this.listForm
endmethod

define method .hide()
  -- !this.hide()
endmethod

define method .UpdateForms()
  !this.UpdateListByShownForms()
endmethod

define method .Activate()
  !select = !this.members.selection()
  !this.selectForm.clear()
  !this.selectForm = !select
  !listText = !this.listForm
  -- q var !this.listForm

  do !m indices !this.selectForm
    !this.selectForm[!m] = !this.selectForm[!m].replace('|Selected|', '')
    -- q var !this.selectForm[!m]
    do !n indices !listText
      if !this.selectForm[!m].matchwild('$!listText[$!n]') then
        !listText[!n] = '$!listText[$!n]|Selected|'
      endif
    enddo
  enddo

  do !m indices !this.selectForm
    !this.filterGadGet(!this.selectForm[!m], 'Decorated')
  enddo
  !this.members.dText = !listText
  !this.members.rText = !listText
endmethod

define method .DeActivate()
  !this.UpdateListByShownForms()
  do !m indices !this.ShownForm
    !this.filterGadGet('$!this.ShownForm[$!m]', 'RESET')
  enddo
  !this.selectForm.clear()
endmethod

define method .filterGadGet(!formName is string,!mode is string)
  !excute = false
  !form         = !!$!formName
  handle any
    $p unsucesss Find !FORM
    return
  endhandle
  !thisName = |$!this|
  if !formName.matchwild('PMLFORMS') or !formName.matchwild('*GPH3DDESIGN*') or !formName.matchwild(!thisName)   then
    return
  endif
  if !mode.upcase() eq 'RESET' then
    KILL !!$!formName
    SHOW !!$!formName
    handle any
    endhandle
    return
  elseif !mode.upcase() eq 'DECORATED' then
    !excute = true
  endif
  !gadGetArray = !!YuzuhaGetGadget(!form,||)
  -- q var !gadGetArray
  !callbackArr = array()
  do !n indices !gadGetArray
    !att = !gadGetArray[!n]
    !cmdStr = '!!$!<form>.$!<att>.callback'
    -- q var !cmdStr
    !callback = $!cmdStr
    handle any
      skip
    endhandle
    if !callback.length() neq 0 then
      if !excute then
        -- $p 222
        !gadget = '!!$!<form>.$!<att>'
        -- q var !gadget
        !!YuzuhaDecoratedCall( $!gadget)
      endif
      !callbackArr.append(!callback)
    endif
  enddo
endmethod
