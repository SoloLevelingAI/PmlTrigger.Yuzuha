<Window x:Class="LaunchDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LaunchDesk.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="LaunchDesk · 应用工作空间" Icon="/LaunchDesk.Desktop;component/Resources/LaunchDesk.ico" Width="1440" Height="1000" MinWidth="1120" MinHeight="740" WindowStyle="None" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SizeChanged="OnDesignSizeChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource Link}"><Setter Property="Foreground" Value="#6D7890"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
  <Style x:Key="NavSection" TargetType="ListBoxItem"><Setter Property="IsEnabled" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="#8D9AB0"/><Setter Property="FontSize" Value="10"/><Setter Property="Height" Value="{DynamicResource Design.GroupHeight}"/><Setter Property="Margin" Value="{DynamicResource Design.GroupGap}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="14,0,0,0" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="PresentationRoot"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Background="White"><StackPanel Orientation="Horizontal" Margin="16,0"><Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="LaunchDesk · 应用工作空间" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Style="{StaticResource ChromeButton}" Click="OnMinimize"/><Button Content="□" Style="{StaticResource ChromeButton}" Click="OnMaximize"/><Button Content="×" Style="{StaticResource ChromeButton}" Click="OnClose"/></StackPanel></Grid>
  <Grid Grid.Row="1" x:Name="LayoutRoot"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="12,30,12,18"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="156"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="12,0"><Border Width="36" Height="36" Background="{StaticResource Accent}" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="L" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="LaunchDesk" FontSize="16" FontWeight="Bold"/><TextBlock Text="启动 · 许可 · 更新" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <ListBox Grid.Row="1" x:Name="SidebarNavigation" SelectionChanged="OnNavigationChanged" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBoxItem Content="工作空间" Style="{StaticResource NavSection}" Margin="0"/>
     <ListBoxItem Content="工作台" Tag="Dashboard" local:IconAssist.Kind="Dashboard"/><ListBoxItem Content="登录配置" Tag="Profiles" local:IconAssist.Kind="Folder"/><ListBoxItem Content="许可监测" Tag="Licenses" local:IconAssist.Kind="Server"/>
     <ListBoxItem Content="维护" Style="{StaticResource NavSection}"/><ListBoxItem Content="工具与扩展" Tag="Tools" local:IconAssist.Kind="Package"/><ListBoxItem Content="更新记录" Tag="History" local:IconAssist.Kind="History"/>
     <ListBoxItem Content="配置" Style="{StaticResource NavSection}"/><ListBoxItem Content="应用与版本" Tag="Applications" local:IconAssist.Kind="Application"/><ListBoxItem Content="导入与分享" Tag="Sharing" local:IconAssist.Kind="Import"/>
    </ListBox>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="18"/><RowDefinition Height="40"/><RowDefinition Height="20"/></Grid.RowDefinitions><Border Background="{StaticResource Canvas}" CornerRadius="9" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="{Binding Workspace.MachineName,StringFormat=本机  {0}}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="独立许可 · 本地配置" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/><Button Content="查看数据目录 →" Style="{StaticResource Link}" FontSize="10" HorizontalAlignment="Left" MinHeight="16" Padding="0" Margin="0,3,0,0" Command="{Binding Settings.OpenDirectoryCommand}"/></StackPanel></Border><Button Grid.Row="2" Content="设置与迁移" local:IconAssist.Kind="Settings" Style="{StaticResource Link}" Foreground="{StaticResource Muted}" HorizontalContentAlignment="Left" Padding="14,6" Command="{Binding GoSettingsCommand}"/></Grid>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="{Binding Layout.ContentMargin}"><Grid.RowDefinitions><RowDefinition Height="{Binding Layout.HeaderHeight}"/><RowDefinition/><RowDefinition Height="{Binding Layout.FooterHeight}"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,4,0,0"><TextBlock x:Name="PageTitle" Text="{Binding Title}" FontSize="28" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Dashboard"><Setter Property="Text" Value="每个版本，都有自己的入口"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,10,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,6,0,0" VerticalAlignment="Top"><Button x:Name="HeaderRefreshButton" Content="{Binding SecondaryText}" local:IconAssist.Kind="{Binding SecondaryIcon}" Command="{Binding SecondaryCommand}" Width="138" Margin="12,0,0,0"/><Button x:Name="HeaderPrimaryButton" Content="{Binding HeaderAction}" local:IconAssist.Kind="{Binding HeaderIcon}" Command="{Binding HeaderCommand}" Width="164" Margin="12,0,0,0" Style="{StaticResource Primary}"/></StackPanel></Grid>
    <ContentControl Grid.Row="1" x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Grid Grid.Row="2" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Workspace.Message}" Foreground="#8D9AB0" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workspace.Message}"/><TextBlock Grid.Column="1" Text="WPF / .NET 10" Foreground="#8D9AB0" FontSize="10" Margin="20,0,64,0"/></Grid>
    <Border x:Name="LaunchStatusPanel" Grid.Row="2" Background="#EEF0FF" CornerRadius="8" Padding="10,3" Margin="0,0,0,18" VerticalAlignment="Bottom" Visibility="{Binding HasRun,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><local:AppIcon Kind="Info" Foreground="{Binding LatestRun.Color}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding LatestRun.Status}" Foreground="{Binding LatestRun.Color}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding LatestRun.Detail}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="{Binding Layout.Wide,Converter={StaticResource BoolVisibility}}"/></StackPanel><Button Grid.Column="2" Content="详情" Style="{StaticResource Link}" MinHeight="24" Padding="5,2" Command="{Binding InspectRunCommand}"/></Grid></Border>
   </Grid>
  </Grid>
 <Border Grid.RowSpan="2" Panel.ZIndex="900" Background="#550F172A" Visibility="{Binding IsTaskDetailsOpen,Converter={StaticResource BoolVisibility}}"><Border Width="620" Height="570" Padding="24" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="50"/></Grid.RowDefinitions><Grid><TextBlock Text="操作记录" FontSize="20" FontWeight="SemiBold"/><Button Content="关闭记录" Command="{Binding CloseTaskDetailsCommand}" Style="{StaticResource Link}" HorizontalAlignment="Right" MinHeight="28"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Workspace.Runs}" SelectedItem="{Binding SelectedRun}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ProfileItem}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Margin="0,16,0,12"><TextBlock Text="{Binding SelectedRun.OperationId,StringFormat=操作编号：{0}}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRun.Time,StringFormat=观察时间：{0}}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="刷新原操作" Command="{Binding InspectRunCommand}" Margin="0,0,12,0"/><Button Content="停止观察" Command="{Binding CancelCommand}" ToolTip="停止本次观察或尚未执行的步骤，保留已产生的结果。"/></StackPanel></Grid></Border></Border></Grid>
</Window>


