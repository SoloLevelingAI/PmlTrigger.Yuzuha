--
-- Methods defined:
--
--  Method call          Return  Description
--  ===========          ======  ===========
--  !!YuzuhaGetGadget()  -       -
--  !!YuzuhaGetGadget(!!spiralctr,|'ELBO','BRAN'|)
--  !!YuzuhaGetGadget(!!reorderhierarchy,| 'BUTTON','FRAME' |)
------------------------------------------------------------------------
define function !!YuzuhaGetGadget(!form is FORM,!except is STRING) is ARRAY
  !result = array()
  !attributes = !form.attributes()
  do !i indices !attributes
    !name = !attributes[!i]
    if !form.attribute(!name).objectType() ne 'GADGET' then
      skip
    endif
    !gadget = !form.attribute(!name)
    if !gadget.unset() then
      skip
    endif
    if !except.trim().length() gt 0 then
      if !gadget.type() inset($!except) then
        skip
      endif
    endif
    !result.append(!name)
  enddo
  return !result
endfunction
