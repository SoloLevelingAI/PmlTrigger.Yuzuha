define function !!YuzuhaReadCurrentElement(!size is real,!depth is real,!startStr is string) is array
  !arr = object array()
  !ob = object YuzuhaObjectWalker()
  !OB.InitializeFromCurrentElement()
  -- !ob.MaxArraySize  = 300
  -- !ob.MaxBFSDepth   = 3
  -- !ob.startStr = 'hpos'
  !ob.MaxArraySize  = !size
  !ob.MaxBFSDepth   = !depth
  !ob.startStr = !startStr
  !arr = !ob.Read()
  RETURN !arr
endfunction

