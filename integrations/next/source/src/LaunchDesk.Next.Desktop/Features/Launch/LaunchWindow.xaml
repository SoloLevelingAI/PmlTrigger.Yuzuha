<Window x:Class="LaunchDesk.Next.Desktop.Features.Launch.LaunchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LaunchDesk · 启动工作台" Width="1440" Height="1000" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#182238" FontFamily="Microsoft YaHei UI" FontSize="13" Icon="/Assets/LaunchDesk.ico">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Assets/PrototypeVisuals.xaml"/></ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="Accent" Color="#4E5DDB"/>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#6D7890"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,14,0,7"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/></Style>
<Style TargetType="Button"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E8F0"/><Setter Property="Foreground" Value="#182238"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#4E5DDB"/><Setter Property="BorderBrush" Value="#4E5DDB"/><Setter Property="Foreground" Value="White"/></Style>
<Style TargetType="TextBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#E3E8F0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#E3E8F0"/><Setter Property="Background" Value="White"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" BorderBrush="#E3E8F0" BorderThickness="1" Background="White" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF0FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#4E5DDB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="White" BorderBrush="#E3E8F0" BorderThickness="0,0,1,0"><Grid Margin="24,30,24,24"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="11" Background="#4E5DDB" VerticalAlignment="Top"><TextBlock Text="L" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="LaunchDesk" FontSize="16" FontWeight="Bold"/><TextBlock Text="启动 · 记录 · 本机" FontSize="10" Foreground="#6D7890" Margin="0,4,0,0"/></StackPanel></StackPanel>
<StackPanel Grid.Row="1"><TextBlock Text="工作空间" Foreground="#8D9AB0" FontSize="10" Margin="0,0,0,16"/><Button  Background="#EEF0FF" Foreground="#4E5DDB" Click="OnWorkbench" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Dashboard}" Stroke="#4E5DDB" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="启动工作台"/></StackPanel></Button><Button  Click="OnHistory" AutomationProperties.AutomationId="HistoryTab"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.History}" Stroke="#182238" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="快照与记录"/></StackPanel></Button></StackPanel>
<Border Grid.Row="2" Background="#F5F7FB" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="独立本机工作空间" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="配置与记录保存在本机" Foreground="#6D7890" FontSize="10" Margin="0,6,0,0"/><Button Content="打开数据目录 →" Click="OnOpenData" MinHeight="26" Padding="0,5" BorderThickness="0" Background="Transparent" Foreground="#4E5DDB" AutomationProperties.AutomationId="OpenData"/></StackPanel></Border>
</Grid></Border>
<Grid Grid.Column="1" Margin="32,30,32,20"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition/><RowDefinition Height="70"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="启动工作台" FontSize="28" FontWeight="Bold"/><TextBlock Text="发现本机应用，保存登录配置，按配置启动。" Foreground="#6D7890" FontSize="12" Margin="0,8,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="↻  自动查找" Click="OnScan" Margin="0,0,12,0" AutomationProperties.AutomationId="Scan"/><Button Content="＋  新建配置" Style="{StaticResource Primary}" Click="OnNew" AutomationProperties.AutomationId="New"/></StackPanel></Grid>
<Grid Grid.Row="1" x:Name="Workbench"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="本机应用" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="选择候选后预填；人工修改会保留。" Foreground="#6D7890" FontSize="11" Margin="0,8,0,16"/>
<ListBox Grid.Row="2" ItemsSource="{Binding Candidates}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="CandidateList" SelectionChanged="OnCandidate" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="Candidates"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#6D7890" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ExecutablePath}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="3"><TextBlock Text="已保存的登录" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="选中配置，核对后即可启动。" FontSize="11" Foreground="#6D7890" Margin="0,0,0,14"/></StackPanel>
<ListBox Grid.Row="4" ItemsSource="{Binding Configurations}" SelectionChanged="OnProfile" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="Configurations"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Foreground="#6D7890" FontSize="10" Margin="0,7,0,0"><Run Text="{Binding Project}"/><Run Text="  /  "/><Run Text="{Binding Mdb}"/></TextBlock><TextBlock Text="{Binding Version,StringFormat=版本 {0}}" FontSize="10" Foreground="#4E5DDB" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</Grid></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="登录配置" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="预填值均可编辑 · 密码仅用于本次启动" Foreground="#6D7890" FontSize="11" Margin="0,8,0,12"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0" x:Name="EditorFields">
<TextBlock Text="配置名称" Style="{StaticResource Label}"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DisplayName"/>
<TextBlock Text="程序路径" Style="{StaticResource Label}"/><TextBox Text="{Binding ExecutablePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ExecutablePath"/>
<TextBlock Text="工作目录" Style="{StaticResource Label}"/><TextBox Text="{Binding WorkingDirectory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkingDirectory"/>
<TextBlock Text="初始化文件" Style="{StaticResource Label}"/><TextBox Text="{Binding InitializationFile,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InitializationFile"/>
<TextBlock Text="启动协议" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.AutomationId="Protocol"/><UniformGrid Columns="2">
<StackPanel Margin="0,0,12,0"><TextBlock Text="产品" Style="{StaticResource Label}"/><TextBox Text="{Binding Product,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Product"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="项目" Style="{StaticResource Label}"/><TextBox Text="{Binding Project,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Project"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="用户" Style="{StaticResource Label}"/><TextBox Text="{Binding User,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="User"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="MDB" Style="{StaticResource Label}"/><TextBox Text="{Binding Mdb,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Mdb"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="模块" Style="{StaticResource Label}"/><TextBox Text="{Binding Module,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Module"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="许可服务器" Style="{StaticResource Label}"/><TextBox Text="{Binding LicenceServer,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LicenceServer"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="许可端口" Style="{StaticResource Label}"/><TextBox Text="{Binding LicencePort,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LicencePort"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="凭据引用（Stored）" Style="{StaticResource Label}"/><TextBox Text="{Binding CredentialReference,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CredentialReference"/></StackPanel>
</UniformGrid><CheckBox AutomationProperties.AutomationId="CheckLicence" Content="启动前检查许可连接" IsChecked="{Binding CheckLicence}" Margin="0,16,0,0"/><CheckBox Content="使用本机 RMS 服务状态（只读）" IsChecked="{Binding UseLocalRmsService}" Margin="0,12,0,0"/><TextBlock Text="本机 RMS 服务名称" Style="{StaticResource Label}"/><TextBox Text="{Binding LocalRmsServiceName,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="同时检查 RULES 连接" IsChecked="{Binding RequireRules}" Margin="0,12,0,0"/><TextBlock Text="RULES 端口" Style="{StaticResource Label}"/><TextBox Text="{Binding RulesPort,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="密码策略" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PasswordPolicies}" SelectedItem="{Binding PasswordPolicy}" AutomationProperties.AutomationId="PasswordPolicy"/><TextBlock Text="本次密码（Prompt；不保存到配置和记录）" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordInput" MinHeight="40" Padding="10" AutomationProperties.AutomationId="Password"/>
<TextBlock Text="{Binding SourceSummary}" FontSize="10" Foreground="#6D7890" Margin="0,16,0,0"/><TextBlock Text="{Binding Validation}" Foreground="#BF5260" Margin="0,12,0,0" AutomationProperties.AutomationId="Validation"/>
</StackPanel></ScrollViewer><Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="保存配置" Click="OnSave" Margin="0,0,8,0" AutomationProperties.AutomationId="Save"/><Button Grid.Column="1" Content="启动应用  →" Click="OnLaunch" Style="{StaticResource Primary}" Margin="8,0,0,0" AutomationProperties.AutomationId="Launch"/></Grid></Grid></Border>
</Grid>
<Border Grid.Row="1" x:Name="HistoryPanel" Visibility="Collapsed" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="快照与执行记录" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="每次提交保留独立快照；窗口出现不表示项目登录成功。" Foreground="#6D7890" FontSize="12" Margin="0,8,0,20"/></StackPanel><Button Content="刷新记录" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshRecords"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Evidence}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedEvidence}" BorderThickness="0" FontSize="11" AutomationProperties.AutomationId="Records" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBox Grid.Column="2" Text="{Binding SelectedEvidence.Detail,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" AutomationProperties.AutomationId="SnapshotDetail"/></Grid></Grid></Border>
<Border Grid.Row="2" Background="#EEF0FF" CornerRadius="9" Padding="16,10" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="#4E5DDB" FontSize="12" VerticalAlignment="Center" AutomationProperties.AutomationId="Status"/><Button Grid.Column="1" Content="详情 →" Click="OnHistory" MinHeight="28" Padding="8,3" Margin="12,0,0,0"/></Grid></Border>
</Grid></Grid></Window>
