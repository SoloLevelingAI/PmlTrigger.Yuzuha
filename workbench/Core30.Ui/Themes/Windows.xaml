<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:ui="clr-namespace:Core30.Ui">
  <Geometry x:Key="Chrome.Minimize">M1,6 H11</Geometry>
  <Geometry x:Key="Chrome.Maximize">M1,1 H11 V11 H1 Z</Geometry>
  <Geometry x:Key="Chrome.Restore">M1,4 H8 V11 H1 Z M4,4 V1 H11 V8 H8</Geometry>
  <Geometry x:Key="Chrome.Close">M2,2 L10,10 M10,2 L2,10</Geometry>
  <Geometry x:Key="Chrome.ResizeCornerGeometry">M0,0 H24 V7 H8 L7,8 V24 H0 Z</Geometry>

  <Style x:Key="Chrome.Button" TargetType="Button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource color.secondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ui:FeedbackBorder x:Name="HitBox" CornerRadius="{DynamicResource radius.small}"
                               BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"
                               Pressed="{TemplateBinding IsPressed}" TintBrush="{DynamicResource color.text}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ui:FeedbackBorder>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="HitBox" Property="BorderBrush" Value="{DynamicResource color.primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource color.selected}" />
        <Setter Property="Foreground" Value="{DynamicResource color.primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Chrome.CloseButton" TargetType="Button" BasedOn="{StaticResource Chrome.Button}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource color.danger-bg}" />
        <Setter Property="Foreground" Value="{DynamicResource color.danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.danger-border}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Chrome.Icon" TargetType="Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    <Setter Property="StrokeThickness" Value="1.25" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="Chrome.ResizeCorner" TargetType="Path">
    <Setter Property="Data" Value="{StaticResource Chrome.ResizeCornerGeometry}" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
  </Style>

  <Style x:Key="Window.Light" TargetType="{x:Type ui:ChromeWindow}">
    <Setter Property="WindowStyle" Value="None" />
    <Setter Property="Background" Value="{DynamicResource color.surface}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-family.ui}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size.body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="shell:WindowChrome.WindowChrome">
      <Setter.Value>
        <shell:WindowChrome GlassFrameThickness="0" ResizeBorderThickness="5" CaptionHeight="38"
                            CornerRadius="{DynamicResource radius.window-region}" UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:ChromeWindow}">
          <!-- WindowChrome manages the margin of the template root. -->
          <Grid>
            <ui:ChromeFrameBorder x:Name="Frame" Margin="{TemplateBinding FrameInset}" Background="{TemplateBinding Background}"
                                  BorderBrush="{DynamicResource color.border-strong}" BorderThickness="1"
                                  CornerRadius="{DynamicResource radius.card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="42" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource color.subtle}" BorderBrush="{DynamicResource color.border}"
                        BorderThickness="0,0,0,1">
                  <Grid Margin="16,0,7,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptionTitle" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                               Foreground="{DynamicResource color.secondary}" FontSize="{DynamicResource font-size.label}"
                               FontWeight="{DynamicResource font-weight.strong}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="CaptionMinimize" Style="{StaticResource Chrome.Button}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                              AutomationProperties.Name="最小化" AutomationProperties.AutomationId="CaptionMinimize" ToolTip="最小化">
                        <Path Style="{StaticResource Chrome.Icon}" Data="{StaticResource Chrome.Minimize}" />
                      </Button>
                      <Button x:Name="CaptionMaximize" Style="{StaticResource Chrome.Button}" Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                              AutomationProperties.Name="最大化" AutomationProperties.AutomationId="CaptionMaximize" ToolTip="最大化">
                        <Path x:Name="MaximizeIcon" Style="{StaticResource Chrome.Icon}" Data="{StaticResource Chrome.Maximize}" />
                      </Button>
                      <Button x:Name="CaptionClose" Style="{StaticResource Chrome.CloseButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                              AutomationProperties.Name="关闭" AutomationProperties.AutomationId="CaptionClose" ToolTip="关闭">
                        <Path Style="{StaticResource Chrome.Icon}" Data="{StaticResource Chrome.Close}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <AdornerDecorator Grid.Row="1">
                  <ContentPresenter ContentSource="Content" />
                </AdornerDecorator>
              </Grid>
            </ui:ChromeFrameBorder>
            <!-- Extend the diagonal hit targets along the visible part of the rounded corners. -->
            <Grid x:Name="CornerGrips">
              <Path Style="{StaticResource Chrome.ResizeCorner}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    shell:WindowChrome.ResizeGripDirection="TopLeft" />
              <Path Style="{StaticResource Chrome.ResizeCorner}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    shell:WindowChrome.ResizeGripDirection="TopRight">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
              </Path>
              <Path Style="{StaticResource Chrome.ResizeCorner}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    shell:WindowChrome.ResizeGripDirection="BottomLeft">
                <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
              </Path>
              <Path Style="{StaticResource Chrome.ResizeCorner}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    shell:WindowChrome.ResizeGripDirection="BottomRight">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
              </Path>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
              <Setter TargetName="CaptionTitle" Property="Foreground" Value="{DynamicResource color.text}" />
            </Trigger>
            <Trigger Property="ResizeMode" Value="CanMinimize">
              <Setter TargetName="CaptionMaximize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CornerGrips" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ResizeMode" Value="NoResize">
              <Setter TargetName="CaptionMinimize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CaptionMaximize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CornerGrips" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="Frame" Property="CornerRadius" Value="0" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
              <Setter TargetName="CornerGrips" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CaptionMaximize" Property="AutomationProperties.Name" Value="还原" />
              <Setter TargetName="CaptionMaximize" Property="ToolTip" Value="还原" />
              <Setter TargetName="CaptionMaximize" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
              <Setter TargetName="MaximizeIcon" Property="Data" Value="{StaticResource Chrome.Restore}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ui:ChromeWindow}" BasedOn="{StaticResource Window.Light}" />
  <Style x:Key="Window.Workbench" TargetType="{x:Type ui:ChromeWindow}" BasedOn="{StaticResource Window.Light}">
    <Setter Property="ResizeMode" Value="CanResize" />
  </Style>
  <Style x:Key="Window.Dialog" TargetType="{x:Type ui:ChromeWindow}" BasedOn="{StaticResource Window.Light}">
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="SizeToContent" Value="Height" />
    <Setter Property="shell:WindowChrome.WindowChrome">
      <Setter.Value>
        <shell:WindowChrome GlassFrameThickness="0" ResizeBorderThickness="0" CaptionHeight="43"
                            CornerRadius="{DynamicResource radius.window-region}" UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Dialog.Footer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource color.subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{DynamicResource inset.compact-card}" />
  </Style>
  <Style x:Key="Dialog.Summary" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource color.subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
  </Style>
</ResourceDictionary>
