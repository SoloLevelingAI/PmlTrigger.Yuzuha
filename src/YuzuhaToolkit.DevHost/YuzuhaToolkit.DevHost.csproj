<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Reference managed backend APIs without inheriting their Native AOT executable deployment. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../YuzuhaToolkit.Mcp/YuzuhaToolkit.Mcp.csproj" />
    <ProjectReference Include="../YuzuhaToolkit.Knowledge/YuzuhaToolkit.Knowledge.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Keep the OpenAPI 2.x dependency above the GHSA-v5pm-xwqc-g5wc patched floor. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>
  <!-- Both servers link BuiltinGuideCatalog.cs. OpenAPI 10 keys imported XML by
       documentation ID, so importing both copies throws at runtime. Keep the
       Knowledge copy (also documents QueryVariant); MCP XML remains available
       to DocFX and the compiler, but none of its DTOs are HTTP contracts. -->
  <Target Name="AvoidDuplicateLinkedOpenApiComments" AfterTargets="GenerateAdditionalXmlFilesForOpenApi">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)" Condition="'%(AdditionalFiles.Filename)' == 'YuzuhaToolkit.Mcp' And '%(AdditionalFiles.Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
</Project>
