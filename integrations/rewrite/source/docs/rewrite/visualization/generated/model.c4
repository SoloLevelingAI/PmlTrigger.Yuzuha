  dynamic view flow_quickLogin {
    title "04 场景 / 快速登录与唯一执行"
    description "从冻结请求到执行准入、许可证据复查和进程观察。窗口出现只形成观察事实，登录仍需独立证据。 各步为设计说明，不是运行跟踪。"
    app.workspace.desktop.ProfilesPageViewModel -> app.execution.coordinator.OperationCoordinator "提交冻结请求"
    app.execution.coordinator.OperationCoordinator -> app.foundation.contracts.IRunJournal "持久受理与查重"
    app.execution.coordinator.OperationCoordinator -> app.foundation.contracts.IRunJournal "取得唯一执行权"
    app.execution.coordinator.OperationCoordinator -> app.execution.launch_handler.LaunchOperationHandler "在工厂作用域中执行"
    app.execution.launch_handler.LaunchOperationHandler -> app.execution.launch_handler.LaunchPlanBuilder "生成冻结启动计划"
    app.execution.launch_handler.LaunchOperationHandler -> app.resources.supervisor.ResourceSupervisor "按完整身份复查许可"
    app.execution.launch_handler.LaunchOperationHandler -> app.foundation.contracts.IProcessGateway "创建独立子进程环境"
    app.execution.launch_handler.LaunchOperationHandler -> app.foundation.contracts.IProcessGateway "观察入口与模块交接"
    app.execution.coordinator.OperationProjectionService -> app.foundation.contracts.IRunJournal "跨页面读取脱敏事实"
    style * { size xs }
    autoLayout LeftRight
  }
  dynamic view flow_licenseRecovery {
    title "04 场景 / 许可短暂掉线与恢复"
    description "分别处理虚拟机存活、端口可达和许可签出证据；复查阈值由策略配置，当前尚待审阅。 各步为设计说明，不是运行跟踪。"
    app.workspace.desktop.LicensePageViewModel -> app.resources.supervisor.ResourceSupervisor "请求一次资源刷新"
    app.resources.supervisor.ResourceSupervisor -> app.foundation.platform.WindowsResourceProbe "采集分项观测"
    app.resources.supervisor.ResourceSupervisor -> app.foundation.kernel.ConnectionHealthPolicy "归约同身份探测轮次"
    app.workspace.desktop.LicensePageViewModel -> app.resources.supervisor.ResourceSupervisor "订阅健康状态变化"
    app.execution.launch_handler.LaunchOperationHandler -> app.resources.supervisor.ResourceSupervisor "启动前再次核验时效"
    style * { size xs }
    autoLayout LeftRight
  }
  dynamic view flow_deliveryRecovery {
    title "04 场景 / 部署保护与中断恢复"
    description "保护配置、日志、备份和暂存范围。执行与恢复都需绑定预览计划，中断后先核验回执。 各步为设计说明，不是运行跟踪。"
    app.delivery.delivery_handler.DeploymentPlanner -> app.foundation.contracts.IControlDataGuard "预览时排除控制资料"
    app.execution.coordinator.OperationCoordinator -> app.foundation.contracts.IRunJournal "明确执行后唯一准入"
    app.foundation.platform.CanonicalTargetLeaseProvider -> app.foundation.contracts.IControlDataGuard "持有保护与目标租约"
    app.foundation.platform.FileDeliveryPort -> app.foundation.contracts.IControlDataGuard "首项写入前再次核验"
    app.delivery.delivery_handler.DeliveryOperationHandler -> app.foundation.platform.FileDeliveryPort "写前意图、变更与回执"
    app.delivery.delivery_handler.DeliveryOperationHandler -> app.foundation.platform.FileDeliveryPort "重启后读取原操作回执"
    app.workspace.desktop.ToolPageViewModel -> app.delivery.delivery_handler.DeploymentPlanner "由工具页面重新预览恢复"
    style * { size xs }
    autoLayout LeftRight
  }
