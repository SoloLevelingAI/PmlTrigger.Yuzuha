--   Module:        design
--   Replaces:
--
-- Author:          HuangYuanTai
-- Created:         25/08/2026 21:34:58
--
--
-- Description:
-- Breadth-first object graph walker. Traverses CE, DBREF, PML Object or
-- Array attributes up to a size/depth budget and returns a flattened
-- result array. Backs the YuzuhaRead* functions.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  YuzuhaObjectWalker()                                                  -               Constructor. Sets the default size and depth budgets.
--  InitializeFromArray(ARRAY)                                            -               Sets the starting array of objects to traverse.
--  InitializeFromCurrentElement()                                        -               Initialises the walker from the current element (CE).
--  InitializeFromGlobal(STRING)                                          -               Initialises the walker from a global variable (no !! prefix).
--  Read()                                                                ARRAY           Main entry point. Runs the BFS traversal with clamped budgets.
--  InitializeResult()                                                    -               Prepares result/layer arrays and resolves the starting attribute.
--  Traverse()                                                            -               BFS loop walking attribute layers until the size budget is exhausted.
--  CollectChildren(STRING,STRING,REAL)                                   -               Builds the next layer attribute list from the current node.
--  ResolveAttribute(STRING,REAL,BOOLEAN)                                 STRING          Returns the printable value or the attribute path (isReturnAtt).
--  IsSuccess(STRING)                                                     BOOLEAN         Returns false when attribute resolution failed.
--
define object YuzuhaObjectWalker
-- pml reload object YuzuhaObjectWalker
-- !ob.delete()
-- !ob = object YuzuhaObjectWalker()
-- !ob.Read()
  member .MaxArraySize    is real
  member .MaxBFSDepth     is real
  member .InitArray       is array
  member .ResArray        is array 
  member .memberList      is array
  member .startStr        is string
  member .startModify     is boolean
  member .startNum        is real
  member .CurrentLayerArr is array
endobject



------------------------------------------------------------------------
--
-- Method:      YuzuhaObjectWalker
--
-- Description: Constructor. Sets the default size and depth budgets.
--
--
------------------------------------------------------------------------
define method .YuzuhaObjectWalker()
  !this.MaxArraySize  = 500
  !this.MaxBFSDepth   = 3
  !this.startStr      = ''
  !this.startModify   = false
endmethod


------------------------------------------------------------------------
--
-- Method:      InitializeFromArray
--
-- Description: Sets the starting array of objects to traverse.
--
--
------------------------------------------------------------------------
define method .InitializeFromArray(!arr is Array) 
  !this.InitArray = !arr
endmethod


------------------------------------------------------------------------
--
-- Method:      InitializeFromCurrentElement
--
-- Description: Initialises the walker from the current element (CE).
--
--
------------------------------------------------------------------------
define method .InitializeFromCurrentElement()
  !arr = object array()
  !arr.append(ce)
  !this.InitArray = !arr
endmethod


------------------------------------------------------------------------
--
-- Method:      InitializeFromGlobal
--
-- Description: Initialises the walker from a global variable (name given
--              without the !! prefix).
--
--
------------------------------------------------------------------------
define method .InitializeFromGlobal(!str is string)
  !arr = object array()
  !arr.append(!!$!str)
  !this.InitArray = !arr
endmethod




------------------------------------------------------------------------
--
-- Method:      Read
--
-- Description: Main entry point. Clamps budgets, initialises the result
--              and runs the BFS traversal.
--
--
------------------------------------------------------------------------
define method .Read() is array
-- 主方法
  if !this.MaxArraySize lt 1 then
    !this.MaxArraySize = 1
  endif
  if !this.MaxBFSDepth lt 0 then
    !this.MaxBFSDepth = 0
  endif
  !this.InitializeResult()
  !this.Traverse()
  -- q var !this.ResArray
  return !this.ResArray
endmethod


------------------------------------------------------------------------
--
-- Method:      InitializeResult
--
-- Description: Prepares the result and layer arrays and resolves the
--              starting attribute.
--
--
------------------------------------------------------------------------
define method .InitializeResult()
-- 初始化开始位置
  !this.ResArray            = object array()
  !this.memberList          = object array()
  !this.CurrentLayerArr     = object array()
  !this.startModify         = false
  !startArr = !this.startStr.split('.')
  if !startArr[1].length() eq 0 then
    !this.startNum          = 0
  else
    !objStr                 = !this.ResolveAttribute('',0,false)
    !this.ResArray.Append(!objStr)
    !this.startNum          = !startArr.size() 
    !this.startModify       = true
  endif
  !objStr                   = !this.ResolveAttribute(!this.startStr,!this.startNum,false)
  if !this.IsSuccess(!objStr).not() then
    return
  endif
  -- !objStr                = !this.GetStrFromArray(!this.InitArray,'[$!num]')
  !this.ResArray.Append(!objStr)
  !this.startNum            = !this.startNum + 1
  !str = !this.ResolveAttribute(!this.startStr,!this.startNum,TRUE)
  !AttArr = object array()
  !this.CurrentLayerArr     = object array()
  if !objStr.match('ARRAY') GT 0.5 then
    !objArr = $!str
    do !i from 1 to !objArr.size()
    !this.CurrentLayerArr.append('$!i')
    enddo
  else
    !AttArr.Append(!str + '.attributes()')
    !this.CurrentLayerArr   = $!AttArr[1]
    handle any
      return
    endhandle
  endif
  -- q var !list
  do !i from 1 to !this.CurrentLayerArr.size()
    if !this.startModify then
    !this.CurrentLayerArr[!i] = !this.startStr + '.' + !this.CurrentLayerArr[!i]
    endif 
  enddo
endmethod




------------------------------------------------------------------------
--
-- Method:      Traverse
--
-- Description: BFS loop that walks the attribute layers, appending rows
--              until the size budget is exhausted.
--
--
------------------------------------------------------------------------
define method .Traverse()
-- 主方法
  !times                = 0
  do 
    if !times gt !this.MaxArraySize - 1 then
      break
    endif
    !times              = !times + 1
    !att                = !this.CurrentLayerArr.first()
    handle any
      break
    endhandle
    !objStr             = !this.ResolveAttribute(!att,!this.startNum,false)
    !this               .CollectChildren(!att,!objstr,!this.startNum)
    !this               .ResArray.Append(!objStr)
    !this    .CurrentLayerArr   .removefirst()
    if !this .CurrentLayerArr   .size() eq 0 then
      !this  .CurrentLayerArr   = !this.memberList
      !this  .startNum          = !this.startNum + 1
      !this  .memberList        = object array()
      if !this.CurrentLayerArr.size() eq 0 then
        break
      endif 
    endif
  enddo
endmethod




------------------------------------------------------------------------
--
-- Method:      CollectChildren
--
-- Description: BFS helper that builds the next layer's attribute list from
--              the current node.
--
--
------------------------------------------------------------------------
define method .CollectChildren(!att is string,!objStr is string,!num is real) 
-- BFS获取下一层数组的方法
  if !num  gt !this.MaxBFSDepth - 0.1 then
    !this.memberList.clear()
    return
  endif
  !str    = !this.ResolveAttribute(!att,0,TRUE)
  if !this.IsSuccess(!str).not() then
    return
  endif
  !AttArr = object array()
  !AttArr.Append(!str + '.attributes()')
  !obj    = $!AttArr[1]
  handle any
    if !objStr.match('ARRAY') GT 0.5 then
      !sizeStr = !str + '.size()'
      !ArrSize = $!sizeStr
      do !i from 1 to !ArrSize
        !res   = !att + '.|$!i|' 
        !this.memberList.Append(!res)
      enddo
    endif  
    return
  endhandle
  do !i from 1 to !obj.size()
    !res = !att + '.' + !obj[$!i]
    !this.memberList.Append(!res)
  enddo
endmethod



------------------------------------------------------------------------
--
-- Method:      ResolveAttribute
--
-- Description: Returns the printable value for an attribute path, or the
--              attribute path itself when isReturnAtt is set.
--
--
------------------------------------------------------------------------
define method .ResolveAttribute(!splitStr is string,!num is real,!isReturnAtt is boolean) is string
-- 获取打印的String信息，或者string的节点本身（isReturnAtt选择）
  !splitArr  = !splitStr.split('.')
  !size = !splitArr.size()
  !str = '!this.InitArray[1]'
  if !size neq 0 and !splitArr[1].length() neq 0 then
    do !i from 1 to !size
      !MemberNum = !splitArr[!i].replace('|', '').real()
      handle any
        !str = !str + '.attribute(|$!splitArr[$!i]|)'
        skip
      endhandle
      !str = !str + '[$!MemberNum]'
    enddo
  endif
  -- Q VAR !STR
  !AttArr = object array()
  !AttArr.Append($!str)
  handle any
  -- 判断是否找不到这样的Attribte
    return 'failedToGetValue |$!splitStr| |$!!error.text|'
  endhandle
  if !isReturnAtt then
    return !str
  endif
  var !objStr var !AttArr
  !objStr = !objstr.replace('<ARRAY> [1]', '').replace('<ARRAY> - Unset [1]', '')
  !objStr = '[$!num] ' +  !splitStr + !objStr
  return !objStr
endmethod

------------------------------------------------------------------------
--
-- Method:      IsSuccess
--
-- Description: Returns false when attribute resolution failed.
--
--
------------------------------------------------------------------------
define method .IsSuccess(!str is string) is boolean
-- 判断是否获取失败
  if !str.match('failedToGetValue') GT 0.5 then
    return false
  endif
  return true
endmethod

