--  !!YuzuhaGadgetDecorated()  -       -
-- !!spiralctr.btndelp1 !!YuzuhaGadgetDecorated('!!spiralctr.btndelp1')
------------------------------------------------------------------------
define function !!YuzuhaGadgetDecorated(!index is real,!GADGET is GADGET) is any
  
  $p start YuzuhaGadgetDecorated 
  !record = array()
  !Form = !GADGET.owner()
  !gadgetStr = !GADGET.FullName()
  !time = object datetime()
  !cmd = !!YuzuhaDecoratedCallBack(!index)
  !record.append(' Record for |!!$!Form| ,Click |$!gadgetStr| At Befor $!time cmd <$!cmd>')
  !type = !!YuzuhaGetGadgetType(!GADGET)
  !recordId = !!YuzuhaRpcHost.BeginLog(!record)
  !gadgetArr = !!YuzuhaGetGadget(!FORM,| 'BUTTON','FRAME','LINE' |)
  do !n indices !gadgetArr
    !gadgetStr = |!!<$!Form>.$!gadgetArr[$!n]|
    !gadgetStr = !gadgetStr.REPLACE('<','').REPLACE('>','')
    -- q var !gadgetStr
    !type = !!YuzuhaGetGadgetType($!gadgetStr)
    !str = ''
    if !type eq 'CONTAINER' then
      !str = 'Net Container Not Support to Record Now'
    else
      !text = !gadgetStr + '.string()'
      !str = $!text
      handle any
        !str = 'Warning Type To Record'
      endhandle
    endif
    !record.append(' [$!type] $!gadgetStr <$!str>')
    -- $p $!gadgetStr $!type

  enddo
  
  !any = $!cmd
  handle any
    if !cmd.matchwild('*show !!*') then
      $!cmd
    endif
    $p End YuzuhaGadgetDecorated without |return|
    !record.append(' Record for |!!$!Form| ,Click |$!gadgetStr| At Later $!time  cmd <$!cmd>')
    
    !logged = !!YuzuhaRpcHost.EndLog(!record, !recordId)
    return
    
  endhandle

  !record.append(' Record for |!!$!Form| ,Click |$!gadgetStr| At Later $!time  cmd <$!cmd>')
  $p End YuzuhaGadgetDecorated with |$!any|
  
  !logged = !!YuzuhaRpcHost.EndLog(!record, !recordId)
  return !any
endfunction
