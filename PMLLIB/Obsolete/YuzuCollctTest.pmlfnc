define function !!YuzuCollctTest()
  !vol = object volume(ce)
  !ob =  !!collectallwithin('','',!vol.from,!vol.to,'')

  !Block = object block('!ob[!EvalIndex].flnm')
  !obName = !ob.evaluate(!Block)
endfunction
