<UserControl x:Class="YuzuhaToolkit.Desktop.PreparationWorkbenchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prep="clr-namespace:YuzuhaToolkit.Desktop">
  <Grid KeyboardNavigation.TabNavigation="Continue">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Accent.Brand}" BorderThickness="0,3,0,0" Padding="0,12,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{prep:Bi Zh='从安装，走到可核验的工程。', En='From installation to a verifiable project.'}" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="TargetSummary" Text="{prep:Bi Zh='先核对已安装工具包，再明确选择产品环境。', En='Inspect the installed package, then choose a product environment.'}" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="ION / NATIVE WORKSPACE" FontFamily="Consolas" Foreground="{DynamicResource Text.Tertiary}" FontSize="11"/><ComboBox x:Name="PalettePicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PaletteChanged" AutomationProperties.Name="{prep:Bi Zh='准备工作区配色', En='Preparation workspace palette'}" Width="155" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="StepColumn" Width="158"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Padding="6">
        <DockPanel><TextBlock DockPanel.Dock="Bottom" Text="{prep:Bi Zh='步骤用于导航。完成状态只来自实际回执。', En='Steps are navigation. Completion comes only from a real receipt.'}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="8,12,8,6"/>
          <ListBox x:Name="Stages" SelectionChanged="StageChanged" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{prep:Bi Zh='安装到操作的阶段', En='Installation-to-operation stages'}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="StageBorder" Background="{DynamicResource Surface.Card}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Surface.Subtle}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Brand.NavSelected}"/><Setter Property="Foreground" Value="{DynamicResource Brand.NavSelectedText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="StageBorder" Property="BorderBrush" Value="{DynamicResource Text.Brand}"/></Trigger>
              </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Background="{DynamicResource Surface.Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,12,16,0"><TextBlock x:Name="StageTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StageStatus" Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,9"/></StackPanel>
          <TabControl x:Name="Readers" SelectionChanged="ReaderChanged" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{prep:Bi Zh='准备阅读栏目', En='Preparation readers'}">
            <TabItem Header="{prep:Bi Zh='操作摘要', En='Summary'}" Tag="summary" AutomationProperties.Name="{prep:Bi Zh='操作摘要', En='Summary'}"><ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,12,16,12">
              <StackPanel x:Name="PackagePanel"><TextBlock Text="{prep:Bi Zh='工具包根目录', En='Package root'}" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowsePackage" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择工具包根目录', En='Browse for the package root'}"/><TextBox x:Name="PackageBox" TextChanged="DraftChanged" ToolTip="{prep:Bi Zh='安装器交付的应用根，或待核对载荷根', En='Application root delivered by the installer, or the payload root to inspect'}" AutomationProperties.Name="{prep:Bi Zh='工具包根目录', En='Package root'}"/></DockPanel><Button x:Name="ReinspectButton" Content="{prep:Bi Zh='重新核验交接（只读）', En='Re-inspect handoff (read-only)'}" Click="InspectHandoff" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='重新核验交接，只读', En='Re-inspect the handoff, read-only'}"/></StackPanel>
              <StackPanel x:Name="DiscoveryPanel"><TextBlock Text="{prep:Bi Zh='扫描范围', En='Scan scope'}" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择目录', En='Browse folder'}" Click="BrowseScan" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择扫描目录', En='Browse for a scan folder'}"/><TextBox x:Name="ScanBox" ToolTip="{prep:Bi Zh='输入一个产品根或其父目录；扫描有数量和时间预算', En='Enter a product root or its parent. Scanning has file and time budgets.'}" AutomationProperties.Name="{prep:Bi Zh='扫描范围', En='Scan scope'}"/></DockPanel><TextBlock Text="{prep:Bi Zh='只读扫描，不执行厂商BAT；明确选择一个候选后才可预览。', En='Read-only scan. Vendor BAT files are not executed. Choose one candidate before preview.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><ListBox x:Name="Installations" DisplayMemberPath="Label" SelectionChanged="InstallationChanged" MinHeight="90" MaxHeight="170" AutomationProperties.Name="{prep:Bi Zh='发现的产品安装候选', En='Discovered product installation candidates'}"/></StackPanel>
              <StackPanel x:Name="DeploymentPanel">
                <TextBlock Text="{prep:Bi Zh='明确的产品与环境', En='Selected product and environment'}" FontWeight="SemiBold"/><TextBlock x:Name="InstallationSummary" Text="{prep:Bi Zh='尚未选择；先进入“选择环境”。', En='Nothing selected yet. Open Choose environment first.'}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{prep:Bi Zh='部署方式', En='Deployment mode'}" Style="{StaticResource Caption}"/><ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged" SelectedIndex="0" AutomationProperties.Name="{prep:Bi Zh='部署方式', En='Deployment mode'}"><ComboBoxItem Content="{prep:Bi Zh='引用已安装应用（保留Inno所有权）', En='Reference the installed application (Inno keeps ownership)'}" Tag="reference"/><ComboBoxItem Content="{prep:Bi Zh='复制到独立受管运行目录', En='Copy to a separate managed runtime'}" Tag="copy"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Host profile" Style="{StaticResource Caption}"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Label" SelectedValuePath="Profile" SelectionChanged="ProfileChanged" AutomationProperties.Name="{prep:Bi Zh='明确选择Host版本', En='Choose the delivered Host profile'}"/></StackPanel></Grid>
                <StackPanel x:Name="RuntimePanel"><TextBlock Text="{prep:Bi Zh='独立运行根', En='Separate runtime root'}" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowseRuntime" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择独立运行根', En='Browse for the runtime root'}"/><TextBox x:Name="RuntimeBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='独立运行根', En='Separate runtime root'}"/></DockPanel></StackPanel>
                <TextBlock Text="{prep:Bi Zh='实际INIT / BAT文件', En='Actual INIT / BAT file'}" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowseEnvironment" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择INIT或BAT文件', En='Browse for the INIT or BAT file'}"/><TextBox x:Name="EnvironmentBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='实际INIT或BAT文件', En='Actual INIT or BAT file'}"/></DockPanel>
                <CheckBox x:Name="EvarsOnly" Content="{prep:Bi Zh='仅预览EVARS受管行，不复制运行文件', En='Preview managed EVARS rows only; do not copy runtime files'}" Checked="PreviewModeChanged" Unchecked="PreviewModeChanged" Margin="0,4,0,8" AutomationProperties.Name="{prep:Bi Zh='仅预览EVARS受管行', En='Preview managed EVARS rows only'}"/>
              </StackPanel>
              <StackPanel x:Name="OwnershipPanel"><TextBlock Text="{prep:Bi Zh='旧安装器所有权与迁移', En='Legacy installer ownership and migration'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='先核对旧EVARS所有者。移交只更新所有权记录；不会写EVARS。', En='Check the legacy EVARS owner first. Transfer updates the ownership record only and does not write EVARS.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8"/><TextBlock Text="{prep:Bi Zh='旧安装器环境文件', En='Legacy installer environment file'}" Style="{StaticResource Caption}"/><TextBox x:Name="LegacyEnvironmentBox" TextChanged="LegacyDraftChanged" AutomationProperties.Name="{prep:Bi Zh='旧安装器环境文件', En='Legacy installer environment file'}"/><Button Content="{prep:Bi Zh='预览旧所有权移交', En='Preview legacy ownership transfer'}" Click="PreviewOwnership" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='预览旧所有权移交', En='Preview legacy ownership transfer'}"/><Expander Header="{prep:Bi Zh='只读查看其他来源（不激活、不切换数据库）', En='Read other sources (no activation, no database switch)'}" Margin="0,12,0,0"><StackPanel><ComboBox x:Name="MigrationFormatBox" SelectionChanged="MigrationFormatChanged" SelectedIndex="0" AutomationProperties.Name="{prep:Bi Zh='迁移来源格式', En='Migration source format'}"><ComboBoxItem Content="rewrite"/><ComboBoxItem Content="next"/><ComboBoxItem Content="ribbon"/></ComboBox><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选文件', En='Browse file'}" Click="BrowseMigration" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择迁移来源文件', En='Browse for a migration source'}"/><TextBox x:Name="MigrationBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='迁移来源文件', En='Migration source file'}"/></DockPanel><Button Content="{prep:Bi Zh='只读预览迁移来源', En='Preview the migration source (read-only)'}" Click="PreviewMigration" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='只读预览迁移来源', En='Preview the migration source, read-only'}"/></StackPanel></Expander></StackPanel>
              <StackPanel x:Name="PlanPanel"><TextBlock Text="{prep:Bi Zh='本次冻结计划', En='Frozen plan for this action'}" FontWeight="SemiBold"/><TextBlock x:Name="PlanSummary" Text="{prep:Bi Zh='尚未生成冻结计划。', En='No frozen plan yet.'}" TextWrapping="Wrap" Margin="0,7,0,0"/><Expander x:Name="PlanIdentityExpander" Header="{prep:Bi Zh='计划编号与指纹（可复制）', En='Plan id and fingerprint (selectable)'}" Margin="0,8,0,0"><Border Style="{StaticResource MetadataBadge}" HorizontalAlignment="Stretch"><TextBox x:Name="PlanIdentity" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='完整冻结计划编号和SHA256', En='Complete frozen plan id and SHA256'}"/></Border></Expander></StackPanel>
              <StackPanel x:Name="RecoveryPanel"><TextBlock Text="{prep:Bi Zh='按原回执条件恢复', En='Restore only from the original receipt'}" FontWeight="SemiBold"/><TextBlock x:Name="RecoverySummary" Text="{prep:Bi Zh='尚无可恢复回执。', En='No restorable receipt yet.'}" TextWrapping="Wrap" Margin="0,7,0,8"/><Expander x:Name="RecoveryIdentityExpander" Header="{prep:Bi Zh='恢复回执编号与指纹（可复制）', En='Recovery receipt id and fingerprint (selectable)'}" Margin="0,0,0,8"><Border Style="{StaticResource MetadataBadge}" HorizontalAlignment="Stretch"><TextBox x:Name="RecoveryIdentity" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='完整恢复回执编号和SHA256', En='Complete recovery receipt id and SHA256'}"/></Border></Expander><Button x:Name="RestoreButton" Content="{prep:Bi Zh='核对并恢复上次变更…', En='Review and restore the last change…'}" Click="Restore" HorizontalAlignment="Left" IsEnabled="False" AutomationProperties.Name="{prep:Bi Zh='核对并恢复上次变更', En='Review and restore the last change'}"/></StackPanel>
              <StackPanel x:Name="LaunchPanel"><TextBlock Text="{prep:Bi Zh='保存配置与明确启动', En='Save a profile and launch explicitly'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='本阶段只打开已有启动页。准备工作区不调用 launch.plan、launch.execute 或 launch.observe，也不授予启动。启动仍在启动页完成：配置、冻结、明确启动、按原编号观察。', En='This stage only opens the existing launch page. Preparation does not call launch.plan, launch.execute, or launch.observe, and it does not grant launch. Launch still happens on that page: configure, freeze, launch explicitly, then observe by the original id.'}" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="{prep:Bi Zh='前往启动工程 →', En='Go to launch →'}" Click="GoLaunch" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='前往启动工程，不在本页启动', En='Go to launch. This page does not start a process.'}"/></StackPanel>
              <StackPanel x:Name="VerifyPanel"><TextBlock Text="{prep:Bi Zh='严格会话身份与操作目标', En='Strict session identity and operation target'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='本阶段只打开已有会话页。准备工作区不调用 connection.sessions、connection.select、connection.status 或 connection.test，不连接、不授予执行或写入，也不发送 PML。', En='This stage only opens the existing session page. Preparation does not call connection.sessions, connection.select, connection.status, or connection.test. It does not connect, grant execution or writes, or send PML.'}" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="{prep:Bi Zh='前往连接与核验 →', En='Go to connection and verification →'}" Click="GoVerify" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='前往连接与核验，不在本页连接', En='Go to connection and verification. This page does not connect.'}"/></StackPanel>
              <Expander x:Name="RawResultExpander" Header="{prep:Bi Zh='完整操作回执与诊断', En='Complete operation receipt and diagnostics'}" Margin="0,12,0,0"><TextBox x:Name="ResultBody" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{prep:Bi Zh='完整操作回执与诊断', En='Complete operation receipt and diagnostics'}"/></Expander>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='完整契约', En='Contract'}" Tag="contract" AutomationProperties.Name="{prep:Bi Zh='完整契约', En='Contract'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContractFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='解释脚本', En='Script notes'}" Tag="scripts" AutomationProperties.Name="{prep:Bi Zh='解释脚本', En='Script notes'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScriptFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='验收证据', En='Evidence'}" Tag="evidence" AutomationProperties.Name="{prep:Bi Zh='验收证据', En='Evidence'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,12"><TextBlock Text="{prep:Bi Zh='本阶段的验收边界', En='Acceptance boundary for this stage'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceBoundary" TextWrapping="Wrap" Margin="0,10,0,14"/><TextBlock Text="{prep:Bi Zh='本次真实操作回执', En='Receipt from this real operation'}" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceOutcome" Text="{prep:Bi Zh='尚未执行；阅读阶段不是验收通过。', En='Not run. Reading a stage is not acceptance.'}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8"/><Border Style="{StaticResource MetadataBadge}" Margin="0,0,0,10"><TextBox x:Name="EvidenceOperation" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='回执原始操作标识', En='Raw operation id from the receipt'}"/></Border><TextBlock x:Name="EvidenceResult" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="{prep:Bi Zh='打开完整任务契约与验收说明 ↗', En='Open the full task contract and acceptance note ↗'}" Click="OpenContractDocument" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='打开完整任务契约与验收说明', En='Open the full task contract and acceptance note'}"/></StackPanel></ScrollViewer></TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ActionEffect" Text="{prep:Bi Zh='本次只读核对应用载荷与安装记录。', En='This action only reads the payload and installation record.'}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="InlineResult" Text="{prep:Bi Zh='等待你的明确操作。', En='Waiting for an explicit action.'}" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap"/><TextBlock x:Name="InlineOperation" Style="{StaticResource Metadata}" Margin="0,3,0,0"/></StackPanel><Button x:Name="PrimaryAction" Grid.Column="1" Content="{prep:Bi Zh='核对安装交接', En='Inspect installation handoff'}" Click="RunPrimary" Style="{StaticResource Primary}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</UserControl>
