define function !!YuzuhaDecoratedCall( !GADGET is GADGET)
  !Form = !GADGET.owner()
  !TITLE =  !Form.FORMTITLE
  if !TITLE.matchwild(|*Decorated*|) then

  else
    !Form.FORMTITLE = '[Decorated]' +  !TITLE  
  endif
  
  !gadgetStr = !GADGET.FullName()
  -- Q VAR !gadgetStr
  !callback = !GADGET.callback
  !FormName = |!!$!form|
  if !callBack.matchwild(|*Gadget*|) then
    return
  endif
  !NewCall = !callBack.replace(|!this|,|$!FormName|)
  !!YuzuhaDecoratedCallBack.append(!NewCall)
  handle any
  !!YuzuhaDecoratedCallBack = array()
  !!YuzuhaDecoratedCallBack.append(!NewCall)
  endhandle
  !index = !!YuzuhaDecoratedCallBack.MaxIndex()
  !GADGET.callback = '!!YuzuhaGadgetDecorated($!index,$!gadgetStr)'
  -- q var !GADGET.callback 
  -- -- q var  !FormName !NewCall
endfunction
