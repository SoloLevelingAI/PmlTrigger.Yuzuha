<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:core30:tools:v2"
           targetNamespace="urn:core30:tools:v2" elementFormDefault="qualified">
  <xs:simpleType name="toolId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9\-]{0,39}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="tools">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="tool" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="t:toolId" use="required" />
            <xs:attribute name="enabled" type="xs:boolean" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="uniqueTool">
      <xs:selector xpath="t:tool" />
      <xs:field xpath="@id" />
    </xs:unique>
  </xs:element>
</xs:schema>
