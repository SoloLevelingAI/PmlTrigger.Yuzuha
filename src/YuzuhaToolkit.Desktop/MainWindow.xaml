<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YuzuhaToolkit.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YuzuhaToolkit.Desktop.MainWindow" Title="Phayton · 工程工作空间" FontFamily="Segoe UI,Microsoft YaHei UI" FontSize="13" Width="1600" Height="1040" MinWidth="840" MinHeight="480" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown" Foreground="{DynamicResource Text.Primary}">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome><Grid Background="{DynamicResource Surface.Page}" Name="WindowSurface">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition x:Name="ContextColumn" Width="244"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="2" Grid.Row="1">
      <Grid DockPanel.Dock="Top" Margin="28,24,28,20" MinHeight="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel ClipToBounds="True">
          <TextBlock x:Name="PageTitleText" Text="总览" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="PageSubtitleText" Text="本机工作台 · 从明确的工程目标开始" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border x:Name="SearchPanel" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Input}" BorderThickness="1" CornerRadius="10" Width="232" Height="40" Margin="0,0,16,0">
            <DockPanel Margin="12,0">
              <Viewbox Width="16" Margin="0,0,8,0">
                <Path Data="{StaticResource Icon.search}" Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.8"/>
              </Viewbox>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" VerticalAlignment="Center"/>
              <TextBox x:Name="NavigationSearch" ToolTip="搜索页面，按 Enter 前往" KeyDown="SearchKeyDown" BorderThickness="0" Background="Transparent" Padding="0,4" Margin="0" FontSize="12" Tag="搜索页面…"/>
            </DockPanel>
          </Border>
          <Button x:Name="HeaderActionButton" Click="HeaderAction" Style="{StaticResource Primary}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                <Path Data="{StaticResource Icon.play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" x:Name="HeaderActionIcon"/>
              </Viewbox>
              <TextBlock x:Name="HeaderActionText" Text="启动工程"/>
            </StackPanel>
          </Button>
          <Button Width="40" Padding="10" Click="OpenLogs" ToolTip="打开本机工具日志目录" Margin="0,0,10,0">
            <Viewbox Width="17" Height="17">
              <Path Data="{StaticResource Icon.bell}" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
          </Button>
          <Button Content="?" Width="38" Margin="0" Click="ShowHelp" ToolTip="使用说明"/>
        </StackPanel>
      <ComboBox x:Name="CompactNavigation" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Left" Width="205" Margin="0,72,0,0" DisplayMemberPath="Label" SelectionChanged="CompactNavigationChanged" AutomationProperties.Name="当前分组导航"/></Grid>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Page}" Padding="28,0,28,3">
        <DockPanel>
          <TextBlock x:Name="HeartbeatText" DockPanel.Dock="Right" Text="读取本机状态…" Style="{StaticResource Caption}" Margin="16,0,0,0"/>
          <TextBlock x:Name="MessageText" Text="就绪 · 本机记录" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </Border>
      <TabControl x:Name="Tabs" Margin="28,0,28,0" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="PageSelected">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent"/>
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="启动工程">
          <ScrollViewer x:Name="LaunchScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid x:Name="LaunchColumns">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20">
                  <StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="＋ 新建" Click="NewProfile" AutomationProperties.Name="新建启动配置"/><TextBlock Text="我的工程配置" Style="{StaticResource SectionTitle}"/></DockPanel>
                    <TextBlock Text="保存常用入口，选择后在右侧编辑。" Style="{StaticResource Caption}" Margin="0,7,0,16"/>
                    <TextBlock Text="产品" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="LaunchProductFilter" SelectionChanged="LaunchProfileFilterChanged" AutomationProperties.Name="按产品筛选配置"/>
                    <TextBlock Text="范围" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="LaunchScopeFilter" SelectedIndex="0" SelectionChanged="LaunchProfileFilterChanged" AutomationProperties.Name="按收藏或最近筛选配置"><ComboBoxItem Content="全部配置" Tag="all"/><ComboBoxItem Content="已收藏" Tag="favorites"/><ComboBoxItem Content="最近启动" Tag="recent"/></ComboBox>
                    <TextBlock Text="查找配置" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="LaunchProfileSearch" Tag="名称、工程、用户或模块" TextChanged="LaunchProfileFilterChanged" AutomationProperties.Name="查找启动配置"/>
                    <TextBlock x:Name="LaunchProfileCount" Style="{StaticResource Caption}" Margin="0,6,0,8"/>
                    <DataGrid x:Name="LaunchProfilesGrid" Height="290" SelectionChanged="LaunchProfileGridSelected" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="工程配置列表">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="工程配置" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Product}"/><Run Text=" · "/><Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Module}"/></TextBlock><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Project}"/><Run Text=" / "/><Run Text="{Binding User}"/></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LaunchProfilesEmpty" Text="没有匹配的配置。调整筛选条件或新建配置。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,14,0,0"><Button Content="复制" Click="DuplicateLaunchProfile"/><Button x:Name="LaunchFavoriteButton" Content="收藏" Click="FavoriteLaunchProfile"/><Button Content="设为默认" Click="DefaultLaunchProfile"/></WrapPanel>
                    <Button Content="打开完整配置库 →" Click="OpenProfileLibrary" Style="{StaticResource Link}" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                  <StackPanel>
                    <TextBlock Text="编辑并启动工程" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="LaunchDraftState" Text="选择产品后，仅显示对应的启动模块。" Style="{StaticResource Caption}" Margin="0,7,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="配置名称" Style="{StaticResource Caption}"/><TextBox x:Name="NameBox" AutomationProperties.Name="启动配置名称"/>
                    <TextBlock Text="本机安装入口" Style="{StaticResource Caption}"/><ComboBox x:Name="LaunchApplicationBox" DisplayMemberPath="Label" SelectionChanged="LaunchApplicationSelected" AutomationProperties.Name="本机 AVEVA 安装入口"/>
                    <TextBlock x:Name="LaunchApplicationSummary" Text="选择已发现的入口，或在安装路径中填写。无需其他启动器。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="产品" Style="{StaticResource Caption}"/><ComboBox x:Name="ProductBox" IsEditable="True" Text="E3D" SelectionChanged="ProductIdentityChanged" LostFocus="ProductIdentityChanged" AutomationProperties.Name="AVEVA 产品"><ComboBoxItem Content="E3D"/><ComboBoxItem Content="AM"/><ComboBoxItem Content="PDMS"/></ComboBox></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="版本" Style="{StaticResource Caption}"/><TextBox x:Name="VersionBox" TextChanged="ProductIdentityChanged" AutomationProperties.Name="AVEVA 产品版本"/></StackPanel>
                    </Grid>
                    <TextBlock Text="启动模块" Style="{StaticResource Caption}"/><ComboBox x:Name="ModuleBox" IsEditable="True" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ModuleChanged" LostFocus="ModuleChanged" AutomationProperties.Name="产品对应启动模块"/>
                    <TextBlock x:Name="ModuleSourceText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="工程" Style="{StaticResource Caption}"/><TextBox x:Name="ProjectBox" AutomationProperties.Name="工程代码"/><TextBlock Text="MDB" Style="{StaticResource Caption}"/><ComboBox x:Name="MdbBox" IsEditable="True" Text="/ALL" AutomationProperties.Name="工程 MDB"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="用户名" Style="{StaticResource Caption}"/><TextBox x:Name="UserBox" AutomationProperties.Name="工程用户名"/><TextBlock Text="密码（留空沿用已保存凭据）" Style="{StaticResource Caption}"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="工程登录密码"/></StackPanel>
                    </Grid>
                    <CheckBox x:Name="RememberPasswordBox" Content="在本机凭据库记住密码" IsChecked="True" Margin="0,6,0,6"/>
                    <TextBlock x:Name="PasswordStatusText" Text="尚未保存密码" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Expander x:Name="LaunchPathsExpander" Header="安装路径与入口类型" Margin="0,4,0,12"><StackPanel Margin="0,12,0,0">
                      <TextBlock Text="入口类型" Style="{StaticResource Caption}"/><ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="ProductIdentityChanged"><ComboBoxItem Content="Monitor"/><ComboBoxItem Content="MarineBatch"/></ComboBox>
                      <TextBlock Text="程序入口" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseExecutable"/><TextBox x:Name="ExecutableBox" LostFocus="ProductIdentityChanged" AutomationProperties.Name="启动程序路径"/></DockPanel>
                      <TextBlock Text="初始化文件" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseInitialization"/><TextBox x:Name="InitializationBox"/></DockPanel>
                      <TextBlock Text="工作目录" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseWorkingDirectory"/><TextBox x:Name="WorkingBox"/></DockPanel>
                    </StackPanel></Expander>
                    <Expander x:Name="ProfileDetailsExpander" Header="许可与启动动作" Margin="0,4,0,12"><StackPanel Margin="0,12,0,0">
                      <TextBlock Text="许可连接（留空沿用）" Style="{StaticResource Caption}"/><TextBox x:Name="LicenseBox"/>
                      <TextBlock Text="启动动作" Style="{StaticResource Caption}"/><ComboBox x:Name="StartupPolicyBox" SelectedIndex="0"><ComboBoxItem Content="沿用进程环境"/><ComboBoxItem Content="每次启动后 PML REHASH ALL"/><ComboBoxItem Content="不执行特殊动作"/></ComboBox>
                      <TextBlock Text="启动动作只用于新进程，配置保存不会执行 PML。" Style="{StaticResource Caption}"/>
                    </StackPanel></Expander>
                    <WrapPanel Margin="0,6,0,8"><Button x:Name="PreviewProfileButton" Content="预览变更" Click="PreviewProfileChanges" AutomationProperties.Name="预览配置变更"/><Button x:Name="SaveProfileButton" Content="保存配置" Click="SaveProfile" Style="{StaticResource Primary}" AutomationProperties.Name="保存启动配置"/><Button x:Name="ReloadProfileButton" Content="重新读取" Click="ReloadProfileFromDisk" AutomationProperties.Name="重新读取启动配置"/><Button x:Name="LaunchButton" Content="保存并启动" Click="Launch" AutomationProperties.Name="保存并启动工程"/></WrapPanel>
                    <Border x:Name="ReloadConfirmationPanel" Visibility="Collapsed" Background="{DynamicResource Surface.TintWarning}" CornerRadius="10" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="当前草稿尚未保存。重新读取会放弃草稿，并显示磁盘上的最新修订。" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0"><Button x:Name="ConfirmReloadProfileButton" Content="放弃草稿并重新读取" Click="ConfirmReloadProfile"/><Button Content="保留草稿" Click="CancelReloadProfile"/></WrapPanel></StackPanel></Border>
                    <Border Background="{DynamicResource Surface.Subtle}" CornerRadius="10" Padding="12"><TextBlock x:Name="LaunchLifecycleMessage" Text="保存后会生成可回溯的修订。启动与保存分别记录。" TextWrapping="Wrap"/></Border>
                    <Expander x:Name="LaunchChangesExpander" Header="待保存的差异" Margin="0,12,0,0"><TextBox x:Name="LaunchChangesBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="190" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></Expander>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                  <DockPanel><Button DockPanel.Dock="Right" Content="刷新历史" Click="RefreshLaunchHistory"/><TextBlock Text="配置历史与恢复" Style="{StaticResource SectionTitle}"/></DockPanel>
                  <TextBlock x:Name="LaunchRevisionText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                  <DataGrid x:Name="LaunchHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="170" SelectionChanged="LaunchHistorySelected" AutomationProperties.Name="启动配置历史">
                    <DataGrid.Columns><DataGridTextColumn Header="保存时间 UTC" Binding="{Binding SavedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="修订" Binding="{Binding Revision}" Width="150"/></DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="LaunchHistoryEmpty" Text="这套配置尚无历史。首次保存后可在这里查看。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                  <WrapPanel Margin="0,12,0,0"><Button x:Name="PreviewRestoreProfileButton" Content="预览恢复差异" Click="PreviewRestoreProfile" IsEnabled="False"/><Button x:Name="RestoreProfileButton" Content="恢复所选修订…" Click="RestoreProfileRevision" IsEnabled="False"/></WrapPanel>
                  <TextBlock Text="恢复会生成新的修订，保留后续历史；不会启动工程或恢复已删除的密码。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <Border x:Name="RestoreConfirmationPanel" Visibility="Collapsed" Background="{DynamicResource Surface.Subtle}" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="RestoreConfirmationText" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button x:Name="ConfirmRestoreProfileButton" Content="确认恢复并创建新修订" Click="ConfirmRestoreProfile" Style="{StaticResource Primary}"/><Button Content="取消" Click="CancelRestoreProfile"/></WrapPanel></StackPanel></Border>
                </StackPanel>
              </Border>
              <Expander Header="启动参数与产品诊断" Margin="0,0,0,16">
                <Grid x:Name="LaunchLowerColumns"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="启动参数预览" Style="{StaticResource SectionTitle}"/><Button Content="预览参数" Click="PreviewLaunch" HorizontalAlignment="Left"/><TextBox x:Name="LaunchPreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" FontFamily="Consolas"/><TextBlock x:Name="LaunchHealthText" Text="入口进程创建成功不等于登录完成；连接后仍需核验 Host。" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border>
                  <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="重新发现" Click="Discover"/><TextBlock Text="本机产品入口" Style="{StaticResource SectionTitle}"/></DockPanel><ListBox x:Name="ApplicationsBox" Height="100" DisplayMemberPath="Path"/><Button Content="使用所选入口" Click="UseApplication" HorizontalAlignment="Left"/></StackPanel></Border>
                </Grid>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="插件部署">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="部署流程" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="来源、复制与重加载的结果分别记录" Style="{StaticResource Caption}"/>
                  <UniformGrid Columns="4" Margin="0,16,0,0">
                    <TextBlock Text="① 选择源目录" Foreground="{DynamicResource Text.Brand}"/>
                    <TextBlock Text="② 预览复制差异" Foreground="{DynamicResource Text.Tertiary}"/>
                    <TextBlock Text="③ 复制与备份" Foreground="{DynamicResource Text.Tertiary}"/>
                    <TextBlock Text="④ 重加载与验证" Foreground="{DynamicResource Text.Tertiary}"/>
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Grid x:Name="DeploymentColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="预览复制内容" Click="PreviewCopy" FontSize="12"/>
                      <TextBlock Text="复制预览" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <TextBlock Text="开发副本保留在注册 PMLLIB 之外" Style="{StaticResource Caption}"/>
                    <DataGrid x:Name="CopyGrid" Height="190">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="文件 / 相对路径" Binding="{Binding RelativePath}" Width="*"/>
                        <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="90"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Action}" Width="100"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CopySummaryText" Text="尚未预览复制内容" Style="{StaticResource Caption}" Margin="0,14,0,12"/>
                    <Button x:Name="ApplyCopyButton" Content="复制到注册目录" Click="ApplyCopy" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Right"/>
                      <Separator Margin="0,18"/><TextBlock Text="开发链路：复制 → REHASH ALL → 重载 → 验证" Style="{StaticResource SectionTitle}"/>
                      <TextBlock Text="先在工程会话核验目标；清单声明自有类型、验证宏及预期结果。" Style="{StaticResource Caption}"/>
                      <DockPanel Margin="0,10"><Button DockPanel.Dock="Right" Content="选择清单" Click="BrowseDevelopmentManifest"/><TextBox x:Name="DevelopmentManifestBox" TextChanged="DevelopmentManifestChanged"/></DockPanel>
                      <WrapPanel><Button Content="预览开发链路" Click="PreviewDevelopment"/><Button x:Name="RunDevelopmentButton" Content="复制、重载并验证" Click="RunDevelopment" IsEnabled="False" Style="{StaticResource Primary}"/></WrapPanel>
                      <TextBlock x:Name="DevelopmentSummaryText" Text="尚未预览" Style="{StaticResource Caption}" Margin="0,10" TextWrapping="Wrap"/>
                      <DataGrid x:Name="DevelopmentStepsGrid" Height="180"><DataGrid.Columns><DataGridTextColumn Header="步骤" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150"/></DataGrid.Columns></DataGrid>
                      <DataGrid x:Name="DevelopmentResultsGrid" Height="150"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="实际值" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
                      <TextBox x:Name="DevelopmentEvidenceBox" IsReadOnly="True" ToolTip="完整本机证据路径"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="目标检查" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="选择已有注册目录，不修改全局环境" Style="{StaticResource Caption}"/>
                    <DockPanel Margin="0,14,0,0">
                      <Button DockPanel.Dock="Right" Content="…" Click="BrowseRegistered" Width="32" Padding="0" Margin="8,4,0,10"/>
                      <TextBox x:Name="RegisteredBox" TextChanged="DeploymentInputsChanged" FontSize="12"/>
                    </DockPanel>
                    <ComboBox x:Name="RegistrationsBox" DisplayMemberPath="Path" FontSize="12"/>
                    <Button Content="使用所选候选" Click="UseRegistration" FontSize="12" HorizontalAlignment="Right"/>
                    <Expander Header="目录提醒预算" Margin="0,14,0,12">
                      <UniformGrid Columns="2" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,10,0">
                          <TextBlock Text="文件数提醒" Style="{StaticResource Caption}"/>
                          <TextBox x:Name="WarnFilesBox" Text="3000"/>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="体积提醒 MiB" Style="{StaticResource Caption}"/>
                          <TextBox x:Name="WarnSizeBox" Text="200"/>
                        </StackPanel>
                      </UniformGrid>
                    </Expander>
                    <WrapPanel>
                      <Button Content="扫描目录" Click="ScanDirectory" FontSize="12"/>
                      <Button Content="保存设置" Click="SaveWorkspace" FontSize="12"/>
                    </WrapPanel>
                    <TextBlock x:Name="HealthText" Text="尚未扫描" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,16,0,0" FontSize="12"/>
                    <Button Content="打开目录清理  ↗" Click="OpenRegistered" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid x:Name="DeploymentLowerColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="导入与重加载" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Margin="0,12,0,0">
                      <Button DockPanel.Dock="Right" Content="目录" Click="BrowseSourceFolder" FontSize="12" Margin="8,4,0,10"/>
                      <Button DockPanel.Dock="Right" Content="文件 / ZIP" Click="BrowseSourceFile" FontSize="12" Margin="8,4,0,10"/>
                      <TextBox x:Name="SourceBox" TextChanged="DeploymentInputsChanged" FontSize="12"/>
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="插件子目录" VerticalAlignment="Center" Margin="0,0,12,10"/>
                      <TextBox x:Name="PluginBox" Text="MyPlugin" TextChanged="DeploymentInputsChanged" Width="190" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Text="复制时跳过开发产物，覆盖前备份放在 PMLLIB 外。" Style="{StaticResource Caption}" Margin="0,10,0,14"/>
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface.TintWarning}">
                      <TextBlock Text="复制、REHASH、Form/Object 重加载与实测分别确认；本页不自动重加载。" Foreground="{DynamicResource Text.Warning}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="复用已有复制事务、哈希与备份；失败保留原始错误。完整人工批准和恢复操作界面按后续批次交付。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="部署历史" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="当前本机保留的复制完成记录" Style="{StaticResource Caption}"/>
                  <DataGrid x:Name="DeploymentHistoryGrid" Height="145" Margin="0,14,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="时间 +08" Binding="{Binding DisplayTime}" Width="100"/>
