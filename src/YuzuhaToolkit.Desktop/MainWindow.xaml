                    <TextBlock Text="Yuzuha Toolkit" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="PMLTWIN v0.4 · 本机 WPF 工作台" Style="{StaticResource Caption}" Margin="0,8,0,18" />
                    <TextBlock Text="会话、函数、原生查询、启动与复制继续使用已有 C# 能力。" TextWrapping="Wrap" />
                    <Button Content="打开日志目录  ↗" Click="OpenLogs" Margin="0,20,0,0" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid x:Name="SettingsLowerColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="AI 客户端连接" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Q09 · 保留配置区域，客户端自动写入与连接管理尚未接入。" Style="{StaticResource Caption}" Margin="0,10,0,20" />
                    <DataGrid Height="150">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="客户端" Width="*" />
                        <DataGridTextColumn Header="类型" Width="100" />
                        <DataGridTextColumn Header="状态" Width="120" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="显示与主题" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="明亮 / 黑暗" Style="{StaticResource Caption}" Margin="0,10,0,14" />
                    <WrapPanel>
                      <Button Content="☀ 明亮" Tag="Light" Click="ChooseTheme" />
                      <Button Content="☾ 黑暗" Tag="Dark" Click="ChooseTheme" />
                    </WrapPanel>
                    <TextBlock Text="只保存显示偏好；输入、目标与调用许可继续保留。" Style="{StaticResource Caption}" Margin="0,18,0,20" />
                    <TextBlock Text="安全与权限" FontWeight="SemiBold" />
                    <TextBlock Text="函数许可、人工信任与 Web 应用授权分别管理。" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="工具日志">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="Q10 · 检索筛选与导出待接入" Foreground="{DynamicResource Text.Warning}" VerticalAlignment="Center" FontSize="10" />
                  <TextBox Tag="搜索工具、关联编号或 PID" IsEnabled="False" Width="300" HorizontalAlignment="Left" Margin="0" />
                </DockPanel>
              </Border>
              <Grid x:Name="LogColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="调用日志" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="最近 200 条 · 本机滚动范围 · 不作为 24h 全量" Style="{StaticResource Caption}" />
                    <DataGrid x:Name="ActivityGrid" Height="510" Margin="0,14,0,0" SelectionChanged="ActivitySelected">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="时间 +08" Binding="{Binding DisplayTime}" Width="70" />
                        <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="PID" Binding="{Binding TargetPid}" Width="65" />
                        <DataGridTextColumn Header="事件" Binding="{Binding PhaseLabel}" Width="100" />
                        <DataGridTextColumn Header="耗时 ms" Binding="{Binding Milliseconds}" Width="65" />
                        <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" MinWidth="110" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button Content="复制回执" Click="CopyActivity" DockPanel.Dock="Right" FontSize="10" />
                      <TextBlock Text="调用详情" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="ActivityIdentityText" Text="选择一条调用记录" Style="{StaticResource Caption}" Margin="0,12,0,18" />
                    <TextBlock Text="请求参数" FontWeight="SemiBold" FontSize="11" />
                    <TextBox x:Name="ActivityRequestText" IsReadOnly="True" TextWrapping="Wrap" Height="152" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" FontFamily="Consolas" FontSize="10" Margin="0,10,0,16" />
                    <TextBlock Text="结果 / 原始错误" FontWeight="SemiBold" FontSize="11" />
                    <TextBox x:Name="ActivityDetails" IsReadOnly="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" FontFamily="Consolas" FontSize="10" Margin="0,10,0,16" />
                    <TextBlock Text="命名秘密字段已脱敏；正文仍可能包含工程信息。输出默认留本机。" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="打开日志目录  ↗" Click="OpenLogs" />
                  <StackPanel>
                    <TextBlock Text="日志文件与保留范围" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="复用现有 RuntimeJournal；各进程有界滚动保留，历史缺失不补算为成功。" Style="{StaticResource Caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
