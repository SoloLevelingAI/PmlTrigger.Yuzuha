                <StackPanel>
                  <TextBlock Text="已保存的登录密码" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="选择要清除密码的配置；清除前会再次确认，配置本身保留。" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                  <ComboBox x:Name="CredentialProfilesBox" DisplayMemberPath="Name"/>
                  <Button Content="清除此配置的已存密码…" Click="ClearSavedPassword" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="工具日志">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="检索筛选与导出待接入" Foreground="{DynamicResource Text.Warning}" VerticalAlignment="Center" FontSize="11" />
                  <TextBox Tag="搜索工具、关联编号或 PID" IsEnabled="False" Width="300" HorizontalAlignment="Left" Margin="0" />
                </DockPanel>
              </Border>
              <Grid x:Name="LogColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="调用日志" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="最近 200 条 · 本机滚动范围 · 不作为 24h 全量" Style="{StaticResource Caption}" />
                    <DataGrid x:Name="ActivityGrid" Height="510" Margin="0,14,0,0" SelectionChanged="ActivitySelected">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="时间 +08" Binding="{Binding DisplayTime}" Width="70" />
                        <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="PID" Binding="{Binding TargetPid}" Width="65" />
                        <DataGridTextColumn Header="事件" Binding="{Binding PhaseLabel}" Width="100" />
                        <DataGridTextColumn Header="耗时 ms" Binding="{Binding Milliseconds}" Width="65" />
                        <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" MinWidth="110" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button Content="复制回执" Click="CopyActivity" DockPanel.Dock="Right" FontSize="11" />
                      <TextBlock Text="调用详情" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="ActivityIdentityText" Text="选择一条调用记录" Style="{StaticResource Caption}" Margin="0,12,0,18" />
                    <TextBlock Text="请求参数" FontWeight="SemiBold" FontSize="12" />
                    <TextBox x:Name="ActivityRequestText" IsReadOnly="True" TextWrapping="Wrap" Height="152" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" FontFamily="Consolas" FontSize="11" Margin="0,10,0,16" />
                    <TextBlock Text="结果 / 原始错误" FontWeight="SemiBold" FontSize="12" />
                    <TextBox x:Name="ActivityDetails" IsReadOnly="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" FontFamily="Consolas" FontSize="11" Margin="0,10,0,16" />
                    <TextBlock Text="命名秘密字段已脱敏；正文仍可能包含工程信息。输出默认留本机。" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="打开日志目录  ↗" Click="OpenLogs" />
                  <StackPanel>
                    <TextBlock Text="日志文件与保留范围" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="复用现有 RuntimeJournal；各进程有界滚动保留，历史缺失不补算为成功。" Style="{StaticResource Caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="启动配置">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="＋ 新建配置" Click="NewProfile" Style="{StaticResource Primary}" Margin="12,0,0,0" />
                    <TextBlock Text="启动配置库" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBlock Text="管理多套工程启动配置，下次使用时快速找到。" Style="{StaticResource Caption}" />
                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProfileLibrarySearch" Tag="搜索名称、项目或程序路径" TextChanged="ProfileLibraryFilterChanged" Margin="0" />
                    <ComboBox x:Name="ProfileProductFilter" Grid.Column="2" SelectionChanged="ProfileLibraryFilterChanged" Margin="0" />
                  </Grid>
                  <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="AllProfilesButton" Content="全部配置" Tag="all" Click="ChooseProfileScope" Style="{StaticResource Quiet}" />
                    <Button x:Name="FavoriteProfilesButton" Content="☆ 收藏" Tag="favorites" Click="ChooseProfileScope" />
                    <Button x:Name="RecentProfilesButton" Content="最近启动" Tag="recent" Click="ChooseProfileScope" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Grid x:Name="ProfileLibraryColumns">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.14*" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="已保存的配置" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ProfileLibraryCount" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="ProfileLibraryEmpty" Style="{StaticResource Caption}" Margin="0,24,0,12" />
                    <DataGrid x:Name="ProfileLibraryGrid" Height="430" Margin="0,14,0,0" SelectionChanged="ProfileLibrarySelected">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="收藏" Width="44">
                          <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Click="ToggleFavoriteProfile" ToolTip="切换收藏" Margin="0" Padding="4" MinHeight="24">
                              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="☆" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="17" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★" /><Setter Property="Foreground" Value="{DynamicResource Text.Brand}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                          </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="配置 / 程序入口" Width="*" MinWidth="180">
                          <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                              <TextBlock Text="{Binding Executable}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Executable}" Margin="0,4,0,0" />
                              <TextBlock Text="默认配置" Foreground="{DynamicResource Text.Brand}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </StackPanel>
                          </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="60" />
                        <DataGridTextColumn Header="项目" Binding="{Binding Project}" Width="80" />
                        <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="70" />
                        <DataGridTemplateColumn Header="操作" Width="64">
                          <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="编辑" Click="EditLibraryProfile" Style="{StaticResource Link}" Padding="4" Margin="0" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="配置详情" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ProfileLibraryDetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,12" />
                    <TextBlock x:Name="ProfileLibraryDetail" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                    <WrapPanel Margin="0,24,0,0">
                      <Button x:Name="ProfileEditButton" Content="编辑配置" Click="EditLibraryProfile" Style="{StaticResource Primary}" Margin="0,0,8,8" />
                      <Button x:Name="ProfileDuplicateButton" Content="复制" Click="DuplicateLibraryProfile" Margin="0,0,0,8" />
                    </WrapPanel>
                    <WrapPanel>
                      <Button x:Name="ProfileDefaultButton" Content="设为默认" Click="SetDefaultProfile" Margin="0,0,8,8" />
                      <Button x:Name="ProfileFavoriteButton" Content="收藏配置" Click="ToggleFavoriteProfile" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Button x:Name="ProfileDeleteButton" Content="删除配置…" Click="DeleteLibraryProfile" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Danger}" Margin="0,8,0,0" />
                    <Border Background="{DynamicResource Surface.Subtle}" CornerRadius="10" Padding="12" Margin="0,24,0,0"><TextBlock Text="复制配置会生成独立副本，密码需重新设置。删除仅影响本机配置，不停止已运行的工程。" Style="{StaticResource Caption}" /></Border>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
