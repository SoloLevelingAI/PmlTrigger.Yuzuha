--
--
-- Description:
-- Read the object graph of a global variable (name given without the
-- !! prefix) with a size/depth budget and optional dot-separated start
-- attribute path. Returns a flattened array.
--
------------------------------------------------------------------------
--
-- Functions defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  !!YuzuhaReadGlobal(REAL,REAL,STRING,STRING)                           ARRAY           Reads a global variable graph with a size/depth budget and start path.
--
define function !!YuzuhaReadGlobal(!size is real,!depth is real,!startStr is string,!globalVar is string) is array
  !arr = object array()
  !ob = object YuzuhaObjectWalker()
  !OB.InitializeFromGlobal(!globalVar)
  handle any
    return !arr
  endhandle
  -- !ob.MaxArraySize  = 300
  -- !ob.MaxBFSDepth   = 3
  -- !ob.startStr = 'hpos'
  !ob.MaxArraySize  = !size
  !ob.MaxBFSDepth   = !depth
  !ob.startStr = !startStr
  !arr = !ob.Read()
  RETURN !arr
endfunction

