specification {
  element system
  element component
  element actor
  element store
  relationship build
}
model {
  yuzuha = system "PmlTrigger.Yuzuha" {
    database-contracts = component "应用数据库契约 · 隔离范围与修订" { description "PmlTwin.Database.Contracts" }
    database = component "独立 SQLite 修订存储 · 现代管理进程" { description "PmlTwin.Database" }
    caf-adapter = component "CAF 薄适配 · 独立 NET48 编译验收" { description "PmlTwin.Caf.Adapter" }
    rpc = component "Named Pipe RPC · .NET 10" { description "PlantHost.Rpc.Net10" }
    workspace = component "工作区 · 启动、复制与运行日志" { description "YuzuhaToolkit.Workspace" }
    desktop = component "Windows 原生工作台 · WPF" { description "YuzuhaToolkit.Desktop" }
    cli = component "历史命令行兼容支持" { description "YuzuhaToolkit.CommandLine" }
    mcp-core = component "执行工具核心 · 会话桥、工具与函数注册" { description "YuzuhaToolkit.Mcp.Core" }
    mcp = component "历史执行入口 · MCP 已禁用" { description "YuzuhaToolkit.Mcp" }
    knowledge-core = component "知识库核心 · 建库、分块与检索" { description "YuzuhaToolkit.Knowledge.Core" }
    knowledge = component "历史知识入口 · MCP 已禁用" { description "YuzuhaToolkit.Knowledge" }
    host35 = component "AVEVA Host · .NET 3.5" { description "YuzuhaToolkit.PmlHost.Net35" }
    host48 = component "AVEVA Host · .NET 4.8" { description "YuzuhaToolkit.PmlHost.Net48" }
    devhost = component "开发 HTTP API · OpenAPI / Scalar" { description "YuzuhaToolkit.DevHost" }
    setup = component "安装计划桥 · .NET 4.8" { description "SetupBridge" }
    operations = component "共享操作契约与执行内核" { description "PmlTwin.Phayton" }
    operations-cli = component "原生 CLI 主入口 · JSON 与底层直接调用" { description "PmlTwin.Phayton.Cli" }
    webapps = component "本地 HTML 应用管理器与 IPC 适配" { description "YuzuhaToolkit.WebApps" }
    communication-contracts = component "通信进程契约" { description "YuzuhaToolkit.Communication.Contracts" }
    plugin-contracts = component "可选工作包契约" { description "YuzuhaToolkit.Plugins.Contracts" }
    manager-core = component "管理内核 · 计划、数据与独立 CLI 适配" { description "YuzuhaToolkit.Manager.Core" }
    manager-cli = component "管理器 CLI" { description "YuzuhaToolkit.Manager.Cli" }
    plugin-license = component "可选许可只读诊断工作包" { description "YuzuhaToolkit.Plugin.License" }
    plugin-vm = component "可选 VMware 任务与模拟工作包" { description "YuzuhaToolkit.Plugin.Vm" }
    cli-compatibility = component "历史 CLI 管理操作组合层" { description "YuzuhaToolkit.Cli.Compatibility" }
    builtin-guides = component "内置指南 · 无 SQLite/通信依赖" { description "YuzuhaToolkit.Builtins" }
  }
  yuzuha.database -[build]-> yuzuha.database-contracts "ProjectReference"
