{
  "name": "yuzuha-development-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "test": "pwsh -NoProfile -File scripts/Test-Development.ps1",
    "docs:build": "pwsh -NoProfile -File scripts/Build-Documentation.ps1",
    "docs:serve": "pwsh -NoProfile -File scripts/Serve-Documentation.ps1",
    "docs:catalog:check": "node scripts/documentation-catalog.mjs check",
    "architecture:generate": "node scripts/architecture.mjs generate",
    "architecture:check": "node scripts/architecture.mjs check",
    "architecture:validate": "likec4 validate docs/architecture",
    "architecture:build": "likec4 build docs/architecture -o artifacts/architecture --base ./ --use-hash-history",
    "architecture:serve": "likec4 serve docs/architecture",
    "docs:handoff:build": "node scripts/build-handoff.mjs",
    "docs:handoff:check": "node scripts/run-handoff-checks.mjs",
    "docs:handoff:prototype": "python scripts/build-handoff-prototype.py",
    "contracts:build": "node scripts/contract-atlas-metadata.mjs build && node scripts/build-contract-atlas-theme.mjs",
    "contracts:check": "node scripts/contract-atlas-metadata.mjs check && node scripts/build-contract-atlas-theme.mjs --check",
    "contracts:serve": "node scripts/serve-contract-atlas.mjs",
    "contracts:watch": "node scripts/serve-contract-atlas.mjs --watch --edit",
    "contracts:design": "node scripts/build-contract-atlas-design.mjs",
    "contracts:test": "node --test tests/contract-atlas-metadata.test.mjs tests/contract-atlas-authoring.test.mjs tests/contract-atlas-render-model.test.mjs tests/contract-atlas-pipeline.test.mjs tests/contract-atlas-design.test.mjs tests/contract-atlas-design-tokens.test.mjs tests/contract-atlas-methods.test.mjs tests/contract-atlas-bindings.test.mjs tests/contract-atlas-disclosure.test.mjs",
    "contracts:browsers:install": "playwright install chromium",
    "contracts:browser": "node tests/contract-atlas-browser.mjs",
    "contracts:themes": "node tests/contract-atlas-theme-browser.mjs",
    "contracts:live": "node tests/contract-atlas-live-browser.mjs",
    "contracts:consumer": "node tests/contract-atlas-live-consumer.test.mjs",
    "contracts:reading": "node tests/contract-atlas-task-map-browser.mjs",
    "contracts:reading:live": "node tests/contract-atlas-reading-live-browser.mjs",
    "contracts:components": "node tests/contract-atlas-disclosure-components.mjs",
    "contracts:reference": "node tests/contract-atlas-reference-browser.mjs",
    "contracts:document": "node tests/contract-atlas-document-browser.mjs",
    "contracts:outline": "node tests/contract-atlas-outline-browser.mjs",
    "contracts:tasks": "node tests/contract-atlas-task-map-browser.mjs",
    "contracts:styles:serve": "node scripts/serve-contract-style-lab.mjs --port 19440",
    "contracts:styles:browser": "node tests/contract-style-lab-browser.mjs",
    "contracts:styles:inline": "node tests/contract-style-inline-browser.mjs",
    "contracts:styles:breadcrumbs": "node tests/contract-style-breadcrumb-browser.mjs",
    "contracts:styles:methods": "node --test tests/contract-style-methods.test.mjs",
    "contracts:styles:themes": "node docs/presentation/contract-style-lab/ion/theme.js --check",
    "contracts:document:live": "node tests/contract-atlas-document-live-browser.mjs",
    "contracts:methods:capture": "pwsh -NoProfile -File scripts/Capture-ContractMethods.ps1",
    "contracts:methods:browser": "node tests/contract-atlas-method-browser.mjs",
    "contracts:methods:live": "node tests/contract-atlas-method-live-browser.mjs"
  },
  "devDependencies": {
    "likec4": "1.60.0",
    "playwright": "1.64.1",
    "yaml": "2.8.3"
  }
}
