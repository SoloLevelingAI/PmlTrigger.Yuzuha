--
--
-- Description:
-- Read the current element (CE) object graph with a size/depth budget
-- and optional dot-separated start attribute path, e.g. 'member' or
-- 'hpos.origin'. Returns a flattened array.
--
------------------------------------------------------------------------
--
-- Functions defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  !!YuzuhaReadCurrentElement(REAL,REAL,STRING)                          ARRAY           Reads the current element graph with a size/depth budget and start path.
--

define function !!YuzuhaReadCurrentElement(!size is real,!depth is real,!startStr is string) is array
  !arr = object array()
  !ob = object YuzuhaObjectWalker()
  !OB.InitializeFromCurrentElement()
  -- !ob.MaxArraySize  = 300
  -- !ob.MaxBFSDepth   = 3
  -- !ob.startStr = 'hpos'
  !ob.MaxArraySize  = !size
  !ob.MaxBFSDepth   = !depth
  !ob.startStr = !startStr
  !arr = !ob.Read()
  RETURN !arr
endfunction

