          ]
        }
      ],
      "dest": "artifacts/docfx/api/rpc"
    },
    {
      "src": [
        {
          "files": [
            "src/YuzuhaToolkit.Mcp.Core/YuzuhaToolkit.Mcp.Core.csproj"
          ]
        }
      ],
      "dest": "artifacts/docfx/api/mcp"
    },
    {
      "src": [
        {
          "files": [
            "src/YuzuhaToolkit.Knowledge.Core/YuzuhaToolkit.Knowledge.Core.csproj"
          ]
        }
      ],
      "dest": "artifacts/docfx/api/knowledge"
    },
    {
      "src": [
        {
          "files": [
            "src/YuzuhaToolkit.DevHost/YuzuhaToolkit.DevHost.csproj"
          ]
        }
      ],
      "dest": "artifacts/docfx/api/devhost"
    },
    {
      "src": [
        {
          "files": [
            "src/YuzuhaToolkit.WebApps/YuzuhaToolkit.WebApps.csproj"
          ]
        }
      ],
      "dest": "artifacts/docfx/api/webapps"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/index.md",
          "architecture.md",
          "backend-tracing.md",
          "cli.md",
          "documentation.md",
          "features/planned-tools.md",
          "form-gadget-query.md",
          "formuse-audit.md",
          "html-app-manager.md",
          "index.md",
          "installation.md",
          "launch-workflow.md",
          "manager-cli.md",
          "database.md",
          "ribbon-adapter.md",
          "manager-launch.md",
          "manager-knowledge.md",
          "manager-plugins.md",
          "phayton-object-walker.md",
          "pml-development-flow.md",
          "pml-development-plan.md",
          "startup-policy.md",
          "testing.md",
          "ui-tracing.md",
          "user-data-and-knowledge.md",
          "workspace.md",
          "toc.yml",
          "specs/**/*.md",
          "specs/**/toc.yml"
        ],
        "exclude": [
          "knowledge-filter.yml",
          "template/**"
        ],
        "src": "docs/reference"
      },
      {
        "files": [
          "**/*.yml"
        ],
        "src": "artifacts/docfx/api",
        "dest": "api"
      },
      {
        "files": [
          "**/*.md",
          "**/toc.yml"
        ],
        "src": "artifacts/docfx/navigation",
        "dest": "reference"
      }
    ],
    "resource": [
      {
        "files": [
          "2026-10-24-launch-cli.summary.json"
        ],
        "src": "docs/validation",
        "dest": "validation"
      },
      {
        "files": [
          "**/*"
        ],
        "src": "artifacts/architecture",
        "dest": "architecture"
      },
      {
        "files": [
          "v1.json"
        ],
        "src": "artifacts/openapi",
        "dest": "openapi"
      },
      {
        "files": [
          "LICENSE.docfx.txt"
        ],
        "src": "docs/reference/template",
        "dest": "third-party"
      },
      {
        "files": [
          "**/*.json",
          "**/*.png",
          "**/*.jpg",
          "**/*.svg",
          "**/*.ico",
          "**/*.html",
          "**/*.txt",
          "**/*.js",
          "**/*.mjs",
          "**/*.css"
        ],
        "src": "artifacts/docfx/navigation",
        "dest": "reference"
      },
      {
        "files": [
          "*.figcraft",
          "*.png",
          "interaction-map.json"
        ],
        "src": "docs/design",
        "dest": "design"
      }
    ],
    "dest": "artifacts/docfx/site",
    "template": [
      "default",
      "modern",
      "docs/reference/template"
    ],
    "globalMetadata": {
      "_appName": "Phayton",
      "_appTitle": "Phayton 开发文档",
      "_enableSearch": true,
      "_appFooter": "Phayton Documentation · AVEVA / PML / AI",
      "_appLogoPath": "public/logo.svg",
      "_appFaviconPath": "public/logo.svg",
      "_disableContribution": true,
      "_lang": "zh-cn"
    }
  }
}
