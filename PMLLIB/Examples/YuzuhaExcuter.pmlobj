--
-- File:            YuzuhaExcuter.pmlobj
--   Type:          Object Definition
--  
--
--    
--   Module:        design
--   Replaces:
--
-- Author:          HuangYuanTai
-- Created:         01/09/2026 19:00:22
--
--
-- Description:
-- Command executor. Runs a single PML command or a macro file with a
-- danger-command guard, and stores the result in an array for the RPC
-- host to read back. Only run on explicit user request.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  YuzuhaExcuter()                                                       -               Constructor. Creates the TargetQuery and the result array.
--  InitArgs(STRING)                                                      -               Stores the argument string used by the next execute call.
--  execute(STRING)                                                       -               Dispatches ExecuteCommand or ExecuteFile; failure for unknown commands.
--  ExecuteFile(STRING)                                                   -               Runs a macro file via $M and records success or failure.
--  Query()                                                               ARRAY           Returns the result array for the RPC host to read back.
--  ExecuteSimpleCommand(STRING)                                          -               Runs a single PML command behind the danger-command guard.
--  RunDangerCommand(STRING)                                              -               Runs a single PML command without the danger guard.
--
define object YuzuhaExcuter
  member .TargetQuery is YuzuhaTargetQuery
  member .ResArr is array
  member .ResStateStr is string
  member .ArgStr is string
  member .RunningState is boolean
endobject


------------------------------------------------------------------------
--
-- Method:      YuzuhaExcuter
--
-- Description: Constructor. Creates the TargetQuery and the result array.
--
--
------------------------------------------------------------------------
define method .YuzuhaExcuter()
  !this.TargetQuery = object YuzuhaTargetQuery()
  !this.ResArr = object array()
endmethod


------------------------------------------------------------------------
--
-- Method:      InitArgs
--
-- Description: Stores the argument string used by the next execute call.
--
--
------------------------------------------------------------------------
define method .InitArgs(!key is string)
  !this.ArgStr = !key
endmethod



------------------------------------------------------------------------
--
-- Method:      execute
--
-- Description: Dispatches 'ExecuteCommand' or 'ExecuteFile' to the matching
--              runner, or records a failure for unknown commands.
--
--
------------------------------------------------------------------------
define method .execute(!str is string)
  !this.RunningState = false
  !arr = object array()
  !this.ResArr = object array()
  if !str eq 'ExecuteCommand' then
    !this.ExecuteSimpleCommand(!this.ArgStr)
    return
  elseif !str eq 'ExecuteFile' then
    !this.ExecuteFile(!this.ArgStr)
    return
  endif
  !arr.append('Failed To Find Command')
  !this.ResArr = !arr 
endmethod


------------------------------------------------------------------------
--
-- Method:      ExecuteFile
--
-- Description: Runs a macro file via $M and records success or failure.
--
--
------------------------------------------------------------------------
define method .ExecuteFile(!file is string)
  !this.RunningState = false
  !this.ResArr = object array()
  $M $!file
  handle any
    !this.ResStateStr = 'Failed To Execute File'
    !this.ResArr.append(!this.ResStateStr)
    !this.ResArr.append(!!error.text)
    $p Agent $!!error.text
    return
  endhandle
  !this.RunningState = true
  !this.ResStateStr = 'Success,$!file Donnot Support Return Any Info'
  !this.ResArr.append(!this.ResStateStr)
  -- D:\AVEVA\Everything3D2.10\PMLLIB\YTools\modleditor.txt
endmethod


------------------------------------------------------------------------
--
-- Method:      Query
--
-- Description: Returns the result array for the RPC host to read back.
--
--
------------------------------------------------------------------------
define method .Query() is array
  return !this.ResArr
endmethod


------------------------------------------------------------------------
--
-- Method:      ExecuteSimpleCommand
--
-- Description: Runs a single PML command behind the danger-command guard.
--
--
------------------------------------------------------------------------
define method .ExecuteSimpleCommand(!cmd is string)
  !this.RunningState = false
  if !cmd.UpCase().MATCHWILD('*DELETE*') or !cmd.UpCase().MATCHWILD('*KILL*') or !cmd.UpCase().MATCHWILD('*DESIGN*') or !cmd.UpCase().MATCHWILD('*QUIT*') or !cmd.UpCase().MATCHWILD('*DRAW*') or !cmd.UpCase().MATCHWILD('*PARAGON*') then
    !this.ResStateStr = 'Dangers Command $!CMD'
    $P !!![Warning] Agent Try to Run Dangers Command |$!CMD| 
    !this.ResArr.append(!this.ResStateStr)
    !this.ResArr.append('if you want to run this command,please use !!$!<THIS>.RunDangerCommand')
    return
  endif
  $!cmd
  handle any
    !this.ResStateStr = 'Failed To RunCommand'
    !this.ResArr.append(!this.ResStateStr)
    !this.ResArr.append(!!error.text)
    $p Agent $!!error.text
    return
  endhandle
  !this.RunningState = true
  !this.ResStateStr = 'Success,Command $!cmd Donnot Support Return Any Info'
  !this.ResArr.append(!this.ResStateStr)
endmethod


------------------------------------------------------------------------
--
-- Method:      RunDangerCommand
--
-- Description: Runs a single PML command without the danger-command guard.
--
--
------------------------------------------------------------------------
define method .RunDangerCommand(!cmd is string)
  $!cmd
  handle any
    !this.ResStateStr = 'Failed To RunCommand'
    !this.ResArr.append(!this.ResStateStr)
    !this.ResArr.append(!!error.text)
    $p Agent $!!error.text
    return
  endhandle
  !this.RunningState = true
  !this.ResStateStr = 'Success,Command $!cmd Donnot Support Return Any Info'
  !this.ResArr.append(!this.ResStateStr)
endmethod

