<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- HISTORICAL / PENDING REVIEW (2026-10-23): retained for existing callers.
         Prefer scripts/Build-NativeServers.ps1 for current release builds.
         This profile's optimization/output settings are not being unified here.
         See docs/reference/deprecations.md. -->
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <StripSymbols>true</StripSymbols>
        <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
        <PublishDir>..\..\artifacts\publish\win-x64-nativeaot\</PublishDir>
    </PropertyGroup>
</Project>
