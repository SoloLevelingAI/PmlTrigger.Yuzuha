          "source": "../source/LaunchDesk.Next.Application/Features/LoginLaunch/Scripts/StartMonitor.cs"
        },
        {
          "name": "后勤接口",
          "code": "IProcessHost",
          "detail": "接受通用进程命令；不认识LaunchRequest、工程或AVEVA业务。",
          "source": "../source/LaunchDesk.Next.Application/Infrastructure/Contracts/ProcessHost.cs"
        },
