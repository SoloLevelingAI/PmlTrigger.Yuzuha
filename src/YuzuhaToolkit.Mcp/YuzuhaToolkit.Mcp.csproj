<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcMaxParallelism>2</IlcMaxParallelism>
        <AssemblyName>YuzuhaToolkit.Mcp</AssemblyName>
        <RootNamespace>YuzuhaToolkit.Mcp</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
        <ProjectReference Include="../PlantHost.Rpc.Net10/PlantHost.Rpc.Net10.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\PmlMethodSignatureGenerator.cs"
                 Link="Generator\PmlMethodSignatureGenerator.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/BuiltinGuideCatalog.cs" Link="Builtins/BuiltinGuideCatalog.cs" />
        <EmbeddedResource Include="../../docs/builtin/*.md" LogicalName="Yuzuha.Builtin.%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
