define function !!YuzuhaSaveClipboard(!outFileName is string)
  --Pdms
  import 'PMLNetUtilities'
  handle any
  endhandle
  !namespace = !!YuzuhaAddin.GetNameSpace('PMLNET')
  using namespace '$!namespace'
  !clipboard = object PMLCLIPBOARD()
  !clipboard.saveImage(!outFileName)
endfunction
