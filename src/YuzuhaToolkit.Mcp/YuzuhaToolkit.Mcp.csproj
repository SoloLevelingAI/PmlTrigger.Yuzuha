<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
        <AssemblyName>YuzuhaToolkit.Mcp</AssemblyName>
        <RootNamespace>YuzuhaToolkit.Mcp</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"
                          Version="10.0.0"/>
        <PackageReference Include="ModelContextProtocol"
                          Version="1.4.1"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="PlantHost.Rpc.Net10">
            <HintPath>..\lib\net10\PlantHost.Rpc.Net10.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\PmlMethodSignatureGenerator.cs"
                 Link="Generator\PmlMethodSignatureGenerator.cs"/>
    </ItemGroup>
</Project>
