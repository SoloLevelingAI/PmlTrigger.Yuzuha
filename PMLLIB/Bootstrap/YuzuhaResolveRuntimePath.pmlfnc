-- File:            YuzuhaResolveRuntimePath.pmlfnc
--   Type:          Function
--  
--
--    
--   Module:        design
--   Replaces:
--
-- Author:          HuangYuanTai
-- Created:         01/09/2026 19:35:25
--
--
-- Description:
-- Resolve the YuzuhaToolkit runtime path and namespace for the current
-- AVEVA application (E3D / Marine / PDMS). Sets !!YuzuhaRuntimePath,
-- !!YuzuhaNamespace and !!YuzuhaAutoSetup so the Addin can import the host.
--
-- NOTE: !folderName is the token matched against every PMLUI path. The
-- installer expects the package folder name to contain 'PmlTrigger'; a
-- Windows 8.3 short name (PMLTRI~1) still matches. When an install must
-- use a different folder name, the installer rewrites this token to the
-- first 6 upper-case letters/digits of that folder name and warns the
-- user, because a generic token can match the wrong PMLUI entry.
------------------------------------------------------------------------
--
-- Functions defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  !!YuzuhaResolveRuntimePath()                                          -               Resolves the runtime path/namespace for E3D, Marine or PDMS and sets !!YuzuhaRuntimePath etc.
--
define function !!YuzuhaResolveRuntimePath()
  -- $P 222
  !folderName = 'PMLTRI'
  !localPaTH = false
  !strPath = ''
  !profile = ''
  !dllPath = ''
  !!YuzuhaAutoSetup = FALSE
  !!YuzuhaRuntimePath = ''
  !!YuzuhaNamespace = 'YuzuhaToolkit.PmlHost'
  !infoArr = !!fmsys.FMINFO()
  !MODEL = !infoArr[0].SPLIT()[3]
  if !localPaTH then
    if !infoArr[0].MATCHwild('*Everything3D*') then
      if !infoArr[2].MATCHwild('*1.1.0.0*') then
        !!YuzuhaRuntimePath ='D:\AVEVA\AgentRuntimes\profiles\E3D2.1\net48\YuzuhaToolkit.PmlHost.Net48'
      elseif !infoArr[0].MATCHwild('*Marine*') then
        !!YuzuhaRuntimePath ='D:\AVEVA\AgentRuntimes\profiles\AM\net35\YuzuhaToolkit.PmlHost.Net35'
      elseif !infoArr[0].MATCHwild('*PDMS*')   then
        !!YuzuhaRuntimePath ='D:\AVEVA\AgentRuntimes\profiles\PDMS\net35\YuzuhaToolkit.PmlHost.Net35'
      else
      endif
    endif
    !!YuzuhaAutoSetup = TRUE
    return
  else
    var !profile evar Yuzuha
    handle any
      !profile = ''
    endhandle
    if !profile.length() gt 0 then
      !!YuzuhaProfile = !profile
      var !framework evar YuzuhaFramework
      handle any
        !framework = ''
      endhandle
      !framework = !framework.UPCASE()
      if !framework.length() eq 0 then
        if !profile.UPCASE() eq 'AM' or !profile.UPCASE() eq 'PDMS' then
          !framework = 'NET35'
        else
          !framework = 'NET48'
        endif
      endif
      if !framework eq 'NET35' then
        !dllPath = 'runtime\profiles\' + !profile + '\net35\YuzuhaToolkit.PmlHost.Net35'
      elseif !framework eq 'NET48' then
        !dllPath = 'runtime\profiles\' + !profile + '\net48\YuzuhaToolkit.PmlHost.Net48'
      else
        $p Invalid YuzuhaFramework - expected net35 or net48
        return
      endif
    endif
  endif
  
  var !path evar PMLUI
  !pathArr = !path.split(';')
  -- q var !pathArr
  do !mem values !pathArr
    if !mem.UPCASE().match(!folderName) gt 0 then
      Q VAR !MEM
      !str = part(!mem, -1, '\')
      !strPath = !mem.replace('PMLUI\','').replace('PMLUI','')
    Q VAR !STRPATH
    endif
  enddo
  if !strPath.length() gt 0 then
    !fullpath = !strPath + !dllPath
    !!YuzuhaRuntimePath = !fullpath
    !!YuzuhaAutoSetup = TRUE
    $p success Launch YuzuhaToolkit
  else
    $p YuzuhaResolveRuntimePath WARNING: no PMLUI path matched the folder token - the host DLL was not resolved
    q var !folderName
    q var !dllPath
    q var !path
    $p YuzuhaResolveRuntimePath hint: keep PmlTrigger in the install folder name, or fix the EVAR so the PMLUI path contains the token above
  endif
endfunction
