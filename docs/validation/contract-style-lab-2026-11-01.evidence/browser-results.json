  "rules": [
    {
      "id": "ion",
      "name": "ION / 离子航图",
      "tagline": "把目标接入轨道，再沿真实任务下钻。",
      "weights": {
        "acid": 50,
        "glass": 30,
        "skeuo": 20
      },
      "palette": {
        "paper": "#F1F2E9",
        "ink": "#151810",
        "muted": "#555B4C",
        "acid": "#DCFF38",
        "magenta": "#A51960",
        "chrome": "#AAB7A3"
      },
      "layout": [
        "编辑式不对称双幅主视觉；任务轨道承担五类目标选择，不是装饰仪表",
        "横线索引账册替代重复圆角卡片；标题、编号和实际任务构成主次",
        "任务页面转为横向步骤标尺，正文按当前步骤及关联契约交付展开"
      ],
      "materials": [
        "酸性：荧光柠檬集中用于选中路径和主导航，品红只作少量标签与焦点",
        "玻璃：轨道标签与范围说明使用克制半透明白底；无backdrop-filter时退化为实体白底",
        "拟物：chrome圆盘、带厚度的按钮与步骤标尺；高光不覆盖事实文字"
      ],
      "typography": [
        "粗体大标题与窄字距建立海报张力，中文正文保持14–16px和充分行距",
        "编号与来源类别用等宽小字，标题正文用中性黑白；颜色不代表成功率",
        "长字段交给同源阅读器；完整七字段、原需求和来源保持原文"
      ],
      "interaction": [
        "轨道五个节点选择真实任务分组，下方账册选择Feature",
        "步骤按原stepId定位；仅next/recovery/uncertain原关系产生路径入口，不猜运行顺序",
        "完整契约、证据、规范目录与真实方法预览为只读分支；切版保留内容状态",
        "无流程、未登记产品入口或读取失败明确说明，不伪造在线灯和指标"
      ],
      "responsive": [
        "1440：左大标题、右轨道；双列任务账册与横向步骤标尺",
        "1024：缩小主视觉但保留双幅构图，步骤说明转两列",
        "390：纵向海报、紧凑轨道、单列账册；步骤为两列，所有点击目标至少44px",
        "reduced-motion禁用过渡；本页没有自动旋转或持续闪烁"
      ],
      "regions": [
        {
          "id": "A1",
          "name": "离子海报",
          "focus": "标题、荧光标记与任务导语的比例",
          "selector": ".hero",
          "context": "project"
        },
        {
          "id": "A2",
          "name": "轨道导航",
          "focus": "chrome主视觉与五个真实目标节点的融合",
          "selector": ".orbit",
          "context": "project"
        },
        {
          "id": "A3",
          "name": "任务账册",
          "focus": "不用重复圆角卡片的可选择Feature列表",
          "selector": ".feature-ledger",
          "context": "project"
        },
        {
          "id": "A4",
          "name": "步骤标尺",
          "focus": "当前阅读位置与前后步骤的清晰动线",
          "selector": ".step-track",
          "context": "task"
        },
        {
          "id": "A5",
          "name": "契约阅读出口",
          "focus": "任务说明、完整原文和证据之间的边界",
          "selector": ".reading-exits",
          "context": "task"
        }
      ]
    },
    {
      "id": "prism",
