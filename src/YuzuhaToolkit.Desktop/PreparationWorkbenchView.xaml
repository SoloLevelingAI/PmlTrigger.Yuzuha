<UserControl x:Class="YuzuhaToolkit.Desktop.PreparationWorkbenchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prep="clr-namespace:YuzuhaToolkit.Desktop">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,3,0,6"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,3,0,6"/><Setter Property="Padding" Value="8,5"/></Style>
  </UserControl.Resources>
  <Grid KeyboardNavigation.TabNavigation="Continue">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,10,0,8" MaxHeight="64">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="StageTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TargetSummary" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,12,0"/></StackPanel>
      <TextBlock x:Name="StageStatus" Grid.Column="1" MaxWidth="245" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
      <ContentControl x:Name="GlobalToolsSlot" Grid.Column="3" VerticalAlignment="Center"/><ComboBox x:Name="PalettePicker" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PaletteChanged" AutomationProperties.Name="{prep:Bi Zh='准备工作区配色', En='Preparation workspace palette'}" Width="155" VerticalAlignment="Center" Margin="0"/>
    </Grid>
    <ListBox x:Name="Stages" Grid.Row="1" SelectionChanged="StageChanged" BorderThickness="0" Background="Transparent" Margin="0,0,0,10" AutomationProperties.Name="{prep:Bi Zh='安装到操作的阶段', En='Installation-to-operation stages'}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="StageBorder" Background="{DynamicResource Surface.Subtle}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Surface.Track}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="StageBorder" Property="Background" Value="{DynamicResource Brand.NavSelected}"/><Setter Property="Foreground" Value="{DynamicResource Brand.NavSelectedText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="StageBorder" Property="BorderBrush" Value="{DynamicResource Text.Brand}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
    </ListBox>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="44*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="56*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Background="{DynamicResource Surface.Card}" Padding="14,12">
        <DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock x:Name="InputHeading" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='输入改变后，需重新生成预览。', En='Changed input needs a fresh preview.'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
          <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
              <StackPanel x:Name="PackagePanel"><TextBlock Text="{prep:Bi Zh='应用目录', En='Application root'}" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowsePackage" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择应用目录', En='Browse for the package root'}"/><TextBox x:Name="PackageBox" TextChanged="DraftChanged" ToolTip="{prep:Bi Zh='安装器交付的应用根，或待核对载荷根', En='Application root delivered by the installer, or the payload root to inspect'}" AutomationProperties.Name="{prep:Bi Zh='应用目录', En='Application root'}"/></DockPanel><Button x:Name="ReinspectButton" Content="{prep:Bi Zh='重新核验交接（只读）', En='Re-inspect handoff (read-only)'}" Click="InspectHandoff" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='重新核验交接，只读', En='Re-inspect the handoff, read-only'}"/></StackPanel>
              <StackPanel x:Name="DiscoveryPanel"><TextBlock Text="{prep:Bi Zh='扫描范围', En='Scan scope'}" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择目录', En='Browse folder'}" Click="BrowseScan" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择扫描目录', En='Browse for a scan folder'}"/><TextBox x:Name="ScanBox" ToolTip="{prep:Bi Zh='输入一个产品根或其父目录；扫描有数量和时间预算', En='Enter a product root or its parent. Scanning has file and time budgets.'}" AutomationProperties.Name="{prep:Bi Zh='扫描范围', En='Scan scope'}"/></DockPanel><TextBlock Text="{prep:Bi Zh='只读扫描，不执行厂商BAT；明确选择一个候选后才可预览。', En='Read-only scan. Vendor BAT files are not executed. Choose one candidate before preview.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><ListBox x:Name="Installations" DisplayMemberPath="Label" SelectionChanged="InstallationChanged" MinHeight="90" MaxHeight="170" AutomationProperties.Name="{prep:Bi Zh='发现的产品安装候选', En='Discovered product installation candidates'}"/></StackPanel>
              <StackPanel x:Name="DeploymentPanel">
                <TextBlock Text="{prep:Bi Zh='明确的产品与环境', En='Selected product and environment'}" FontWeight="SemiBold"/><TextBlock x:Name="InstallationSummary" Text="{prep:Bi Zh='尚未选择；先进入“选择环境”。', En='Nothing selected yet. Open Choose environment first.'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,6"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{prep:Bi Zh='部署方式', En='Deployment mode'}" Style="{StaticResource Caption}"/><ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged" SelectedIndex="0" AutomationProperties.Name="{prep:Bi Zh='部署方式', En='Deployment mode'}"><ComboBoxItem Content="{prep:Bi Zh='引用已安装应用（保留Inno所有权）', En='Reference the installed application (Inno keeps ownership)'}" Tag="reference"/><ComboBoxItem Content="{prep:Bi Zh='复制到独立受管运行目录', En='Copy to a separate managed runtime'}" Tag="copy"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Host profile" Style="{StaticResource Caption}"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Label" SelectedValuePath="Profile" SelectionChanged="ProfileChanged" AutomationProperties.Name="{prep:Bi Zh='明确选择Host版本', En='Choose the delivered Host profile'}"/></StackPanel></Grid>
                <StackPanel x:Name="RuntimePanel"><TextBlock Text="{prep:Bi Zh='独立运行根', En='Separate runtime root'}" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowseRuntime" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择独立运行根', En='Browse for the runtime root'}"/><TextBox x:Name="RuntimeBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='独立运行根', En='Separate runtime root'}"/></DockPanel></StackPanel>
                <TextBlock Text="{prep:Bi Zh='实际INIT / BAT文件', En='Actual INIT / BAT file'}" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选择…', En='Browse…'}" Click="BrowseEnvironment" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择INIT或BAT文件', En='Browse for the INIT or BAT file'}"/><TextBox x:Name="EnvironmentBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='实际INIT或BAT文件', En='Actual INIT or BAT file'}"/></DockPanel>
                <CheckBox x:Name="EvarsOnly" Content="{prep:Bi Zh='仅预览EVARS受管行，不复制运行文件', En='Preview managed EVARS rows only; do not copy runtime files'}" Checked="PreviewModeChanged" Unchecked="PreviewModeChanged" Margin="0,4,0,8" AutomationProperties.Name="{prep:Bi Zh='仅预览EVARS受管行', En='Preview managed EVARS rows only'}"/>
              </StackPanel>
              <StackPanel x:Name="OwnershipPanel"><TextBlock Text="{prep:Bi Zh='旧安装器所有权与迁移', En='Legacy installer ownership and migration'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='先核对旧EVARS所有者。移交只更新所有权记录；不会写EVARS。', En='Check the legacy EVARS owner first. Transfer updates the ownership record only and does not write EVARS.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8"/><TextBlock Text="{prep:Bi Zh='旧安装器环境文件', En='Legacy installer environment file'}" Style="{StaticResource Caption}"/><TextBox x:Name="LegacyEnvironmentBox" TextChanged="LegacyDraftChanged" AutomationProperties.Name="{prep:Bi Zh='旧安装器环境文件', En='Legacy installer environment file'}"/><Button Content="{prep:Bi Zh='预览旧所有权移交', En='Preview legacy ownership transfer'}" Click="PreviewOwnership" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='预览旧所有权移交', En='Preview legacy ownership transfer'}"/><Expander Header="{prep:Bi Zh='只读查看其他来源（不激活、不切换数据库）', En='Read other sources (no activation, no database switch)'}" Margin="0,12,0,0"><StackPanel><ComboBox x:Name="MigrationFormatBox" SelectionChanged="MigrationFormatChanged" SelectedIndex="0" AutomationProperties.Name="{prep:Bi Zh='迁移来源格式', En='Migration source format'}"><ComboBoxItem Content="rewrite"/><ComboBoxItem Content="next"/><ComboBoxItem Content="ribbon"/></ComboBox><DockPanel><Button DockPanel.Dock="Right" Content="{prep:Bi Zh='选文件', En='Browse file'}" Click="BrowseMigration" Margin="8,4,0,8" AutomationProperties.Name="{prep:Bi Zh='选择迁移来源文件', En='Browse for a migration source'}"/><TextBox x:Name="MigrationBox" TextChanged="DraftChanged" AutomationProperties.Name="{prep:Bi Zh='迁移来源文件', En='Migration source file'}"/></DockPanel><Button Content="{prep:Bi Zh='只读预览迁移来源', En='Preview the migration source (read-only)'}" Click="PreviewMigration" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='只读预览迁移来源', En='Preview the migration source, read-only'}"/></StackPanel></Expander></StackPanel>              <StackPanel x:Name="LaunchPanel"><TextBlock Text="{prep:Bi Zh='保存配置与明确启动', En='Save a profile and launch explicitly'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='本阶段只打开已有启动页。准备工作区不调用 launch.plan、launch.execute 或 launch.observe，也不授予启动。启动仍在启动页完成：配置、冻结、明确启动、按原编号观察。', En='This stage only opens the existing launch page. Preparation does not call launch.plan, launch.execute, or launch.observe, and it does not grant launch. Launch still happens on that page: configure, freeze, launch explicitly, then observe by the original id.'}" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="{prep:Bi Zh='前往启动工程 →', En='Go to launch →'}" Click="GoLaunch" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='前往启动工程，不在本页启动', En='Go to launch. This page does not start a process.'}"/></StackPanel>
              <StackPanel x:Name="VerifyPanel"><TextBlock Text="{prep:Bi Zh='严格会话身份与操作目标', En='Strict session identity and operation target'}" FontWeight="SemiBold"/><TextBlock Text="{prep:Bi Zh='本阶段只打开已有会话页。准备工作区不调用 connection.sessions、connection.select、connection.status 或 connection.test，不连接、不授予执行或写入，也不发送 PML。', En='This stage only opens the existing session page. Preparation does not call connection.sessions, connection.select, connection.status, or connection.test. It does not connect, grant execution or writes, or send PML.'}" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="{prep:Bi Zh='前往连接与核验 →', En='Go to connection and verification →'}" Click="GoVerify" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='前往连接与核验，不在本页连接', En='Go to connection and verification. This page does not connect.'}"/></StackPanel>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Background="{DynamicResource Surface.Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="14,8,14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{prep:Bi Zh='计划与结果', En='Plan and result'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{prep:Bi Zh='阶段指南 ↗', En='Stage guide ↗'}" Click="OpenContractDocument" Margin="8,0,0,0" Padding="10,6"/><Button x:Name="DetailsButton" Content="{prep:Bi Zh='查看详情', En='View details'}" Click="ToggleDetails" Margin="8,0,0,0" Padding="12,6"/></StackPanel></Grid>
          <TabControl x:Name="Readers" SelectionChanged="ReaderChanged" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{prep:Bi Zh='准备阅读栏目', En='Preparation readers'}">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel x:Name="ReaderHeaders" DockPanel.Dock="Top" IsItemsHost="True" Margin="8,0"/><ContentPresenter ContentSource="SelectedContent"/></DockPanel><ControlTemplate.Triggers><Trigger Property="SelectedIndex" Value="0"><Setter TargetName="ReaderHeaders" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></TabControl.Template>
            <TabItem Header="{prep:Bi Zh='摘要', En='Summary'}" Tag="summary"><ScrollViewer x:Name="OutcomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,8,14,12">
              <TextBlock x:Name="OutcomeSummary" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Text.Secondary}"/>
              <StackPanel x:Name="PlanPanel"><TextBlock Text="{prep:Bi Zh='本次冻结计划', En='Frozen plan for this action'}" FontWeight="SemiBold"/><TextBlock x:Name="PlanSummary" Text="{prep:Bi Zh='尚未生成冻结计划。', En='No frozen plan yet.'}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="PlanTarget" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Margin="0,6,0,0"/><StackPanel x:Name="ManagedChanges" Margin="0,10,0,8"/><Expander x:Name="PlanIdentityExpander" Header="{prep:Bi Zh='计划编号与指纹（可复制）', En='Plan id and fingerprint (selectable)'}" Margin="0,8,0,0"><Border Style="{StaticResource MetadataBadge}" HorizontalAlignment="Stretch"><TextBox x:Name="PlanIdentity" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='完整冻结计划编号和SHA256', En='Complete frozen plan id and SHA256'}"/></Border></Expander></StackPanel>
              <StackPanel x:Name="RecoveryPanel"><TextBlock Text="{prep:Bi Zh='按原回执条件恢复', En='Restore only from the original receipt'}" FontWeight="SemiBold"/><TextBlock x:Name="RecoverySummary" Text="{prep:Bi Zh='尚无可恢复回执。', En='No restorable receipt yet.'}" TextWrapping="Wrap" Margin="0,7,0,8"/><TextBlock x:Name="RecoveryTarget" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Margin="0,0,0,8"/><Expander x:Name="RecoveryIdentityExpander" Header="{prep:Bi Zh='恢复回执编号与指纹（可复制）', En='Recovery receipt id and fingerprint (selectable)'}" Margin="0,0,0,8"><Border Style="{StaticResource MetadataBadge}" HorizontalAlignment="Stretch"><TextBox x:Name="RecoveryIdentity" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='完整恢复回执编号和SHA256', En='Complete recovery receipt id and SHA256'}"/></Border></Expander><Button Content="{prep:Bi Zh='查看原回执与诊断 →', En='View the original receipt and diagnostics →'}" Click="OpenHistory" HorizontalAlignment="Left"/></StackPanel>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='完整契约', En='Contract'}" Tag="contract" AutomationProperties.Name="{prep:Bi Zh='完整契约', En='Contract'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContractFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='解释脚本', En='Script notes'}" Tag="scripts" AutomationProperties.Name="{prep:Bi Zh='解释脚本', En='Script notes'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScriptFields" Margin="16,12"/></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='验收证据', En='Evidence'}" Tag="evidence" AutomationProperties.Name="{prep:Bi Zh='验收证据', En='Evidence'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,12"><TextBlock Text="{prep:Bi Zh='本阶段的验收边界', En='Acceptance boundary for this stage'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceBoundary" TextWrapping="Wrap" Margin="0,10,0,14"/><TextBlock Text="{prep:Bi Zh='本次真实操作回执', En='Receipt from this real operation'}" FontWeight="SemiBold"/><TextBlock x:Name="EvidenceOutcome" Text="{prep:Bi Zh='尚未执行；阅读阶段不是验收通过。', En='Not run. Reading a stage is not acceptance.'}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8"/><Border Style="{StaticResource MetadataBadge}" Margin="0,0,0,10"><TextBox x:Name="EvidenceOperation" Style="{StaticResource MetadataValue}" AutomationProperties.Name="{prep:Bi Zh='回执原始操作标识', En='Raw operation id from the receipt'}"/></Border><TextBlock x:Name="EvidenceResult" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="{prep:Bi Zh='打开完整任务契约与验收说明 ↗', En='Open the full task contract and acceptance note ↗'}" Click="OpenContractDocument" HorizontalAlignment="Left" AutomationProperties.Name="{prep:Bi Zh='打开完整任务契约与验收说明', En='Open the full task contract and acceptance note'}"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="{prep:Bi Zh='历史与诊断', En='History and diagnostics'}" Tag="history"><Grid Margin="14,12">              <Expander x:Name="RawResultExpander" Header="{prep:Bi Zh='完整操作回执与诊断', En='Complete operation receipt and diagnostics'}" Margin="0" IsExpanded="True"><TextBox x:Name="ResultBody" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{prep:Bi Zh='完整操作回执与诊断', En='Complete operation receipt and diagnostics'}"/></Expander></Grid></TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ActionEffect" Text="{prep:Bi Zh='本次只读核对应用载荷与安装记录。', En='This action only reads the payload and installation record.'}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="InlineResult" Text="{prep:Bi Zh='等待你的明确操作。', En='Waiting for an explicit action.'}" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" MaxHeight="36" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="InlineOperation" Style="{StaticResource Metadata}" Margin="0,3,0,0"/></StackPanel><Button x:Name="PrimaryAction" Grid.Column="1" Content="{prep:Bi Zh='核对安装交接', En='Inspect installation handoff'}" Click="RunPrimary" Style="{StaticResource Primary}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</UserControl>
