<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>YuzuhaToolkit.Knowledge</AssemblyName>
        <RootNamespace>YuzuhaToolkit.Knowledge</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <!-- Native AOT executable; ship e_sqlite3.dll alongside it. -->
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcMaxParallelism>2</IlcMaxParallelism>
        <PublishSingleFile>false</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
    <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- 检索与建库在 Core；本工程只保留 MCP 工具面与宿主编排。 -->
        <ProjectReference Include="../YuzuhaToolkit.Knowledge.Core/YuzuhaToolkit.Knowledge.Core.csproj" />
        <ProjectReference Include="../YuzuhaToolkit.Mcp.Core/YuzuhaToolkit.Mcp.Core.csproj" />
        <ProjectReference Include="../YuzuhaToolkit.Cli.Compatibility/YuzuhaToolkit.Cli.Compatibility.csproj" />
        <ProjectReference Include="../YuzuhaToolkit.CommandLine/YuzuhaToolkit.CommandLine.csproj" />
        <ProjectReference Include="../YuzuhaToolkit.Workspace/YuzuhaToolkit.Workspace.csproj" />
        <PackageReference Include="Microsoft.Extensions.Hosting"
                          Version="10.0.0"/>
        <PackageReference Include="ModelContextProtocol"
                          Version="1.4.1"/>
    </ItemGroup>
</Project>
