--
--
-- Description:
-- Resolves a DBREF by name (short name, /full path or =dbref) and reads
-- its object graph through YuzuhaObjectWalker, restoring the original CE.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                                                           Return          Description
--  ===========                                                           ======          ===========
--  YuzuhaTargetQuery()                                                   -               Constructor.
--  ResolveDbref(STRING)                                                  DBREF           Normalises a short/full name or DBREF string; badref if not found.
--  ReadTarget(STRING)                                                    ARRAY           Switches CE to the target, reads its graph and restores the original CE.
--

define object YuzuhaTargetQuery

endobject

define method .YuzuhaTargetQuery()

endmethod

define method .ResolveDbref(!name is string) is dbref
  !dbname = ''
  if !name.matchwild('=*') or !name.matchwild('/*') then
    !dbname = !name
  else
    !dbname = '/' + !name
  endif
  !db          = $!dbname
  handle any
    !db        = object dbref()
  endhandle
  return !db
endmethod

define method .ReadTarget(!name is string) is array
  !arr = object array()
  !originalCe = ce
  !targetDb = !this.ResolveDbref(!name)
  if !targetDb.badref() then
    !arr.append('Failed To Find Dbref')
    return !arr
  endif
  $!targetDb
  handle any
    !arr.append('$!!error.text')
    return !arr
  endhandle
  !ob = object YuzuhaObjectWalker()
  !ob.InitializeFromCurrentElement()
  !ob.MaxArraySize = 10
  !ob.MaxBFSDepth = 3
  !ob.startStr = ''
  !arr = !ob.Read()
  handle any
    $!originalCe
    !arr.append('$!!error.text')
    return !arr
  endhandle
  $!originalCe
  return !arr
endmethod
