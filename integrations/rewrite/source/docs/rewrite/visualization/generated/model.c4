        ProbeObservation = record "ProbeObservation" {
          #proposed
          description "不可变单次观测，携带完整资源身份键、实际探测来源、开始和完成时间及分项事实；网络探测另保留实际解析地址证据。\n\n生命周期：单次探测事实，可进入对应身份的轮次。\n模块归属为展示建议。"
          link ../#/type/ProbeObservation "职责、方法与审阅证据"
        }
        ProbeRound = record "ProbeRound" {
          #proposed
          description "冻结同一完整资源身份键、策略版本、轮次序号和同身份观测集合。\n\n生命周期：单个资源身份键的一轮探测。\n模块归属为展示建议。"
          link ../#/type/ProbeRound "职责、方法与审阅证据"
        }
        ProbeSnapshot = record "ProbeSnapshot" {
          #proposed
          description "在原状态、证据及时间字段之外明确携带 ResourceRevision、MachineId、DescriptorDigest、PolicyVersion、RoundSequence；所有分项证据属于同一资源身份键。\n\n生命周期：不可变监测投影；过期后不能作为启动前新鲜证据。"
          link ../#/type/ProbeSnapshot "职责、方法与审阅证据"
        }
        OperationRequestSnapshot = record "OperationRequestSnapshot" {
          #proposed
          description "保留有限种类、机器、工作区修订、冻结配置和计划；新增明确的规范化 RequestDigest。Launch 快照包含完整冻结 ResourceDescriptor，PlanDigest 覆盖该描述身份及许可环境输入。\n\n生命周期：受理前冻结，受理后持久不可变；由操作及恢复引用保留。"
          link ../#/type/OperationRequestSnapshot "职责、方法与审阅证据"
        }
        LaunchPlan = record "LaunchPlan" {
          #proposed
          description "保留入口、初始化文件、参数令牌、环境和秘密槽；明确携带冻结 ResourceDescriptor 及其摘要，与 WorkspaceRevision、MachineId 一并进入计划摘要。\n\n生命周期：每次启动独立不可变计划。"
          link ../#/type/LaunchPlan "职责、方法与审阅证据"
        }
        CommitId = record "CommitId" {
          #proposed
          description "一次逻辑配置提交的稳定随机标识，键空间绑定工作区身份；在发起提交前分配并保留。\n\n生命周期：跨页面重建、后续提交及进程重启有效。\n模块归属为展示建议。"
          link ../#/type/CommitId "职责、方法与审阅证据"
        }
        CommitIntent = record "CommitIntent" {
          #proposed
          description "不可变提交意图，包含 CommitId、有限命令种类、ExpectedRevision、规范化非秘密输入、生成 ID 槽位、SecretUpdateKind 和本次 Replace 输入随机标识；由用例重新计算版本化 RequestDigest。\n\n生命周期：提交前冻结；非秘密意图和摘要随核验记录持久保留。\n模块归属为展示建议。"
          link ../#/type/CommitIntent "职责、方法与审阅证据"
        }
        CommitReceipt = record "CommitReceipt" {
          #proposed
          description "不可变公开核验结果，包含 CommitId、RequestDigest、State、CommittedRevision、生成实体 ID 映射、原提交的脱敏结果投影和安全原因；State 为 NotFound、Pending、Committed、NotCommitted 或 Indeterminate。\n\n生命周期：首版在工作区生命周期内保留确定结果和去重墓碑；未决记录不得清理。\n模块归属为展示建议。"
          link ../#/type/CommitReceipt "职责、方法与审阅证据"
        }
      }
      storage = module "持久化与迁移" {
        description "配置提交、历史核验、日志、暂存与安全迁移"
        link ../#/module/storage "模块与类型详情"
        JsonWorkspaceStore = class "JsonWorkspaceStore" {
          #proposed
          description "实现稳定 CommitId 去重、版本化准备记录和可跨修订核验的配置提交。\n\n生命周期：工作区级单例；写会话持跨进程提交锁，提交历史首版不自动裁剪。"
          link ../#/type/JsonWorkspaceStore "职责、方法与审阅证据"
        }
        WorkspaceLocationResolver = class "WorkspaceLocationResolver" {
          #proposed
          description "显式 --config、portable、默认目录的唯一解析与打开入口。\n\n生命周期：Singleton"
          link ../#/type/WorkspaceLocationResolver "职责、方法与审阅证据"
        }
        JsonRunJournal = class "JsonRunJournal" {
          #proposed
          description "实现 IRunJournal 的跨进程受理、一次执行准入及版本化事实日志。\n\n生命周期：工作区级单例；持久锁覆盖所有相关进程，执行凭据仅在原进程有效。"
          link ../#/type/JsonRunJournal "职责、方法与审阅证据"
        }
        PrivateStagingStore = class "PrivateStagingStore" {
          #proposed
          description "在已登记控制根内维护冻结来源及不可变计划。\n\n生命周期：工作区级单例；根位置先登记后使用。\n模块归属为展示建议。"
          link ../#/type/PrivateStagingStore "职责、方法与审阅证据"
        }
        JsonMigrationStore = class "JsonMigrationStore" {
          #proposed
          description "PersistenceAndMigration 实现 IMigrationStore。\n\n生命周期：PersistenceAndMigration 工作区级单例。\n模块归属为展示建议。"
          link ../#/type/JsonMigrationStore "职责、方法与审阅证据"
        }
        WorkspaceCommitSession = class "WorkspaceCommitSession" {
          #proposed
          description "封装一次配置准备结果：CommitId、摘要、稳定 ID 映射和已有回执；仅首次成功准备返回绑定原进程的写入能力，重复结果只读。\n\n生命周期：首次会话从准备落盘覆盖凭据创建和配置切换；重复会话只读且无写锁所有权。\n模块归属为展示建议。"
          link ../#/type/WorkspaceCommitSession "职责、方法与审阅证据"
        }
      }
      platform = module "Windows 与来源适配" {
        description "凭据、进程、探针、文件、环境及控制资料保护"
        link ../#/module/platform "模块与类型详情"
        WindowsSecretVault = class "WindowsSecretVault" {
          #proposed
          description "隔离 Windows 凭据 API，秘密只在本机短暂取得。\n\n生命周期：Singleton"
          link ../#/type/WindowsSecretVault "职责、方法与审阅证据"
        }
        WindowsProcessGateway = class "WindowsProcessGateway" {
          #proposed
          description "实现产品入口启动及进程、窗口和可用会话证据采集。\n\n生命周期：WindowsAndSourceAdapters 单例；TrackedProcess 按启动或只读附着创建。"
          link ../#/type/WindowsProcessGateway "职责、方法与审阅证据"
        }
        WindowsResourceProbe = class "WindowsResourceProbe" {
          #proposed
          description "实现冻结 TCP、服务或虚拟机入口描述的一次 Windows 观测。\n\n生命周期：应用级单例；调用级观测状态及超时。"
          link ../#/type/WindowsResourceProbe "职责、方法与审阅证据"
        }
        PackageReader = class "PackageReader" {
          #proposed
          description "只读枚举和内容检查。\n\n生命周期：WindowsAndSourceAdapters 单例；读取句柄调用级。"
          link ../#/type/PackageReader "职责、方法与审阅证据"
        }
        FileDeliveryPort = class "FileDeliveryPort" {
          #proposed
          description "执行经控制范围保护、逐项可核验的文件变更。\n\n生命周期：单例；每次 Apply 独占对应回执写入权，实际写入者持有组合租约。"
          link ../#/type/FileDeliveryPort "职责、方法与审阅证据"
        }
        CanonicalTargetLeaseProvider = class "CanonicalTargetLeaseProvider" {
          #proposed
          description "按真实目标范围提供包含控制数据保护的跨进程组合租约。\n\n生命周期：每进程单例；组合 TargetLease 从锁内复核持有至最后可靠回执。"
          link ../#/type/CanonicalTargetLeaseProvider "职责、方法与审阅证据"
        }
        WindowsEnvironmentStore = class "WindowsEnvironmentStore" {
          #proposed
          description "持久变量读取及带检查点的尽力冲突检测写入。\n\n生命周期：WindowsAndSourceAdapters 单例；写入锁和核验状态调用级。"
          link ../#/type/WindowsEnvironmentStore "职责、方法与审阅证据"
        }
        WindowsPrivilegeBroker = class "WindowsPrivilegeBroker" {
          #proposed
          description "建立受限提权会话并转交已确认操作。\n\n生命周期：WindowsAndSourceAdapters 应用级单例；每操作独立一次性提权会话。"
          link ../#/type/WindowsPrivilegeBroker "职责、方法与审阅证据"
        }
        WindowsEntryDiscovery = class "WindowsEntryDiscovery" {
          #proposed
          description "WindowsAndSourceAdapters 中实现 IEntryDiscovery。\n\n生命周期：WindowsAndSourceAdapters 应用级单例；扫描状态调用级。\n模块归属为展示建议。"
          link ../#/type/WindowsEntryDiscovery "职责、方法与审阅证据"
        }
        ControlDataLease = class "ControlDataLease" {
          #proposed
          description "持有经核验的部署影响范围与控制根登记之间的保护准入。\n\n生命周期：由 TargetLease 组合持有，覆盖目标核验、写入及最后可靠回执。\n模块归属为展示建议。"
          link ../#/type/ControlDataLease "职责、方法与审阅证据"
        }
        WindowsControlDataGuard = class "WindowsControlDataGuard" {
          #proposed
          description "实现 IControlDataGuard，维护受 ACL 保护的跨进程控制根登记及活动变更范围。\n\n生命周期：每进程单例；登记持久共享，活动范围绑定实际写入进程。\n模块归属为展示建议。"
          link ../#/type/WindowsControlDataGuard "职责、方法与审阅证据"
        }
      }
    }
    composition = area "装配与开发" {
      description "普通桌面入口与可替换的开发编排"
      style { color secondary }
      bootstrap = module "桌面组合根" {
        description "有限处理器工厂、依赖装配和保护根初始化"
        link ../#/module/bootstrap "模块与类型详情"
        OperationHandlerRegistry = class "OperationHandlerRegistry" {
          #proposed
          description "根据有限操作种类创建独立处理器租约。\n\n生命周期：OperationCoordination 应用级只读注册表。"
          link ../#/type/OperationHandlerRegistry "职责、方法与审阅证据"
        }
        DesktopCompositionRoot = class "DesktopCompositionRoot" {
          #proposed
          description "装配同一 Desktop 运行时、保护登记及操作和直接提交协议。\n\n生命周期：每 Desktop 进程一次；保护登记跨进程持久共享。"
          link ../#/type/DesktopCompositionRoot "职责、方法与审阅证据"
        }
      }
      devhost = module "可选开发入口" {
        description "Aspire 开发适配，普通 EXE 独立运行"
        link ../#/module/devhost "模块与类型详情"
        AspireDevelopmentHost = class "AspireDevelopmentHost" {
          #proposed
          description "提供可替换开发入口及开发资源所有权管理。\n\n生命周期：CompositionAndDiagnostics 开发会话级；通过进程产物边界启动 Desktop。"
          link ../#/type/AspireDevelopmentHost "职责、方法与审阅证据"
        }
      }
    }
  }
