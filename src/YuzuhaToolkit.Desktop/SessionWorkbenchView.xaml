<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YuzuhaToolkit.Desktop.SessionWorkbenchView" Foreground="{DynamicResource Text.Primary}">
  <DockPanel>
    <Border x:Name="FeedbackPanel" DockPanel.Dock="Bottom" Background="{DynamicResource Surface.TintBrand}" CornerRadius="10" Padding="14,8" Margin="0,0,0,10">
      <DockPanel>
        <Button x:Name="CancelWaitButton" DockPanel.Dock="Right" Content="取消等待" Click="CancelWait" Visibility="Collapsed" ToolTip="已发出的操作可能继续" />
        <TextBlock x:Name="FeedbackText" Text="先发现并选择会话，核验身份后再操作。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
      </DockPanel>
    </Border>
    <TabControl x:Name="FlowTabs" Background="Transparent" BorderThickness="0" SelectionChanged="FlowChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <ContentPresenter ContentSource="SelectedContent" />
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="工程会话">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid x:Name="SessionColumns">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.14*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" MinHeight="332">
                <StackPanel>
                  <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                      <Button Content="♙ 能力与函数" Click="ShowFunctions" FontSize="11" />
                      <Button Content="⟳ 扫描会话" Click="DiscoverSessions" FontSize="11" />
                    </WrapPanel>
                    <StackPanel>
                      <TextBlock Text="工程会话" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="选择目标 PID 后再执行查询或调用" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,12,0,10">
                    <Button DockPanel.Dock="Right" Content="选择并核验  →" Click="SelectSession" Style="{StaticResource Primary}" FontSize="11" />
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                      <TextBlock x:Name="CandidateCountText" Text="全部 0" Foreground="{DynamicResource Text.Brand}" FontSize="11" />
                    </Border>
                  </DockPanel>
                  <DataGrid x:Name="SessionsGrid" Height="160">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="会话 / 产品" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <DockPanel>
                              <Border Width="32" Height="34" CornerRadius="8" Background="{DynamicResource Surface.TintBrand}" Margin="0,0,10,0">
                                <TextBlock Text="E" Foreground="{DynamicResource Text.Brand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel>
                                <TextBlock Text="{Binding Candidate.Product}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Candidate.WindowTitle}" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                              </StackPanel>
                            </DockPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="PID" Binding="{Binding Candidate.ProcessId}" Width="68" />
                      <DataGridTextColumn Header="Host 管道" Binding="{Binding HostLabel}" Width="118" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="发现不自动连接 · 无 Host 的窗口保留为候选" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                      <TextBlock x:Name="IdentityStateText" Text="待核验" Foreground="{DynamicResource Text.Brand}" FontSize="10" />
                    </Border>
                    <TextBlock Text="当前会话身份" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBlock Text="PID + 进程启动时间 + Host 身份" Style="{StaticResource Caption}" />
                  <TextBlock x:Name="TargetText" Text="尚未选择目标" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,10" />
                  <Border Height="1" Background="{DynamicResource Border.Subtle}" />
                  <TextBlock x:Name="TargetDetailsText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Secondary}" LineHeight="23" Margin="0,12,0,16" />
                  <Button Content="⟳ 重新核验" Click="VerifyTarget" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="SessionMiddleColumns">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.14*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" MinHeight="292">
                <StackPanel>
                  <DockPanel>
                    <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" Background="{DynamicResource Surface.TintWarning}">
                      <TextBlock Text="Q03 · 尚未接入" Foreground="{DynamicResource Text.Warning}" FontSize="10" />
                    </Border>
                    <TextBlock Text="当前元素" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBlock Text="原稿区域保留 · 尚未读取当前元素" Style="{StaticResource Caption}" />
                  <TextBlock Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,20,0,8" />
                  <TextBlock Text="名称、类型、DBREF 与所属对象" Foreground="{DynamicResource Text.Tertiary}" FontSize="12" />
                  <UniformGrid Columns="4" Margin="0,22,0,18">
                    <StackPanel>
                      <TextBlock Text="位置 N" Style="{StaticResource Caption}" />
                      <TextBlock Text="—" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="位置 E" Style="{StaticResource Caption}" />
                      <TextBlock Text="—" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="材料" Style="{StaticResource Caption}" />
                      <TextBlock Text="—" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="等级" Style="{StaticResource Caption}" />
                      <TextBlock Text="—" Margin="0,8,0,0" />
                    </StackPanel>
                  </UniformGrid>
                  <Button Content="读取当前元素" IsEnabled="False" HorizontalAlignment="Right" ToolTip="保留设计入口；当前批次未接入桌面" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="对象查询" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="查询不修改模型" Style="{StaticResource Caption}" />
                  <TextBlock Text="DBREF" Style="{StaticResource Caption}" Margin="0,15,0,0" />
                  <TextBox Tag="=12345/12" IsEnabled="False" />
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="读取深度" Style="{StaticResource Caption}" />
                      <TextBox Text="2" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="返回上限" Style="{StaticResource Caption}" />
                      <TextBox Text="30" IsEnabled="False" />
                    </StackPanel>
                  </UniformGrid>
                  <Button Content="读取指定 DBREF  →" IsEnabled="False" />
                  <TextBlock Text="Q03 · 保留原稿交互，已有工具的桌面接线待交付。" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" Margin="0,14,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="SessionLowerColumns">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.14*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" MinHeight="232">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Form / Gadget 查询 →" Click="ShowQueries" Style="{StaticResource Link}" FontSize="11" />
                    <TextBlock Text="最近查询" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBlock Text="当前窗口最近一次返回 · 不作为历史统计" Style="{StaticResource Caption}" />
                  <DataGrid x:Name="RecentQueryGrid" Height="145" Margin="0,12,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="查询" Binding="{Binding Kind}" Width="*" />
                      <DataGridTextColumn Header="目标 PID" Binding="{Binding Pid}" Width="80" />
                      <DataGridTextColumn Header="返回数" Binding="{Binding Count}" Width="72" />
                      <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="94" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                      <TextBlock Text="原始回执" Foreground="{DynamicResource Text.Brand}" FontSize="10" />
                    </Border>
                    <TextBlock Text="PML 控制台" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBox x:Name="SessionReceiptText" IsReadOnly="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface.Code}" Foreground="{DynamicResource Text.CodeText}" FontFamily="Consolas" FontSize="10" Margin="0,12,0,10" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="▶ 执行" IsEnabled="False" />
                    <TextBox Tag="原始命令待接入" IsEnabled="False" Margin="0,0,8,0" />
                  </DockPanel>
                  <TextBlock Text="Q03 · 本批使用注册调用或原生只读查询。" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="能力与函数">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button Content="← 返回工程会话" Click="ShowSessions" HorizontalAlignment="Left" Margin="0,0,0,10" FontSize="11" MinHeight="28" Padding="12,5" />
            <Border Style="{StaticResource Card}" Padding="18,14">
              <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                  <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                    <TextBlock Text="FormQuery / 有界数组" Foreground="{DynamicResource Text.Brand}" FontSize="10" />
                  </Border>
                  <Button Content="原生查询  →" Click="ShowQueries" Style="{StaticResource Link}" FontSize="11" />
                </WrapPanel>
                <StackPanel>
                  <TextBlock Text="当前目标" Style="{StaticResource Caption}" />
                  <TextBlock x:Name="FunctionTargetText" Text="尚未核验" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Grid x:Name="FunctionColumns">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" MinHeight="490">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="登记函数  +" Click="ExpandRegistration" Style="{StaticResource Primary}" FontSize="11" />
                    <StackPanel>
                      <TextBlock Text="已登记函数" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="许可、源码哈希、签名与会话加载分别表达" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <Expander x:Name="RegistrationPanel" Header="登记 / 重新登记源码" Visibility="Collapsed" Margin="0,14,0,8">
                    <StackPanel Margin="0,10,0,0">
                      <TextBlock Text="源文件（.pmlfnc）" Style="{StaticResource Caption}" />
                      <DockPanel>
                        <Button Content="选择文件" Click="BrowseFunction" DockPanel.Dock="Right" Margin="8,4,0,10" />
                        <TextBox x:Name="FunctionSourceBox" />
                      </DockPanel>
                      <TextBlock Text="全局函数名（不带 !!、点号或括号）" Style="{StaticResource Caption}" />
                      <TextBox x:Name="FunctionNameBox" />
                      <WrapPanel>
                        <Button Content="登记 / 重新登记" Click="RegisterFunction" Style="{StaticResource Primary}" />
                        <Button Content="刷新" Click="RefreshFunctions" />
                      </WrapPanel>
                    </StackPanel>
                  </Expander>
                  <DataGrid x:Name="FunctionsGrid" Height="322" Margin="0,16,0,0" SelectionChanged="FunctionSelected">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="函数 / 签名" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding Entry.Name}" FontFamily="Consolas" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Signature}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="许可" Binding="{Binding Permission}" Width="60" />
                      <DataGridTextColumn Header="源码身份" Binding="{Binding Identity}" Width="142" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="默认 AllowInvoke=false · 源码变化后重新登记与人工授权" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" Margin="0,18,0,0" />
                  <TextBox x:Name="SourceDetailsBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="280" VerticalScrollBarVisibility="Auto" FontFamily="Consolas,Microsoft YaHei UI" FontSize="11" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                      <TextBlock Text="全局函数" Foreground="{DynamicResource Text.Brand}" FontSize="10" />
                    </Border>
                    <TextBlock Text="函数详情" Style="{StaticResource SectionTitle}" />
                  </DockPanel>
                  <TextBlock x:Name="InvocationNameText" Text="先选择登记项" FontFamily="Consolas,Microsoft YaHei UI" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap" />
                  <TextBlock x:Name="FunctionSourceText" Text="选择后显示源码位置" Style="{StaticResource Caption}" FontSize="10" />
                  <Border Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,14">
                    <TextBlock x:Name="FunctionHashText" Text="登记与当前源码分别核对" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas,Microsoft YaHei UI" FontSize="10" TextWrapping="Wrap" />
                  </Border>
                  <WrapPanel>
                    <Button Content="授予许可" Click="GrantFunction" Style="{StaticResource Quiet}" FontSize="11" />
                    <Button Content="撤销许可" Click="RevokeFunction" FontSize="11" />
                  </WrapPanel>
                  <Expander Header="调用参数与预览" IsExpanded="False" Margin="0,16,0,12">
                    <StackPanel Margin="0,10,0,0">
                      <ItemsControl x:Name="ParametersList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                              <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <WrapPanel Margin="0,4,0,0">
                        <Button Content="核验并预览" Click="PreviewFunction" FontSize="11" />
                        <Button Content="执行一次 ▶" Click="InvokeFunction" Style="{StaticResource Primary}" FontSize="11" />
                      </WrapPanel>
                      <TextBox x:Name="CallPreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="38" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                  </Expander>
                  <WrapPanel>
                    <Button Content="查看源码 / 哈希" Click="InspectFunction" FontSize="10" />
                    <Button Content="重新登记" Click="ExpandRegistration" Style="{StaticResource Primary}" FontSize="10" />
                  </WrapPanel>
                  <TextBlock Text="Q04 · 登记不代表会话已加载版本；历史差异需 Git。调度完成与业务结果分开。" Style="{StaticResource Caption}" Foreground="{DynamicResource Text.Warning}" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
              <Grid x:Name="FunctionArrayColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Margin="0" Padding="0" BorderThickness="0">
                  <StackPanel>
                    <TextBlock Text="有界查询与续读" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="已有全局数组名（不带 !!）；沿用扫描与字符预算。" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                      <TextBlock Text="扫描槽位" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox Text="{Binding Text, ElementName=ItemsBudgetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="66" Margin="0,0,16,0" />
                      <TextBlock Text="字符预算" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox Text="{Binding Text, ElementName=CharsBudgetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="92" Margin="0" />
                    </WrapPanel>
                    <DockPanel Margin="0,12,0,0">
                      <WrapPanel DockPanel.Dock="Right">
                        <Button Content="读取数组" Click="ReadArray" />
                        <Button x:Name="ContinueArrayButton" Content="继续读取" IsEnabled="False" Click="ContinueArray" />
                      </WrapPanel>
                      <TextBox x:Name="ArrayNameBox" TextChanged="QueryInputsChanged" />
                    </DockPanel>
                    <TextBlock x:Name="ArrayWindowText" Text="索引上界不是有效条目总数；跨请求不保证冻结快照。" TextWrapping="Wrap" />
                    <Expander Header="查看返回行" Margin="0,12,0,0">
                      <TextBox x:Name="ArrayRowsBox" IsReadOnly="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Form / Gadget" FontWeight="SemiBold" />
                    <TextBlock Text="已显示 / 已加载窗体 → 控件 → 固定属性" Style="{StaticResource Caption}" Margin="0,12,0,14" />
                    <Button Content="打开原生查询  →" Click="ShowQueries" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
                    <TextBlock Text="旧 Host 在发送前拒绝；可选属性 unavailable 不等于 false。" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Form / Gadget 与数组">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Form / Gadget 原生查询" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="复用 PMLFORMS / FMSYS · 窗体 → 控件 → 固定属性 · 按原生索引续读" TextWrapping="Wrap" />
                <WrapPanel Margin="0,14,0,0">
                  <TextBlock Text="每页扫描槽位" VerticalAlignment="Center" />
                  <TextBox x:Name="ItemsBudgetBox" Text="100" Width="85" Margin="12,0,20,0" TextChanged="QueryInputsChanged" />
                  <TextBlock Text="字符预算" VerticalAlignment="Center" />
                  <TextBox x:Name="CharsBudgetBox" Text="32768" Width="100" Margin="12,0,20,0" TextChanged="QueryInputsChanged" />
                  <CheckBox x:Name="ShownOnlyBox" Content="仅已显示窗体" IsChecked="True" VerticalAlignment="Center" Checked="QueryInputsChanged" Unchecked="QueryInputsChanged" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <WrapPanel x:Name="QueryCardsPanel" SizeChanged="QueryCardsSizeChanged">
              <Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,16">
                <StackPanel>
                  <TextBlock Text="1 · 窗体" Style="{StaticResource SectionTitle}" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="读取窗体" Click="ReadForms" Style="{StaticResource Primary}" />
                    <Button x:Name="ContinueFormsButton" Content="继续读取" IsEnabled="False" Click="ContinueForms" />
                  </WrapPanel>
                  <DataGrid x:Name="FormsGrid" Height="190" Margin="0,14,0,0" SelectionChanged="FormSelected">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="原索引" Binding="{Binding Index}" Width="65" />
                      <DataGridTextColumn Header="窗体名" Binding="{Binding Name}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="FormsWindowText" Text="尚未读取" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,16">
                <StackPanel>
                  <TextBlock Text="2 · 控件" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="SelectedFormText" Text="先选择窗体。" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="读取控件" Click="ReadGadgets" Style="{StaticResource Primary}" />
                    <Button x:Name="ContinueGadgetsButton" Content="继续读取" IsEnabled="False" Click="ContinueGadgets" />
                  </WrapPanel>
                  <DataGrid x:Name="GadgetsGrid" Height="158" Margin="0,14,0,0" SelectionChanged="GadgetSelected">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="原索引" Binding="{Binding Index}" Width="65" />
                      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                      <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="85" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="GadgetsWindowText" Text="尚未读取" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Width="340" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="3 · 属性详情" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="SelectedGadgetText" Text="先选择控件。" TextWrapping="Wrap" />
                  <Button Content="读取固定属性" Click="ReadGadget" HorizontalAlignment="Left" Margin="0,10,0,14" />
                  <DataGrid x:Name="PropertiesGrid" Height="250" MinRowHeight="36">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="属性 / 状态" Binding="{Binding Label}" Width="130" />
                      <DataGridTextColumn Header="原生值 / 原因" Binding="{Binding Value}" Width="*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding Value}" />
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="unavailable 不推断为 false；空文本仍可为读取成功。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Text.Warning}" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <Expander Header="本次原始回执与关联编号">
              <TextBox x:Name="ReceiptBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="360" VerticalScrollBarVisibility="Auto" FontFamily="Consolas,Microsoft YaHei UI" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
