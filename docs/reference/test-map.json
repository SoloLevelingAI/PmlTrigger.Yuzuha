    {
      "test": "xunit:YuzuhaToolkit.Tests.FunctionRegistryTests.RegistrationParsesSourceAndStartsDeniedAcrossStoreInstances",
      "purpose": "核对真实源码签名、默认拒绝和跨实例持久化。",
      "targets": [
        {
          "uid": "YuzuhaToolkit.Mcp::YuzuhaToolkit.Mcp.PmlFunctionRegistry",
          "methods": [
            "Register",
            "List",
            "PrepareCall"
          ]
        }
      ]
    },
    {
      "test": "xunit:YuzuhaToolkit.Tests.FunctionRegistryTests.ExplicitPermissionProducesTypedEscapedCallAndCanBeRevoked",
      "purpose": "授权后保持类型和引号转义，撤销后禁止调用。",
