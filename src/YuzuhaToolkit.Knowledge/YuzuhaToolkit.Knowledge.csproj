<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>YuzuhaToolkit.Knowledge</AssemblyName>
        <RootNamespace>YuzuhaToolkit.Knowledge</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <!-- Native AOT executable; ship e_sqlite3.dll alongside it. -->
        <PublishAot>true</PublishAot>
        <PublishSingleFile>false</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
    <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite"
                          Version="10.0.0"/>
        <!-- Override the older transitive native SQLite bundle; keep NuGet audit enabled. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"
                          Version="2.1.13"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"
                          Version="10.0.0"/>
        <PackageReference Include="ModelContextProtocol"
                          Version="1.4.1"/>
    </ItemGroup>
</Project>
