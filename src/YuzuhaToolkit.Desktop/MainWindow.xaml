<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YuzuhaToolkit.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YuzuhaToolkit.Desktop.MainWindow" Title="PMLTWIN · Yuzuha 工作台" FontFamily="Segoe UI,Microsoft YaHei UI" FontSize="14" Width="1440" Height="1024" MinWidth="840" MinHeight="480" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown">
  <Grid Background="#F4F7F5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#0B2D30">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,28,16,18">
          <Grid Margin="8,0,0,26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#163C40" BorderBrush="#2A5551" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Path Data="M10 11 L19 20 L28 11 M19 20 L19 30" Stroke="#EAF3E2" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="5" Height="5" Fill="#EDBD62" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,7,0" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Yuzuha" Foreground="#F0F8F4" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="ENGINEERING AI" Foreground="#739C95" FontSize="9" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
          <Border Background="#103638" BorderBrush="#1B4A4B" BorderThickness="1" CornerRadius="11" Padding="14,11">
            <StackPanel>
              <TextBlock Text="本机工作台" Foreground="#E8F4EF" FontSize="13" />
              <TextBlock Text="LOCAL · AVEVA TOOLCHAIN" Foreground="#739C95" FontSize="9" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <StackPanel x:Name="SidebarNav">
            <TextBlock Text="工作台" Style="{StaticResource NavGroup}" />
            <Button Uid="总览" Tag="4" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.grid}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="总览" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="启动工程" Tag="0" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.rocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="启动工程" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="工程会话" Tag="3" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.link}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="工程会话" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="交付" Style="{StaticResource NavGroup}" />
            <Button Uid="评审中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.check_circle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="评审中心" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="测试中心" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.activity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="测试中心" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="插件部署" Tag="1" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.package}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="插件部署" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="运行" Style="{StaticResource NavGroup}" />
            <Button Uid="AI 运行" Tag="2" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.cpu}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="AI 运行" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="工具日志" Tag="2" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.file}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="工具日志" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="Web 应用" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.external}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="Web 应用" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="资源" Style="{StaticResource NavGroup}" />
            <Button Uid="知识库" Tag="planned" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.book}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="知识库" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Uid="设置" Tag="1" Style="{StaticResource NavButton}" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                  <Path Data="{StaticResource Icon.sliders}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="#103638" BorderBrush="#1B4A4B" BorderThickness="1" CornerRadius="14" Margin="0,24,0,20" Padding="12">
            <StackPanel>
              <TextBlock Text="AVEVA 环境" Foreground="#739C95" FontSize="11" />
              <TextBlock x:Name="SidebarTargetText" Text="尚未选择目标" Foreground="#E8F4EF" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,10" />
              <Border Background="#1B4A4B" Height="1" />
              <Button Content="管理环境    →" Foreground="#8CD7C6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0,7,0,0" Margin="0" Tag="3" Uid="工程会话" Click="Navigate" />
            </StackPanel>
          </Border>
          <DockPanel Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Background="#1E5A54" CornerRadius="17" Width="34" Height="34" Margin="0,0,10,0">
              <TextBlock Text="Y" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock x:Name="MaintainerText" Text="本机用户" Foreground="#F2F8F4" FontSize="13" />
              <TextBlock Text="本机维护者" Foreground="#739C95" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="Yuzuha Toolkit · PMLTWIN v0.4" Foreground="#628D86" FontSize="10" Margin="8,0,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <DockPanel Grid.Column="1">
      <Grid DockPanel.Dock="Top" Margin="28,22,28,22" MinHeight="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel ClipToBounds="True">
          <TextBlock x:Name="PageTitleText" Text="总览" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PageSubtitleText" Text="本机工作台 · 从明确的工程目标开始" Style="{StaticResource Caption}" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border x:Name="SearchPanel" Background="White" BorderBrush="#9AAFA7" BorderThickness="1" CornerRadius="10" Width="232" Height="40" Margin="0,0,16,0">
            <DockPanel Margin="12,0">
              <Viewbox Width="16" Margin="0,0,8,0">
                <Path Data="{StaticResource Icon.search}" Stroke="#98A2B3" StrokeThickness="1.8" />
              </Viewbox>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="#667085" FontSize="10" VerticalAlignment="Center" />
              <TextBox x:Name="NavigationSearch" ToolTip="搜索页面，按 Enter 前往" KeyDown="SearchKeyDown" BorderThickness="0" Background="Transparent" Padding="0,4" Margin="0" FontSize="12" />
            </DockPanel>
          </Border>
          <Button x:Name="HeaderActionButton" Click="HeaderAction" Style="{StaticResource Primary}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                <Path Data="{StaticResource Icon.play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
              <TextBlock x:Name="HeaderActionText" Text="启动工程" />
            </StackPanel>
          </Button>
          <Button Width="40" Padding="10" Click="OpenLogs" ToolTip="打开本机工具日志目录" Margin="0,0,10,0">
            <Viewbox Width="17" Height="17">
              <Path Data="{StaticResource Icon.bell}" Stroke="#344054" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Viewbox>
          </Button>
          <Button Content="?" Width="38" Margin="0" Click="ShowHelp" ToolTip="使用说明" />
        </StackPanel>
      </Grid>
      <Border DockPanel.Dock="Bottom" Background="#F4F7F5" Padding="28,5,28,10">
        <DockPanel>
          <TextBlock x:Name="HeartbeatText" DockPanel.Dock="Right" Text="读取本机状态…" Style="{StaticResource Caption}" Margin="16,0,0,0" />
          <TextBlock x:Name="MessageText" Text="就绪 · 本机记录" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
      </Border>
      <TabControl x:Name="Tabs" Margin="28,0,28,0" Background="Transparent" BorderThickness="0" SelectedIndex="4" SelectionChanged="PageSelected">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="启动工程">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid x:Name="LaunchColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="新建配置  +" Click="NewProfile" FontSize="12" />
                      <StackPanel>
                        <TextBlock Text="启动配置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Monitor 启动 · 密码仅本次使用" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" Margin="0,18,0,16" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="程序入口" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseExecutable" Margin="6,5,0,12" />
                          <TextBox x:Name="ExecutableBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="初始化文件" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseInitialization" Margin="6,5,0,12" />
                          <TextBox x:Name="InitializationBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="工作目录" Style="{StaticResource Caption}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="…" Width="34" Padding="0" Click="BrowseWorkingDirectory" Margin="6,5,0,12" />
                          <TextBox x:Name="WorkingBox" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="MDB" Style="{StaticResource Caption}" />
                        <TextBox x:Name="MdbBox" Text="/ALL_NO_MDS" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="项目" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ProjectBox" FontSize="12" />
                        <TextBlock Text="用户名" Style="{StaticResource Caption}" />
                        <TextBox x:Name="UserBox" FontSize="12" />
                        <TextBlock Text="启动模块" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ModuleBox" Text="Design" FontSize="12" />
                        <TextBlock Text="本次密码（不保存）" Style="{StaticResource Caption}" />
                        <PasswordBox x:Name="PasswordInput" FontSize="12" />
                      </StackPanel>
                    </Grid>
                    <Expander Header="配置名称与产品 / 许可" FontSize="12" Margin="0,4,0,12">
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="配置名称" Style="{StaticResource Caption}" />
                        <TextBox x:Name="NameBox" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="入口类型" Style="{StaticResource Caption}" />
                            <ComboBox x:Name="KindBox" SelectedIndex="0">
                              <ComboBoxItem Content="Monitor" />
                              <ComboBoxItem Content="MarineBatch" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="产品代码" Style="{StaticResource Caption}" />
                            <TextBox x:Name="ProductBox" Text="E3D" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="许可连接（留空沿用）" Style="{StaticResource Caption}" />
                        <TextBox x:Name="LicenseBox" />
                      </StackPanel>
                    </Expander>
                    <DockPanel Margin="0,5,0,0">
                      <WrapPanel DockPanel.Dock="Right">
                        <Button Content="保存配置" Click="SaveProfile" FontSize="12" />
                        <Button Content="预览参数" Click="PreviewLaunch" FontSize="12" />
                        <Button x:Name="LaunchButton" Content="▶ 启动工程" Style="{StaticResource Primary}" Click="Launch" FontSize="12" Margin="0" />
                      </WrapPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                        <TextBlock Text="本机" Foreground="#0F5F56" FontSize="11" />
                      </Border>
                      <TextBlock Text="启动前检查" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="入口、初始化文件、工作目录和注册目录" Style="{StaticResource Caption}" Margin="0,8,0,20" />
                    <TextBlock x:Name="LaunchHealthText" Text="选择已注册的 PMLLIB 后扫描文件量与目录体积。启动入口由已有服务验证。" TextWrapping="Wrap" Foreground="#344054" FontSize="13" />
                    <Border Background="#FDF6E7" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                      <TextBlock Text="启动入口创建成功与登录完成分别确认；Host 身份在会话就绪后核验。" Style="{StaticResource Caption}" Foreground="#8A5A12" />
                    </Border>
                    <TextBlock Text="目录提醒预算可调整；它不是 AVEVA 的固定上限。" Style="{StaticResource Caption}" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid x:Name="LaunchLowerColumns">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="启动参数预览" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="由现有 LaunchService 生成 · 原生参数列表" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                    <TextBox x:Name="LaunchPreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="138" Background="#0B2426" Foreground="#D1EAE2" BorderBrush="#0B2426" FontFamily="Consolas" FontSize="12" />
                    <WrapPanel>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="原生启动" Foreground="#0F5F56" FontSize="11" />
                      </Border>
                      <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="不修改系统 EVAR" Foreground="#0F5F56" FontSize="11" />
                      </Border>
                      <Border Style="{StaticResource Pill}">
                        <TextBlock Text="密码不落盘" Foreground="#0F5F56" FontSize="11" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="重新发现" Click="Discover" Style="{StaticResource Link}" FontSize="12" />
                      <TextBlock Text="本机产品入口" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="注册表与 EVAR 候选" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <ListBox x:Name="ApplicationsBox" Height="138" DisplayMemberPath="Path" BorderThickness="0" FontSize="12" />
                    <Button Content="使用所选入口    →" Click="UseApplication" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="  插件目录  ">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="已注册的 PMLLIB" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="选择 EVAR 已注册的目录；工作台只复制到这里，不修改全局环境。" Foreground="#718197" TextWrapping="Wrap" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseRegistered" Margin="10,4,0,10" />
                    <TextBox x:Name="RegisteredBox" TextChanged="DeploymentInputsChanged" />
                  </DockPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="使用候选" Click="UseRegistration" Margin="10,4,0,10" />
                    <ComboBox x:Name="RegistrationsBox" DisplayMemberPath="Path" />
                  </DockPanel>
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="文件数提醒" VerticalAlignment="Center" />
                    <TextBox x:Name="WarnFilesBox" Text="3000" Width="90" Margin="10,0,18,0" />
                    <TextBlock Text="体积提醒 MiB" VerticalAlignment="Center" />
                    <TextBox x:Name="WarnSizeBox" Text="200" Width="90" Margin="10,0,18,0" />
                    <Button Content="保存目录设置" Click="SaveWorkspace" />
                    <Button Content="扫描目录" Click="ScanDirectory" />
                    <Button Content="打开目录清理" Click="OpenRegistered" />
                  </WrapPanel>
                  <TextBlock x:Name="HealthText" Text="尚未扫描" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#526987" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="把开发插件复制到注册目录" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="源文件、目录或 ZIP 保留在 PMLLIB 外。复制会跳过开发产物；覆盖前备份也存放在目录外。" Foreground="#718197" TextWrapping="Wrap" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseSourceFolder" Margin="10,4,0,10" />
                    <Button DockPanel.Dock="Right" Content="文件 / ZIP" Click="BrowseSourceFile" Margin="10,4,0,10" />
                    <TextBox x:Name="SourceBox" TextChanged="DeploymentInputsChanged" />
                  </DockPanel>
                  <TextBlock Text="插件子目录名" />
                  <TextBox x:Name="PluginBox" Text="MyPlugin" TextChanged="DeploymentInputsChanged" />
                  <WrapPanel>
                    <Button Content="预览复制内容" Click="PreviewCopy" />
                    <Button x:Name="ApplyCopyButton" Content="复制到注册目录" Style="{StaticResource Primary}" IsEnabled="False" Click="ApplyCopy" />
                  </WrapPanel>
                  <TextBlock x:Name="CopySummaryText" Foreground="#718197" Margin="0,12,0,12" TextWrapping="Wrap" />
                  <DataGrid x:Name="CopyGrid" Height="230">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="文件" Binding="{Binding RelativePath}" Width="*" />
                      <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="110" />
                      <DataGridTextColumn Header="状态" Binding="{Binding Action}" Width="120" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="复制完成后由当前开发流程决定何时重载。工作台不自动执行 PML REHASH ALL，不删除旧插件。" Foreground="#718197" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="  AI 运行与日志  ">
          <Grid Margin="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="190" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="120" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="本机 MCP 工具状态" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="每两秒刷新：观察工具执行、耗时与目标会话；服务空闲不等于 AI 没有思考。" Foreground="#718197" Margin="0,0,0,14" />
            </StackPanel>
            <DataGrid x:Name="RuntimeGrid" Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="190" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="85" />
                <DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="140" />
                <DataGridTextColumn Header="当前工具" Binding="{Binding ActiveSummary}" Width="*" />
                <DataGridTextColumn Header="AVEVA PID" Binding="{Binding TargetPid}" Width="100" />
                <DataGridTextColumn Header="上次结果 / 日志故障" Binding="{Binding OutcomeSummary}" Width="230" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="近期工具调用" Style="{StaticResource SectionTitle}" Margin="0,20,0,12" />
            <DataGrid x:Name="ActivityGrid" Grid.Row="3" SelectionChanged="ActivitySelected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间 +08" Binding="{Binding DisplayTime}" Width="85" />
                <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="210" />
                <DataGridTextColumn Header="事件" Binding="{Binding PhaseLabel}" Width="150" />
                <DataGridTextColumn Header="耗时 ms" Binding="{Binding Milliseconds}" Width="90" />
                <DataGridTextColumn Header="目标 PID" Binding="{Binding TargetPid}" Width="90" />
                <DataGridTextColumn Header="结果摘要" Binding="{Binding Summary}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="ActivityDetails" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Text="选择记录查看关联编号及参数。命名秘密字段会脱敏；PML 正文仍可能包含工程信息。" />
          </Grid>
        </TabItem>
        <TabItem Header="工程会话">
          <local:SessionWorkbenchView x:Name="SessionView" />
        </TabItem>
        <TabItem Header="总览">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid x:Name="OverviewColumns1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="18" Background="#0B302F" Padding="28" Margin="0,0,0,18" ClipToBounds="True">
                  <Grid>
                    <Canvas IsHitTestVisible="False">
                      <Ellipse Width="320" Height="320" Stroke="#FFFFFF" Opacity="0.05" Canvas.Left="390" Canvas.Top="-210" />
                      <Ellipse Width="240" Height="240" Stroke="#FFFFFF" Opacity="0.04" Canvas.Left="430" Canvas.Top="-170" />
                    </Canvas>
                    <StackPanel>
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="#15534B">
                          <TextBlock Text="明确选择 · 身份核验" Foreground="#A9E4D2" FontSize="11" />
                        </Border>
                        <TextBlock Text="当前工程会话" Foreground="#A9CFC5" FontSize="12" VerticalAlignment="Center" />
                      </DockPanel>
                      <TextBlock x:Name="OverviewTargetText" TextWrapping="Wrap" Text="尚未选择 AVEVA 工程" Foreground="#F3FBF7" FontSize="28" FontWeight="Bold" Margin="0,14,0,5" />
                      <TextBlock x:Name="OverviewTargetDetail" Text="先发现并选择会话，再核验目标与 Host 能力" Foreground="#A9CFC5" FontSize="13" TextWrapping="Wrap" />
                      <Border Height="1" Background="#1C4E48" Margin="0,18,0,16" />
                      <DockPanel>
                        <Button Content="打开会话    →" Tag="3" Uid="工程会话" Click="Navigate" DockPanel.Dock="Right" Background="#24554F" BorderBrush="#45766C" Foreground="#F3FBF7" Margin="0" />
                        <TextBlock Text="复用既有会话发现与身份核验" Foreground="#A9CFC5" VerticalAlignment="Center" FontSize="12" />
                      </DockPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                  <StackPanel>
                    <DockPanel>
                      <Border Style="{StaticResource Pill}" DockPanel.Dock="Right">
                        <TextBlock Text="本机" Foreground="#0F5F56" FontSize="11" />
                      </Border>
                      <TextBlock Text="PMLLIB 健康度" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Grid Margin="0,16,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Grid Width="72" Height="72">
                        <Ellipse Stroke="#EDF1F6" StrokeThickness="7" />
                        <TextBlock Text="—" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="OverviewFilesText" Text="尚未扫描" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverviewSizeText" Text="文件量与目录体积" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="按本机提醒预算检查，不推断整体健康分" Style="{StaticResource Caption}" />
                    <Button Content="查看目录与扫描    ↗" Tag="1" Uid="插件部署" Click="Navigate" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,9,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <UniformGrid x:Name="OverviewKpis" Columns="4" Margin="0,0,-16,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,18" Padding="18">
                  <StackPanel>
                    <DockPanel>
                      <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" Padding="7" Background="#E9F7F3">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                          <Path Data="{StaticResource Icon.layers}" Stroke="#167D70" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                      </Border>
                      <TextBlock Text="在线服务" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <TextBlock x:Name="OverviewServices" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,6" />
                    <TextBlock Text="心跳状态：idle / running" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,18" Padding="18">
                  <StackPanel>
                    <DockPanel>
                      <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" Padding="7" Background="#E9F7F3">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                          <Path Data="{StaticResource Icon.activity}" Stroke="#167D70" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                      </Border>
                      <TextBlock Text="工具调用" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <TextBlock x:Name="OverviewCalls" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,6" />
                    <TextBlock Text="已保留记录中的完成项" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,18" Padding="18">
                  <StackPanel>
                    <DockPanel>
                      <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" Padding="7" Background="#E9F7F3">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                          <Path Data="{StaticResource Icon.clock}" Stroke="#167D70" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                      </Border>
                      <TextBlock Text="平均响应" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <TextBlock x:Name="OverviewLatency" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,6" />
                    <TextBlock Text="已保留完成项 · ms" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,18" Padding="18">
                  <StackPanel>
                    <DockPanel>
                      <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" Padding="7" Background="#E9F7F3">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                          <Path Data="{StaticResource Icon.shield}" Stroke="#167D70" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                      </Border>
                      <TextBlock Text="执行成功率" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <TextBlock x:Name="OverviewSuccess" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,6" />
                    <TextBlock Text="成功完成项 / 完成项" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Grid x:Name="OverviewColumns2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button Content="查看记录    →" Click="OpenLogsPage" DockPanel.Dock="Right" Style="{StaticResource Link}" />
                      <TextBlock Text="AI 工具调用" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="本机有界记录 · 最近读取的事件" Style="{StaticResource Caption}" />
                    <Border Background="#F8FAF9" CornerRadius="12" Margin="0,18,0,0" Padding="20" MinHeight="156">
                      <StackPanel>
                        <TextBlock x:Name="OverviewRecentText" Text="尚无可显示记录" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="7 / 30 天趋势在统计范围明确后接入" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <Border Height="1" Background="#E4ECE7" Margin="0,30,0,12" />
                        <TextBlock Text="保留趋势区域 · 数据缺失时显示缺失状态" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="统计范围：当前保留文件中的已完成工具调用；缺失与轮转不会补算为成功。" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="● 本机" Foreground="#0B7A48" FontSize="11" DockPanel.Dock="Right" />
                      <TextBlock Text="实时工具调用" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="最近 200 条 · 本机滚动日志" Style="{StaticResource Caption}" />
                    <ItemsControl x:Name="OverviewFeed" Margin="0,16,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#EFF3F1" BorderThickness="0,0,0,1" Padding="0,10">
                            <StackPanel>
                              <TextBlock Text="{Binding Tool}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,5,0,0" MaxHeight="32" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid x:Name="OverviewColumns3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.14*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="打开会话管理    →" Tag="3" Uid="工程会话" Click="Navigate" Style="{StaticResource Link}" />
                      <TextBlock Text="工程会话" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="发现候选与已核验目标分别表达" Style="{StaticResource Caption}" />
                    <Border Background="#F8FAF9" Padding="16" CornerRadius="10" Margin="0,16,0,0">
                      <TextBlock x:Name="OverviewSessionText" Text="尚未选择目标。进入会话页发现并选择。" TextWrapping="Wrap" Foreground="#344054" />
                    </Border>
                    <WrapPanel Margin="0,18,0,0">
                      <Button Content="能力与函数" Click="OpenFunctionsPage" Style="{StaticResource Quiet}" />
                      <Button Content="Form / Gadget 查询" Click="OpenQueriesPage" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="AI 运行状态" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="OverviewRuntimeText" Text="读取本机 MCP 服务状态…" Style="{StaticResource Caption}" Margin="0,12,0,20" />
                    <Border Background="#F8FAF9" CornerRadius="10" Padding="12">
                      <DockPanel>
                        <TextBlock Text="›_" FontFamily="Consolas" Foreground="#167D70" FontSize="18" Margin="0,0,10,0" />
                        <StackPanel>
                          <TextBlock Text="日志与关联记录" Foreground="#0F5F56" FontSize="13" />
                          <TextBlock Text="Activity · 本机保留" Style="{StaticResource Caption}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="后续功能">
          <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock x:Name="PlannedTitleText" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="PlannedDescriptionText" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0" />
              <Border Style="{StaticResource Pill}" Margin="0,22,0,0" HorizontalAlignment="Left">
                <TextBlock Text="设计已保留 · 按里程碑交付" Foreground="#0F5F56" FontSize="12" />
              </Border>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
