-- <summary>Resolve the existing Host DLL from the current native product/version and registered PMLUI roots.</summary>
-- <remarks><para>E3D 2.1 uses E3D2.1/net48; all E3D 3.1 patch releases use E3D3.1.6/net48; AM and PDMS use their compiled net35 profiles.</para><para>The installation folder token remains replaceable by Setup. Missing mappings or DLLs never claim a successful setup.</para></remarks>
define function !!YuzuhaResolveRuntimePath()
  !folderName = 'PMLTRI'
  !!YuzuhaAutoSetup = FALSE
  !!YuzuhaRuntimePath = ''
  !!YuzuhaInstallRoot = ''
  !!YuzuhaNamespace = 'YuzuhaToolkit.PmlHost'
  -- Keep initialization in this already-indexed entry for upgrades with an existing pml.index.
  !!PhaytonSession = Current Session
  !!YuzuhaModel = !!PhaytonSession.module()
  var !banner BANNER
  var !productName BANNER NAME
  !!PhaytonBanner = !banner
  !!PhaytonProductName = !productName
  !!PhaytonVersion = !banner.after(' Mk').before('[').split()[1]
  !!PhaytonProduct = ''
  !!YuzuhaProfile = ''
  !!YuzuhaFramework = ''
  !!YuzuhaInE3D = false
  !upper = !banner.upcase()
  if !upper.matchwild('*EVERYTHING3D*') or !upper.matchwild('*E3D*') then
    !!PhaytonProduct = 'E3D'
    !!YuzuhaInE3D = true
    !!YuzuhaFramework = 'net48'
    if !!PhaytonVersion.matchwild('2.1.*') or !!PhaytonVersion eq '2.1' then
      !!YuzuhaProfile = 'E3D2.1'
    elseif !!PhaytonVersion.matchwild('3.1.*') or !!PhaytonVersion eq '3.1' then
      !!YuzuhaProfile = 'E3D3.1.6'
    endif
  elseif !upper.matchwild('*MARINE*') or !upper.matchwild('*HULL AND OUTFITTING*') then
    !!PhaytonProduct = 'AM'
    !!YuzuhaProfile = 'AM'
    !!YuzuhaFramework = 'net35'
  elseif !upper.matchwild('*PDMS*') then
    !!PhaytonProduct = 'PDMS'
    !!YuzuhaProfile = 'PDMS'
    !!YuzuhaFramework = 'net35'
  endif
  !!PhaytonSessionInfo = object ARRAY()
  !!PhaytonSessionInfo.append('[0] Product<STRING> ' + !!PhaytonProduct)
  !!PhaytonSessionInfo.append('[0] ProductName<STRING> ' + !!PhaytonProductName)
  !!PhaytonSessionInfo.append('[0] Version<STRING> ' + !!PhaytonVersion)
  !!PhaytonSessionInfo.append('[0] Module<STRING> ' + !!YuzuhaModel)
  !!PhaytonSessionInfo.append('[0] HostProfile<STRING> ' + !!YuzuhaProfile)
  !!PhaytonSessionInfo.append('[0] HostFramework<STRING> ' + !!YuzuhaFramework)
  if !!YuzuhaProfile eq '' then
    $p Phayton: no supported Host mapping for this native product/version.
  endif
  if !!YuzuhaProfile eq '' then
    return
  endif
  if !!YuzuhaFramework eq 'net35' then
    !dllPath = 'runtime\profiles\' + !!YuzuhaProfile + '\net35\YuzuhaToolkit.PmlHost.Net35'
  else
    !dllPath = 'runtime\profiles\' + !!YuzuhaProfile + '\net48\YuzuhaToolkit.PmlHost.Net48'
  endif
  var !path evar PMLUI
  !pathArr = !path.split(';')
  do !mem values !pathArr
    if !mem.UPCASE().match(!folderName) gt 0 then
      !strPath = !mem.replace('PMLUI\','').replace('PMLUI','').replace('pmlui\','').replace('pmlui','')
      !fullPath = !strPath + !dllPath
      !dllFile = object FILE(!fullPath + '.dll')
      if !dllFile.exists() then
        !!YuzuhaInstallRoot = !strPath
        !!YuzuhaRuntimePath = !fullPath
        !!YuzuhaAutoSetup = TRUE
        return
      endif
    endif
  enddo
  $p Phayton: no installed Host DLL matches the native product/version and registered PMLUI roots.
endfunction
