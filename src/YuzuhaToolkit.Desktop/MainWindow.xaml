                    <DataGrid x:Name="ProfileLibraryGrid" Height="430" Margin="0,14,0,0" SelectionChanged="ProfileLibrarySelected">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="收藏" Width="44">
