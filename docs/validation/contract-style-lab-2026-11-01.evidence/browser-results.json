      "weights": {
        "acid": 25,
        "glass": 60,
        "skeuo": 15
      },
      "palette": {
        "space": "#071A21",
        "readingSurface": "#15333F",
        "ink": "#EDF4F5",
        "muted": "#AEC4CD",
        "pathAccent": "#D5FF76",
        "uncertainty": "#FFCC91"
      },
