define function !!YuzuhaLimitViewByDbref(!dbref is any,!expand is real) is array
  !ob = object volume(!dbref)
  handle any
    !arr[1] = !!error.text
    return !arr
  endhandle
  !FROM = !ob.from.offset(E,- !expand).offset(N,- !expand).offset(U,- !expand)
  !TO = !ob.to.offset(E,!expand).offset(N,!expand).offset(U,!expand)
  !ob = object volume(!from,!to)
  !!gphViews.limits(!!fmsys.currentDocument().view, !ob) 
  !arr[1] = 'Success Limit View'
  return !arr
endfunction
